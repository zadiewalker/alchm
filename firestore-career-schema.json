  "security_rules": {
    "description": "Comprehensive security rules for career data protection",
    "rules": [
      {
        "path": "users/{userId}/career",
        "allow": {
          "read": ["if request.auth != null && request.auth.uid == userId"],
          "write": ["if request.auth != null && request.auth.uid == userId && isValidCareerData(request.resource.data)"]
        }
      },
      {
        "path": "users/{userId}/career/{document=**}",
        "allow": {
          "read": ["if request.auth != null && request.auth.uid == userId"],
          "write": ["if request.auth != null && request.auth.uid == userId"]
        }
      }
    ],
    "functions": {
      "isValidCareerData": {
        "description": "Validates career data structure and content",
        "logic": "return data.keys().hasAll(['userId', 'createdAt', 'updatedAt']) && data.userId == userId"
      }
    }
  },
