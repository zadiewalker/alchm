{
  "description": "ALCHM Career & Future Readiness Firestore Schema - Comprehensive career development and opportunity management",
  "version": "1.0.0",
  "collections": {
    "users/{uid}/career": {
      "description": "Main career journey data for each user",
      "fields": {
        "userId": {
          "type": "string",
          "required": true,
          "description": "Unique user identifier"
        },
        "journeyId": {
          "type": "string",
          "required": true,
          "description": "Unique career journey identifier"
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string", "enum": ["artistic", "scientific", "social", "enterprising", "conventional", "realistic"] },
              "subcategory": { "type": "string" },
              "interestName": { "type": "string" },
              "intensityLevel": { "type": "number", "min": 1, "max": 10 },
              "discoverySource": { "type": "string", "enum": ["journaling", "assessment", "experience", "exploration", "reflection"] },
              "evidencePoints": { "type": "array", "items": { "type": "string" } },
              "culturalRelevance": { "type": "number", "min": 0, "max": 1 },
              "identityConnection": { "type": "array", "items": { "type": "string" } },
              "futureGrowthPotential": { "type": "number", "min": 0, "max": 1 },
              "skillRequirements": { "type": "array", "items": { "type": "string" } },
              "valueAlignment": { "type": "number", "min": 0, "max": 1 },
              "marketDemand": {
                "type": "object",
                "properties": {
                  "currentDemand": { "type": "number" },
                  "projectedGrowth": { "type": "number" },
                  "salaryRange": {
                    "type": "object",
                    "properties": {
                      "min": { "type": "number" },
                      "max": { "type": "number" },
                      "median": { "type": "number" }
                    }
                  },
                  "geographicAvailability": { "type": "array", "items": { "type": "string" } }
                }
              },
              "relatedCareers": { "type": "array", "items": { "type": "string" } },
              "firstIdentified": { "type": "timestamp" },
              "lastUpdated": { "type": "timestamp" },
              "confidence": { "type": "number", "min": 0, "max": 1 },
              "persistence": { "type": "number", "min": 0, "max": 1 }
            }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string", "enum": ["cognitive", "interpersonal", "leadership", "creative", "technical", "adaptive", "emotional"] },
              "strengthName": { "type": "string" },
              "proficiencyLevel": { "type": "number", "min": 1, "max": 10 },
              "evidenceType": { "type": "string", "enum": ["demonstrated", "potential", "feedback_based", "assessment_based"] },
              "evidencePoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidenceId": { "type": "string" },
                    "description": { "type": "string" },
                    "context": { "type": "string" },
                    "date": { "type": "timestamp" },
                    "witness": { "type": "string" },
                    "impact": { "type": "string" },
                    "skillLevel": { "type": "number" }
                  }
                }
              },
              "developmentStage": { "type": "string", "enum": ["emerging", "developing", "proficient", "advanced", "expert"] },
              "transferability": { "type": "number", "min": 0, "max": 1 },
              "marketValue": { "type": "number", "min": 0, "max": 1 },
              "culturalExpression": {
                "type": "object",
                "properties": {
                  "culturalOrigin": { "type": "array", "items": { "type": "string" } },
                  "culturalAdaptation": { "type": "string" },
                  "crossCulturalTransferability": { "type": "number" }
                }
              },
              "identityFoundation": { "type": "array", "items": { "type": "string" } },
              "growthTrajectory": {
                "type": "object",
                "properties": {
                  "currentLevel": { "type": "number" },
                  "projectedLevel": { "type": "number" },
                  "developmentPlan": { "type": "string" },
                  "timeframe": { "type": "string" }
                }
              },
              "applicationAreas": { "type": "array", "items": { "type": "string" } },
              "complementaryStrengths": { "type": "array", "items": { "type": "string" } },
              "developmentNeeds": { "type": "array", "items": { "type": "string" } },
              "firstIdentified": { "type": "timestamp" },
              "lastDemonstrated": { "type": "timestamp" },
              "confidence": { "type": "number", "min": 0, "max": 1 }
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string", "enum": ["purpose", "autonomy", "mastery", "security", "social_impact", "creativity", "balance", "recognition", "growth", "stability"] },
              "valueName": { "type": "string" },
              "importance": { "type": "number", "min": 1, "max": 10 },
              "currentSatisfaction": { "type": "number", "min": 1, "max": 10 },
              "culturalOrigin": { "type": "array", "items": { "type": "string" } },
              "identityConnection": { "type": "array", "items": { "type": "string" } },
              "lifeExperienceRoot": { "type": "array", "items": { "type": "string" } },
              "tradeoffWillingness": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "againstValue": { "type": "string" },
                    "willingness": { "type": "number" },
                    "conditions": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "manifestationPreferences": { "type": "array", "items": { "type": "string" } },
              "dealBreakers": { "type": "array", "items": { "type": "string" } },
              "flexibilityLevel": { "type": "number", "min": 0, "max": 1 },
              "evolutionOverTime": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timepoint": { "type": "timestamp" },
                    "importance": { "type": "number" },
                    "context": { "type": "string" },
                    "trigger": { "type": "string" }
                  }
                }
              },
              "careersAligned": { "type": "array", "items": { "type": "string" } },
              "workEnvironmentImplications": { "type": "array", "items": { "type": "string" } },
              "decisionMakingWeight": { "type": "number", "min": 0, "max": 1 },
              "firstIdentified": { "type": "timestamp" },
              "lastReflectedOn": { "type": "timestamp" }
            }
          }
        },
        "workStyle": {
          "type": "object",
          "properties": {
            "collaborationStyle": { "type": "string", "enum": ["highly_collaborative", "team_oriented", "independent_contributor", "leadership_focused", "flexible"] },
            "communicationStyle": { "type": "string", "enum": ["direct", "diplomatic", "analytical", "creative", "empathetic"] },
            "decisionMakingStyle": { "type": "string", "enum": ["analytical", "intuitive", "consultative", "decisive", "collaborative"] },
            "learningStyle": { "type": "string", "enum": ["visual", "auditory", "kinesthetic", "reading_writing", "multimodal"] },
            "stressManagementStyle": { "type": "string", "enum": ["proactive", "adaptive", "supportive", "analytical", "creative"] },
            "workEnvironmentPreference": {
              "type": "object",
              "properties": {
                "physicalEnvironment": { "type": "string", "enum": ["office", "remote", "hybrid", "field", "lab", "creative_space"] },
                "teamSize": { "type": "string", "enum": ["individual", "small_team", "large_team", "varies"] },
                "organizationSize": { "type": "string", "enum": ["startup", "small", "medium", "large", "enterprise"] },
                "industry": { "type": "array", "items": { "type": "string" } },
                "culture": { "type": "array", "items": { "type": "string" } },
                "diversity": { "type": "number", "min": 0, "max": 1 },
                "innovation": { "type": "number", "min": 0, "max": 1 },
                "structure": { "type": "string", "enum": ["highly_structured", "moderately_structured", "flexible", "autonomous"] },
                "pace": { "type": "string", "enum": ["slow_steady", "moderate", "fast_paced", "variable"] }
              }
            },
            "schedulePreference": {
              "type": "object",
              "properties": {
                "flexibility": { "type": "string", "enum": ["fixed", "flexible", "very_flexible"] },
                "hoursPreference": { "type": "string", "enum": ["standard", "early", "late", "variable"] },
                "workLifeBalance": { "type": "number", "min": 1, "max": 10 }
              }
            },
            "feedbackPreference": {
              "type": "object",
              "properties": {
                "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly"] },
                "style": { "type": "string", "enum": ["direct", "supportive", "detailed", "high_level"] },
                "source": { "type": "string", "enum": ["manager", "peers", "team", "self"] }
              }
            },
            "growthOrientation": {
              "type": "object",
              "properties": {
                "learningSpeed": { "type": "string", "enum": ["fast", "moderate", "deliberate"] },
                "riskTaking": { "type": "number", "min": 1, "max": 10 },
                "changeAdaptability": { "type": "number", "min": 1, "max": 10 },
                "innovationComfort": { "type": "number", "min": 1, "max": 10 }
              }
            },
            "culturalWorkValues": {
              "type": "object",
              "properties": {
                "collectivismIndividualism": { "type": "number", "min": -1, "max": 1 },
                "hierarchyEgalitarian": { "type": "number", "min": -1, "max": 1 },
                "uncertaintyAvoidance": { "type": "number", "min": 0, "max": 1 },
                "longTermOrientation": { "type": "number", "min": 0, "max": 1 }
              }
            }
          }
        },
        "careerPersonality": {
          "type": "object",
          "properties": {
            "hollandCode": { "type": "string" },
            "mbtiType": { "type": "string" },
            "bigFiveScores": {
              "type": "object",
              "properties": {
                "openness": { "type": "number", "min": 0, "max": 1 },
                "conscientiousness": { "type": "number", "min": 0, "max": 1 },
                "extraversion": { "type": "number", "min": 0, "max": 1 },
                "agreeableness": { "type": "number", "min": 0, "max": 1 },
                "neuroticism": { "type": "number", "min": 0, "max": 1 }
              }
            },
            "motivationProfile": {
              "type": "object",
              "properties": {
                "achievementOrientation": { "type": "number", "min": 0, "max": 1 },
                "affiliationNeed": { "type": "number", "min": 0, "max": 1 },
                "powerMotivation": { "type": "number", "min": 0, "max": 1 },
                "autonomyDesire": { "type": "number", "min": 0, "max": 1 }
              }
            }
          }
        },
        "matchedRoles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roleId": { "type": "string" },
              "matchScore": { "type": "number", "min": 0, "max": 1 },
              "requiredSkills": { "type": "array", "items": { "type": "string" } },
              "roleName": { "type": "string" },
              "onetSocCode": { "type": "string" },
              "industryAlignment": { "type": "number", "min": 0, "max": 1 },
              "valueAlignment": { "type": "number", "min": 0, "max": 1 },
              "skillGapAnalysis": {
                "type": "object",
                "properties": {
                  "criticalGaps": { "type": "array", "items": { "type": "string" } },
                  "developableGaps": { "type": "array", "items": { "type": "string" } },
                  "timeToReadiness": { "type": "string" }
                }
              }
            }
          }
        },
        "careerVisionBoard": {
          "type": "object",
          "properties": {
            "boardId": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "visionElements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "elementId": { "type": "string" },
                  "type": { "type": "string", "enum": ["central_vision", "aspirational_role", "lifestyle_goal", "impact_vision", "skill_milestone", "network_goal"] },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" }
                    }
                  },
                  "timeframe": { "type": "string", "enum": ["1_year", "3_years", "5_years", "10_years", "lifetime"] },
                  "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                  "feasibility": { "type": "number", "min": 0, "max": 1 },
                  "emotionalResonance": { "type": "number", "min": 0, "max": 1 },
                  "culturalAlignment": { "type": "number", "min": 0, "max": 1 },
                  "identityConnection": { "type": "array", "items": { "type": "string" } },
                  "resourceNeeds": { "type": "array", "items": { "type": "string" } },
                  "connectedGoals": { "type": "array", "items": { "type": "string" } },
                  "progressIndicators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "indicator": { "type": "string" },
                        "currentValue": { "type": "number" },
                        "targetValue": { "type": "number" }
                      }
                    }
                  }
                }
              }
            },
            "createdAt": { "type": "timestamp" },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "smartGoals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "progressTracking": {
          "type": "object",
          "properties": {
            "currentPhase": { "type": "string" },
            "overallProgress": { "type": "number", "min": 0, "max": 1 },
            "skillDevelopmentProgress": {
              "type": "object",
              "properties": {
                "technicalSkills": { "type": "number", "min": 0, "max": 1 },
                "softSkills": { "type": "number", "min": 0, "max": 1 },
                "leadershipSkills": { "type": "number", "min": 0, "max": 1 },
                "culturalCompetency": { "type": "number", "min": 0, "max": 1 }
              }
            },
            "networkGrowth": {
              "type": "object",
              "properties": {
                "professionalConnections": { "type": "number" },
                "mentorRelationships": { "type": "number" },
                "industryConnections": { "type": "number" },
                "communityConnections": { "type": "number" }
              }
            },
            "experienceGain": {
              "type": "object",
              "properties": {
                "internships": { "type": "number" },
                "volunteerHours": { "type": "number" },
                "projectsCompleted": { "type": "number" },
                "leadershipRoles": { "type": "number" }
              }
            }
          }
        },
        "culturalContext": {
          "type": "object",
          "properties": {
            "culturalBackground": { "type": "array", "items": { "type": "string" } },
            "languagesSpoken": { "type": "array", "items": { "type": "string" } },
            "culturalCareerExpectations": { "type": "array", "items": { "type": "string" } },
            "familyCareerInfluences": { "type": "array", "items": { "type": "string" } },
            "culturalNetworks": { "type": "array", "items": { "type": "string" } },
            "culturalBarriers": { "type": "array", "items": { "type": "string" } },
            "culturalAssets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "identityAlignment": {
          "type": "object",
          "properties": {
            "personalIdentityElements": { "type": "array", "items": { "type": "string" } },
            "culturalIdentityElements": { "type": "array", "items": { "type": "string" } },
            "aspirationalIdentityElements": { "type": "array", "items": { "type": "string" } },
            "identityCareerIntegration": { "type": "number", "min": 0, "max": 1 },
            "authenticityInCareer": { "type": "number", "min": 1, "max": 10 }
          }
        },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true },
        "lastActiveAt": { "type": "timestamp" },
        "isActive": { "type": "boolean", "default": true }
      },
      "indexes": [
        { "fields": ["userId"], "queryScope": "collection" },
        { "fields": ["updatedAt"], "queryScope": "collection" },
        { "fields": ["isActive", "updatedAt"], "queryScope": "collection" }
      ],
      "security": {
        "read": ["owner", "mentor_with_permission"],
        "write": ["owner"],
        "privacy_controls": {
          "default_visibility": "private",
          "shareable_elements": ["interests", "strengths", "values", "career_goals"],
          "mentor_access_level": "guided_sharing",
          "community_sharing": "opt_in_only"
        }
      }
    },
    "users/{uid}/career/smartGoals/{goalId}": {
      "description": "Individual SMART goals with detailed tracking and coaching",
      "fields": {
        "goalId": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "category": { "type": "string", "enum": ["skill_development", "experience_gain", "network_building", "education", "project_completion", "career_transition", "leadership_growth", "creative_pursuit", "impact_creation", "personal_brand"] },
        "goalTitle": { "type": "string", "required": true },
        "goalDescription": { "type": "string", "required": true },
        "specific": {
          "type": "object",
          "properties": {
            "whatSpecifically": { "type": "string" },
            "whyImportant": { "type": "string" },
            "whoInvolved": { "type": "array", "items": { "type": "string" } },
            "whereOccurs": { "type": "string" },
            "whichResources": { "type": "array", "items": { "type": "string" } },
            "constraints": { "type": "array", "items": { "type": "string" } },
            "requirements": { "type": "array", "items": { "type": "string" } },
            "scope": { "type": "string" },
            "boundaries": { "type": "array", "items": { "type": "string" } }
          }
        },
        "measurable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metricName": { "type": "string" },
              "metricType": { "type": "string", "enum": ["quantitative", "qualitative", "binary", "milestone"] },
              "currentValue": { "type": "string" },
              "targetValue": { "type": "string" },
              "unit": { "type": "string" },
              "measurementMethod": { "type": "string" },
              "frequency": { "type": "string" },
              "trackingTools": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "achievable": {
          "type": "object",
          "properties": {
            "feasibilityScore": { "type": "number", "min": 0, "max": 1 },
            "resourceAvailability": {
              "type": "object",
              "properties": {
                "available": { "type": "array", "items": { "type": "string" } },
                "required": { "type": "array", "items": { "type": "string" } },
                "gaps": { "type": "array", "items": { "type": "string" } }
              }
            },
            "skillRequirements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "skillName": { "type": "string" },
                  "currentLevel": { "type": "number" },
                  "requiredLevel": { "type": "number" },
                  "developmentPlan": { "type": "string" },
                  "timeline": { "type": "string" }
                }
              }
            },
            "supportSystemNeeds": { "type": "array", "items": { "type": "string" } },
            "riskFactors": { "type": "array", "items": { "type": "string" } },
            "contingencyPlans": { "type": "array", "items": { "type": "string" } }
          }
        },
        "relevant": {
          "type": "object",
          "properties": {
            "careerGoalsAlignment": { "type": "number", "min": 0, "max": 1 },
            "personalValuesAlignment": { "type": "number", "min": 0, "max": 1 },
            "culturalAlignment": { "type": "number", "min": 0, "max": 1 },
            "identityAlignment": { "type": "number", "min": 0, "max": 1 },
            "marketRelevance": { "type": "number", "min": 0, "max": 1 },
            "timingAppropriate": { "type": "boolean" },
            "priorityLevel": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
          }
        },
        "timeBound": {
          "type": "object",
          "properties": {
            "startDate": { "type": "timestamp" },
            "targetEndDate": { "type": "timestamp" },
            "totalDuration": { "type": "string" },
            "phaseBreakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phaseName": { "type": "string" },
                  "duration": { "type": "string" },
                  "objectives": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": { "type": "timestamp" },
                  "milestone": { "type": "string" },
                  "completed": { "type": "boolean" }
                }
              }
            }
          }
        },
        "status": { "type": "string", "enum": ["draft", "active", "on_track", "behind_schedule", "completed", "paused", "cancelled"], "default": "draft" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "medium" },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"], "default": "intermediate" },
        "confidence": { "type": "number", "min": 0, "max": 1 },
        "motivation": { "type": "number", "min": 1, "max": 10 },
        "progressTracking": {
          "type": "object",
          "properties": {
            "currentProgress": { "type": "number", "min": 0, "max": 1 },
            "milestonesCompleted": { "type": "number" },
            "timeInvested": { "type": "number" },
            "lastUpdated": { "type": "timestamp" }
          }
        },
        "mentorshipNeeds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillArea": { "type": "string" },
              "mentorType": { "type": "string" },
              "frequency": { "type": "string" },
              "duration": { "type": "string" }
            }
          }
        },
        "communitySupport": {
          "type": "object",
          "properties": {
            "desiredSupport": { "type": "array", "items": { "type": "string" } },
            "shareProgress": { "type": "boolean" },
            "seekAccountability": { "type": "boolean" }
          }
        },
        "culturalConsiderations": {
          "type": "object",
          "properties": {
            "culturalValues": { "type": "array", "items": { "type": "string" } },
            "familyConsiderations": { "type": "array", "items": { "type": "string" } },
            "culturalBarriers": { "type": "array", "items": { "type": "string" } },
            "culturalAssets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true },
        "targetCompletionDate": { "type": "timestamp" },
        "actualCompletionDate": { "type": "timestamp" }
      },
      "indexes": [
        { "fields": ["userId", "status"], "queryScope": "collection" },
        { "fields": ["userId", "category"], "queryScope": "collection" },
        { "fields": ["userId", "priority", "updatedAt"], "queryScope": "collection" },
        { "fields": ["targetCompletionDate"], "queryScope": "collection" }
      ]
    },
    "users/{uid}/career/projects/{projectId}": {
      "description": "Project-based learning and portfolio development",
      "fields": {
        "projectId": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
