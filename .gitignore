# Dependency locks
pnpm-lock.yaml
yarn.lock

# Build outputs
.next/
dist/
out/
coverage/

# Conflicting Next.js config files (Firebase App Hosting requires CommonJS)
next.config.mjs
next.config.performance.mjs

# Firebase
.firebaserc
firebase-debug.log

# IDE and system files
.vscode/
.DS_Store

# Env and Secrets - NEVER COMMIT THESE
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
*.key
*.pem
*.p12
*-key.json
serviceAccountKey.json
service-account-*.json
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Security sensitive files
secrets/
private-keys/
certificates/
.secrets
*.crt
*.csr
auth.json
credentials.json

# Backup files that might contain secrets
*.bak
*.backup
*.swp
*.tmp
.env.local.backup*
.env.local.secure*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Others
node_modules/
serviceAccountKey.json

# Google Cloud SDK (EXCLUDE THESE LARGE FILES)
google-cloud-sdk/
google-cloud-sdk*/
*.tar.gz

# Mobile assets causing LFS issues
android/
ios/
