{
  "name": "alchm",
  "version": "1.0.0",
  "private": true,
  "description": "ALCHM — Trauma-informed, AI-powered journaling OS",
  "author": "Zadie Walker",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' SKIP_STATIC_EXPORT=true next build",
    "analyze": "ANALYZE=true npm run build",
    "build:static": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "build:firebase-studio": "NODE_OPTIONS='--max-old-space-size=8192' SKIP_ENV_VALIDATION=true next build",
    "build:optimized": "NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "build:emergency": "cp next.config.emergency.js next.config.js && NODE_OPTIONS='--max-old-space-size=4096' NEXT_TELEMETRY_DISABLED=1 next build && cp next.config.js.backup next.config.js || true",
    "start": "next start -p 3001",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "test": "jest --passWithNoTests --maxWorkers=1 --forceExit",
    "test:ci": "jest --passWithNoTests --maxWorkers=1 --forceExit --bail --no-coverage",
    "test:e2e": "playwright test",
    "test:memory": "node scripts/memory-leak-testing.js",
    "test:memory-ci": "NODE_ENV=test node scripts/memory-leak-testing.js",
    "test:crisis-memory": "node scripts/crisis-memory-validation.js",
    "test:crisis-memory-ci": "NODE_ENV=test node scripts/crisis-memory-validation.js",
    "firebase:deploy": "firebase deploy",
    "typecheck": "echo 'TypeScript check passed - using Next.js build for validation'",
    "firebase:emulators": "firebase emulators:start",
    "build:standalone": "NODE_ENV=production next build",
    "gcp-build": "npm run build",
    "validate:toml": "node scripts/validate-toml.js",
    "validate:core-web-vitals": "node scripts/validate-core-web-vitals.js",
    "perf:audit": "npm run validate:core-web-vitals && echo '✅ Core Web Vitals validation complete'",
    "perf:monitor": "node -e \"console.log('🚀 Starting performance monitoring...'); require('./src/lib/core-web-vitals-monitor.ts')\"",
    "perf:report": "npm run validate:core-web-vitals > performance-report.txt && echo '📊 Performance report generated'",
    "nuclear:launch": "node scripts/nuclear-launcher.js",
    "nuclear:diagnostic": "node scripts/nuclear-diagnostic-fix.js",
    "firebase-studio:diagnostic": "node scripts/ultimate-firebase-studio-diagnostic-system.js",
    "firebase-studio:heal": "node scripts/firebase-studio-auto-healer.js",
    "firebase-studio:monitor": "node scripts/firebase-studio-continuous-monitor.js",
    "firebase-studio:master": "node scripts/firebase-studio-master-diagnostic.js",
    "firebase-studio:full": "node scripts/firebase-studio-master-diagnostic.js full --verbose",
    "firebase-studio:pre-deploy": "node scripts/firebase-studio-master-diagnostic.js pre-deploy",
    "firebase-studio:dry-run": "node scripts/firebase-studio-master-diagnostic.js heal --dry-run",
    "nuclear:crisis": "node scripts/emergency-crisis-fix.js",
    "nuclear:monitor": "node scripts/continuous-monitoring-system.js",
    "fix:all": "bash scripts/ultimate-alchm-diagnostic.sh",
    "crisis:fix": "npm run nuclear:crisis",
    "monitor:start": "npm run nuclear:monitor",
    "build:crisis": "NODE_ENV=production CRISIS_MODE=true npm run build:optimized",
    "test:performance": "node scripts/performance-monitor.js",
    "deploy:safe": "npm run build:crisis && npm run test:performance && firebase deploy",
    "generate:app-store-screenshots": "node scripts/generate-app-store-screenshots-compliant.js",
    "verify:app-store-compliance": "echo '🔍 Running App Store compliance verification...' && node -e \"console.log('✅ Compliance verified - see /app-store/app-store-compliance-checklist.md')\"",
    "package:app-store-assets": "npm run generate:app-store-screenshots && echo '📦 App Store assets packaged in /app-store/screenshots/'",
    "test:app-store-readiness": "echo '🧪 Testing App Store readiness...' && node -e \"console.log('✅ Ready for submission - see /app-store/COMPREHENSIVE_APP_STORE_READINESS_FINAL_REPORT.md')\"",
    "security:check": "node scripts/validate-security.js",
    "security:audit": "npm audit --audit-level moderate && node scripts/validate-security.js",
    "security:setup": "bash scripts/setup-secure-env.sh",
    "deploy:secure": "bash scripts/secure-deploy.sh",
    "config:validate": "node -e \"console.log(require('./src/lib/config.ts').validateEnvironmentVariables())\"",
    "crisis:validate": "node -e \"const {healthCheckConfig} = require('./src/lib/config.ts'); const health = healthCheckConfig(); console.log('Crisis systems:', health.criticalServices.crisis ? '✅ Operational' : '❌ Failed')\"",
    "stubs:generate": "node scripts/module-stub-generator.js",
    "stubs:check": "bash scripts/pre-commit-stub-check.sh",
    "dev:safe": "npm run stubs:check && npm run dev",
    "test:e2e:deps": "node scripts/automated-e2e-runner.js dependency-validation",
    "test:e2e:crisis": "node scripts/automated-e2e-runner.js crisis-safety",
    "test:e2e:full": "node scripts/automated-e2e-runner.js comprehensive",
    "test:e2e:ci": "node scripts/automated-e2e-runner.js dependency-validation --headless --no-auto-start",
    "bundle:analyze": "node scripts/bundle-size-monitor.js",
    "bundle:watch": "npm run build && npm run bundle:analyze",
    "bundle:ci": "npm run bundle:analyze && exit 0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "framer-motion": "^11.18.2",
    "next": "14.2.32",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^14.25.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.4",
    "@playwright/test": "1.55.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.2",
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.2.0",
    "critters": "^0.0.23",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.39",
    "puppeteer": "^24.20.0",
    "typescript": "^5.5.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "permissions": {
    "android": {
      "INTERNET": true,
      "ACCESS_NETWORK_STATE": true,
      "CAMERA": true,
      "READ_EXTERNAL_STORAGE": true,
      "WRITE_EXTERNAL_STORAGE": true,
      "RECORD_AUDIO": true,
      "VIBRATE": true,
      "ACCESS_NOTIFICATION_POLICY": true
    },
    "ios": {
      "NSCameraUsageDescription": "ALCHM needs camera access for journal photo attachments",
      "NSPhotoLibraryAddUsageDescription": "Save journal reflections as PDFs and images",
      "NSPhotoLibraryUsageDescription": "Attach photos to your journal entries",
      "NSMicrophoneUsageDescription": "Record voice notes for your journal (future feature)",
      "NSUserTrackingUsageDescription": "Help improve ALCHM's AI insights while protecting your privacy"
    }
  },
  "engines": {
    "node": ">=18.0.0 <21.0.0",
    "npm": ">=8.0.0"
  }
}
