{
  "hosting": [
    {
      "site": "alchmapp",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.map",
        "**/*.d.ts",
        "**/tsconfig.json",
        "**/*.backup",
        "**/*.disabled"
      ],
      "rewrites": [
        {
          "source": "/mobile-emergency",
          "destination": "/mobile-emergency.html"
        },
        {
          "source": "/emergency-age-verify", 
          "destination": "/mobile-emergency.html"
        },
        {
          "source": "/api/khepera/**",
          "function": "detectCrisis"
        },
        {
          "source": "/api/crisis-detection",
          "function": "detectCrisis"
        },
        {
          "source": "/api/crisis-detection/**",
          "function": "detectCrisis"
        },
        {
          "source": "/api/health",
          "function": "healthCheck"
        },
        {
          "source": "/api/health/ping",
          "function": "healthCheck"
        },
        {
          "source": "/dashboard",
          "destination": "/dashboard.html"
        },
        {
          "source": "/journal", 
          "destination": "/journal.html"
        },
        {
          "source": "/emergency",
          "destination": "/emergency.html"
        },
        {
          "source": "/auth/login",
          "destination": "/auth/login.html"
        },
        {
          "source": "/auth/signup",
          "destination": "/auth/signup.html"
        },
        {
          "source": "/en/dashboard",
          "destination": "/en/dashboard.html"
        },
        {
          "source": "/en/journal",
          "destination": "/en/journal.html"
        },
        {
          "source": "/en/auth/login",
          "destination": "/en/auth/login.html"
        },
        {
          "source": "/en/auth/signup",
          "destination": "/en/auth/signup.html"
        },
        {
          "source": "/en/emergency",
          "destination": "/en/emergency.html"
        },
        {
          "source": "/en/crisis",
          "destination": "/en/crisis.html"
        },
        {
          "source": "/en/pathways",
          "destination": "/en/pathways.html"
        },
        {
          "source": "/en/pricing",
          "destination": "/en/pricing.html"
        },
        {
          "source": "/en/pricing/premium",
          "destination": "/en/pricing/premium.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control", 
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache\""
            },
            {
              "key": "Last-Modified",
              "value": "0"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control", 
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(json|xml)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache\""
            },
            {
              "key": "Last-Modified",
              "value": "0"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/*sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options", 
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "X-Mobile-Optimized",
              "value": "trauma-informed"
            },
            {
              "key": "X-Crisis-Ready",
              "value": "true"
            },
            {
              "key": "X-Touch-Targets",
              "value": "accessibility-enhanced"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "site": "alchm-digital-sanctuary", 
