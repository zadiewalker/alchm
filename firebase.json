{
  "hosting": [
    {
      "site": "alchmapp",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.map",
        "**/*.d.ts",
        "**/tsconfig.json",
        "**/*.backup",
        "**/*.disabled"
      ],
      "redirects": [
        {
          "source": "/api/:path*",
          "destination": "https://alchm.vercel.app/api/:path*",
          "type": 307
        },
        {
          "source": "/:path*",
          "destination": "https://alchm.vercel.app/:path*",
          "type": 307
        }
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/api/khepera/**",
          "function": "crisisDetection"
        },
        {
          "source": "/api/crisis-detection",
          "function": "crisisDetection"
        },
        {
          "source": "/api/crisis-detection/**",
          "function": "crisisDetection"
        },
        {
          "source": "/api/health",
          "function": "healthCheck"
        },
        {
          "source": "/api/health/ping",
          "function": "healthCheck"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache-root\""
            },
            {
              "key": "X-Cache-Buster",
              "value": "ALCHM_STATIC_RC_1767592940"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache-index\""
            },
            {
              "key": "X-Cache-Buster",
              "value": "ALCHM_STATIC_RC_1767592940"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control", 
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache-assets\""
            },
            {
              "key": "X-Cache-Buster",
              "value": "ALCHM_STATIC_RC_1767592940"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control", 
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(json|xml)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "ETag",
              "value": "W/\"no-cache-html\""
            },
            {
              "key": "X-Cache-Buster",
              "value": "ALCHM_STATIC_RC_1767592940"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/*sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "X-Version-File",
              "value": "true"
            }
          ]
        },
        {
          "source": "/build-info.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            },
            {
              "key": "Content-Type",
              "value": "application/javascript"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options", 
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "X-Mobile-Optimized",
              "value": "trauma-informed"
            },
            {
              "key": "X-Crisis-Ready",
              "value": "true"
            },
            {
              "key": "X-Touch-Targets",
              "value": "accessibility-enhanced"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    }
  ],
  
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "*.disabled",
        "src/**/*.disabled",
        "test/**",
        "**/*.test.js",
        "**/*.spec.js"
      ],
      "predeploy": [
        "cd functions && npm ci && npm run build"
      ],
      "runtime": "nodejs22",
      "memory": "512MB",
      "timeout": "60s",
      "minInstances": 0,
      "maxInstances": 10,
      "concurrency": 1000,
      "cpu": 1,
      "environmentVariables": {
        "NODE_ENV": "production",
        "FUNCTIONS_SURFACE": "retired"
      },
      "labels": {
        "deployment-type": "production",
        "app": "alchm",
        "environment": "prod"
      }
    }
  ],

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "extensions": {},

  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5002
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
