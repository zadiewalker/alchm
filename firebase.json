            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "X-Mobile-Optimized",
              "value": "trauma-informed"
            },
            {
              "key": "X-Crisis-Ready",
              "value": "true"
            },
            {
              "key": "X-Touch-Targets",
              "value": "accessibility-enhanced"
            }
          ]
        }
      ],
      "cleanUrls": false,
      "trailingSlash": false
    }
  ],
  
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "*.disabled",
        "src/**/*.disabled",
        "test/**",
        "**/*.test.js",
        "**/*.spec.js"
      ],
      "predeploy": [
        "cd functions && npm ci --only=production && npm run build"
      ],
      "runtime": "nodejs20",
      "memory": "1GB",
      "timeout": "60s",
      "minInstances": 1,
      "maxInstances": 100,
      "concurrency": 1000,
      "cpu": 1,
      "environmentVariables": {
        "NODE_ENV": "production",
        "CRISIS_ESCALATION_ENABLED": "true",
        "MONITORING_LEVEL": "HIGH"
      },
      "labels": {
        "deployment-type": "production",
        "app": "alchm",
        "environment": "prod"
      }
    }
  ],

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "storage": {
    "rules": "storage.rules"
  },

  "database": {
    "rules": "database.rules.json"
  },

  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },

  "extensions": {},

  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5002
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "logging": {
      "level": "DEBUG"
    }
  }
}