  "dataRetention": {
    "description": "Data retention policies for emotional wellness data",
    "policies": [
      {
        "collection": "users/{uid}/emotions/{entryId}",
        "retentionPeriod": "7 years",
        "archiveAfter": "2 years",
        "anonymizeAfter": "5 years"
      },
      {
        "collection": "users/{uid}/emotionalPatterns/{patternId}",
        "retentionPeriod": "5 years",
        "updateFrequency": "monthly"
      },
      {
        "collection": "users/{uid}/aiInsights/{insightId}",
        "retentionPeriod": "3 years",
        "relevancyCheck": "quarterly"
      },
      {
        "collection": "users/{uid}/wellnessPrompts/{promptId}",
        "retentionPeriod": "1 year",
        "cleanupAfter": "30 days if not engaged"
      }
    ]
  },

  "privacyConsiderations": {
    "description": "Privacy and security considerations for emotional wellness data",
    "principles": [
      "User owns all their emotional wellness data",
      "Data is encrypted at rest and in transit",
      "No personally identifiable information in aggregates",
      "User can export or delete all data at any time",
      "AI insights are generated locally when possible",
      "Cultural context data is handled with special sensitivity",
      "Trauma-informed data handling throughout system",
      "Community sharing is opt-in only with granular controls"
    ],
    "dataMinimization": {
      "collectOnlyNecessary": true,
      "purposeLimitation": true,
      "storageMinimization": true,
      "accessControls": "strict"
    },
    "userRights": [
      "Right to access all data",
      "Right to export data in portable format",
      "Right to delete all data",
      "Right to correct inaccurate data",
      "Right to restrict processing",
      "Right to data portability",
      "Right to object to automated decision-making"
    ]
