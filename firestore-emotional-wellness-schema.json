  "rules": {
    "description": "Firestore security rules for emotional wellness data",
    "content": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Users can only access their own emotional wellness data\n    match /users/{uid}/emotions/{entryId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    match /users/{uid}/emotionalPatterns/{patternId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    match /users/{uid}/aiInsights/{insightId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    match /users/{uid}/wellnessMetrics/{metricId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    match /users/{uid}/wellnessPrompts/{promptId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    match /users/{uid}/trajectoryAnalysis/{analysisId} {\n      allow read, write: if request.auth != null && request.auth.uid == uid;\n    }\n    \n    // Aggregated data is read-only for authenticated users\n    match /emotionalWellnessAggregates/{document=**} {\n      allow read: if request.auth != null;\n      allow write: if false; // Only server can write aggregates\n    }\n  }\n}"
  },

