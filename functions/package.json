{
  "name": "functions",
  "description": "ALCHM Firebase Cloud Functions - Minimal Production Setup",
  "version": "1.0.0",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "npm exec tsc",
    "build:watch": "npm exec tsc --watch",
    "prebuild": "rm -rf lib",
    "postbuild": "echo '✅ Functions build completed'",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1",
    "next": "14.2.32"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "typescript": "^5.5.2"
  },
  "private": true
}
