/**
 * Crisis Monitoring Firebase Functions
 * 
 * Server-side monitoring and alerting for crisis intervention systems
 * Provides real-time monitoring, automated testing, and emergency alerting
 * 
 * CRITICAL: These functions monitor life-safety systems and must be highly reliable
 */

import * as functions from 'firebase-functions';
import * as admin from 'firebase-admin';
import { defineSecret } from 'firebase-functions/params';

// Initialize Firebase Admin if not already initialized
if (!admin.apps.length) {
  admin.initializeApp();
}

const db = admin.firestore();

// Define secrets for external monitoring services
const slackWebhookUrl = defineSecret('SLACK_WEBHOOK_URL');
const pagerDutyApiKey = defineSecret('PAGERDUTY_API_KEY');
const twilioAccountSid = defineSecret('TWILIO_ACCOUNT_SID');
const twilioAuthToken = defineSecret('TWILIO_AUTH_TOKEN');

// Types for crisis monitoring
interface CrisisAlert {
  level: 'info' | 'warning' | 'critical' | 'emergency';
  message: string;
  service: string;
  timestamp: string;
  resolved?: boolean;
  impact: 'low' | 'medium' | 'high' | 'critical';
  metadata?: any;
}

interface MonitoringMetrics {
  service: string;
  responseTime: number;
  availability: number;
  errorRate: number;
  timestamp: string;
  details?: any;
}

interface CrisisSystemStatus {
  overall: 'healthy' | 'degraded' | 'critical' | 'offline';
  services: {
    crisisDetection: 'healthy' | 'degraded' | 'critical' | 'offline';
    emergencyResources: 'healthy' | 'degraded' | 'critical' | 'offline';
    culturalCompetency: 'healthy' | 'degraded' | 'critical' | 'offline';
    userExperience: 'healthy' | 'degraded' | 'critical' | 'offline';
  };
  lastChecked: string;
  activeAlerts: number;
}

// Crisis system health monitoring function (runs every minute)
export const monitorCrisisSystemHealth = functions
  .runWith({ secrets: [slackWebhookUrl, pagerDutyApiKey] })
  .pubsub.schedule('every 1 minutes')
  .onRun(async (context) => {
    console.log('🚨 Starting crisis system health monitoring...');
    
    try {
      const healthChecks = await Promise.allSettled([
        checkCrisisDetectionHealth(),
        checkEmergencyResourceHealth(),
        checkCulturalCompetencyHealth(),
        checkUserExperienceHealth()
      ]);

      const systemStatus: CrisisSystemStatus = {
        overall: 'healthy',
        services: {
          crisisDetection: 'healthy',
          emergencyResources: 'healthy',
          culturalCompetency: 'healthy',
          userExperience: 'healthy'
        },
        lastChecked: new Date().toISOString(),
        activeAlerts: 0
      };

      // Process health check results
      healthChecks.forEach((result, index) => {
        const serviceNames = ['crisisDetection', 'emergencyResources', 'culturalCompetency', 'userExperience'] as const;
        const serviceName = serviceNames[index];

        if (result.status === 'fulfilled') {
          systemStatus.services[serviceName] = result.value.status;
          if (result.value.status !== 'healthy') {
            systemStatus.overall = systemStatus.overall === 'healthy' ? result.value.status : 'critical';
          }
        } else {
          systemStatus.services[serviceName] = 'critical';
          systemStatus.overall = 'critical';
          console.error(`Health check failed for ${serviceName}:`, result.reason);
        }
      });

      // Count active alerts
      const activeAlertsSnapshot = await db.collection('crisis_alerts')
        .where('resolved', '!=', true)
        .get();
      systemStatus.activeAlerts = activeAlertsSnapshot.size;

      // Store system status
      await db.collection('crisis_system_status').add({
        ...systemStatus,
        timestamp: admin.firestore.FieldValue.serverTimestamp()
      });

      // Send alerts if system is degraded or critical
      if (systemStatus.overall !== 'healthy') {
        await sendCriticalAlert({
          level: systemStatus.overall === 'critical' ? 'critical' : 'warning',
          message: `Crisis system status: ${systemStatus.overall}`,
          service: 'crisis-monitoring',
          timestamp: new Date().toISOString(),
          impact: systemStatus.overall === 'critical' ? 'critical' : 'high',
          metadata: systemStatus
        });
      }

      console.log(`✅ Crisis system monitoring complete. Status: ${systemStatus.overall}`);
      return { status: 'success', systemStatus };

    } catch (error) {
      console.error('❌ Crisis system monitoring failed:', error);
      
      // Send emergency alert for monitoring system failure
      await sendCriticalAlert({
        level: 'emergency',
        message: 'Crisis monitoring system failure',
        service: 'crisis-monitoring',
        timestamp: new Date().toISOString(),
        impact: 'critical',
        metadata: { error: error instanceof Error ? error.message : 'Unknown error' }
      });

      throw error;
    }
  });

// Crisis detection health check
async function checkCrisisDetectionHealth(): Promise<{ status: 'healthy' | 'degraded' | 'critical' | 'offline'; details: any }> {
  const startTime = Date.now();
  
  try {
    // Test crisis detection API with a simple request
    const testResponse = await fetch('https://your-app-domain.com/api/crisis-detection', {
      method: 'GET',
      headers: { 'User-Agent': 'Crisis-Monitor/1.0' }
    });

    const responseTime = Date.now() - startTime;
    
    if (!testResponse.ok) {
      return {
        status: 'critical',
        details: { error: `HTTP ${testResponse.status}`, responseTime }
      };
    }

    // Check response time thresholds
    if (responseTime > 5000) {
      return {
        status: 'critical',
        details: { responseTime, threshold: 5000 }
      };
    } else if (responseTime > 3000) {
      return {
        status: 'degraded',
        details: { responseTime, threshold: 3000 }
      };
    }

    return {
      status: 'healthy',
      details: { responseTime, status: 'operational' }
    };

  } catch (error) {
    return {
      status: 'offline',
      details: { error: error instanceof Error ? error.message : 'Unknown error' }
    };
  }
}

// Emergency resource health check
async function checkEmergencyResourceHealth(): Promise<{ status: 'healthy' | 'degraded' | 'critical' | 'offline'; details: any }> {
  const resourceChecks = [
    { name: '988 Lifeline', url: 'https://988lifeline.org', timeout: 5000 },
    { name: 'Crisis Text Line', url: 'https://www.crisistextline.org', timeout: 5000 },
    { name: 'International Helplines', url: 'https://findahelpline.com', timeout: 5000 }
  ];

  const results = await Promise.allSettled(
    resourceChecks.map(async (resource) => {
      const startTime = Date.now();
      const response = await fetch(resource.url, {
        method: 'HEAD',
        signal: AbortSignal.timeout(resource.timeout)
      });
      return {
        name: resource.name,
        accessible: response.ok,
        responseTime: Date.now() - startTime,
        status: response.status
      };
    })
  );

  const successfulChecks = results.filter(result => 
    result.status === 'fulfilled' && result.value.accessible
  ).length;

  const accessibilityRate = (successfulChecks / resourceChecks.length) * 100;

  if (accessibilityRate < 50) {
    return {
      status: 'critical',
      details: { accessibilityRate, failedResources: results.length - successfulChecks }
    };
  } else if (accessibilityRate < 80) {
    return {
      status: 'degraded',
      details: { accessibilityRate, failedResources: results.length - successfulChecks }
    };
  }

  return {
    status: 'healthy',
    details: { accessibilityRate, allResourcesAccessible: true }
  };
}

// Cultural competency health check
async function checkCulturalCompetencyHealth(): Promise<{ status: 'healthy' | 'degraded' | 'critical' | 'offline'; details: any }> {
  try {
    // Check recent cultural competency test results
    const recentTests = await db.collection('cultural_crisis_tests')
      .where('timestamp', '>=', admin.firestore.Timestamp.fromDate(new Date(Date.now() - 24 * 60 * 60 * 1000)))
      .get();

    if (recentTests.empty) {
      return {
        status: 'degraded',
        details: { reason: 'No recent cultural competency tests' }
      };
    }

    const tests = recentTests.docs.map(doc => doc.data());
    const appropriateResponses = tests.filter(test => test.culturallyAppropriate).length;
    const competencyRate = (appropriateResponses / tests.size) * 100;

    if (competencyRate < 80) {
      return {
        status: 'critical',
        details: { competencyRate, totalTests: tests.length }
      };
    } else if (competencyRate < 90) {
      return {
        status: 'degraded',
        details: { competencyRate, totalTests: tests.length }
      };
    }

    return {
      status: 'healthy',
      details: { competencyRate, totalTests: tests.length }
    };

  } catch (error) {
    return {
      status: 'offline',
      details: { error: error instanceof Error ? error.message : 'Unknown error' }
    };
  }
}

// User experience health check
async function checkUserExperienceHealth(): Promise<{ status: 'healthy' | 'degraded' | 'critical' | 'offline'; details: any }> {
  try {
    // Check recent UX test results
    const recentUXTests = await db.collection('crisis_ux_tests')
      .where('timestamp', '>=', admin.firestore.Timestamp.fromDate(new Date(Date.now() - 24 * 60 * 60 * 1000)))
      .get();

    if (recentUXTests.empty) {
      return {
        status: 'degraded',
        details: { reason: 'No recent UX tests' }
      };
    }

    const tests = recentUXTests.docs.map(doc => doc.data());
    const averageScore = tests.reduce((sum, test) => sum + test.overallScore, 0) / tests.length;
    const criticalIssuesCount = tests.reduce((sum, test) => sum + test.criticalIssues.length, 0);

    if (averageScore < 70 || criticalIssuesCount > 10) {
      return {
        status: 'critical',
        details: { averageScore, criticalIssuesCount, totalTests: tests.length }
      };
    } else if (averageScore < 80 || criticalIssuesCount > 5) {
      return {
        status: 'degraded',
        details: { averageScore, criticalIssuesCount, totalTests: tests.length }
      };
    }

    return {
      status: 'healthy',
      details: { averageScore, criticalIssuesCount, totalTests: tests.length }
    };

  } catch (error) {
    return {
      status: 'offline',
      details: { error: error instanceof Error ? error.message : 'Unknown error' }
    };
  }
}

// Send critical alerts to external monitoring systems
async function sendCriticalAlert(alert: CrisisAlert): Promise<void> {
  console.log(`🚨 CRISIS ALERT [${alert.level.toUpperCase()}]: ${alert.message}`);

  // Store alert in Firestore
  await db.collection('crisis_alerts').add({
    ...alert,
    timestamp: admin.firestore.FieldValue.serverTimestamp()
  });

  // Send to Slack if configured
  try {
    if (alert.level === 'critical' || alert.level === 'emergency') {
      await sendSlackAlert(alert);
    }
  } catch (error) {
    console.error('Failed to send Slack alert:', error);
  }

  // Send to PagerDuty for critical/emergency alerts
  try {
    if (alert.level === 'emergency') {
      await sendPagerDutyAlert(alert);
    }
  } catch (error) {
    console.error('Failed to send PagerDuty alert:', error);
  }
}

// Send alert to Slack
async function sendSlackAlert(alert: CrisisAlert): Promise<void> {
  const webhookUrl = slackWebhookUrl.value();
  if (!webhookUrl) return;

  const color = alert.level === 'emergency' ? '#FF0000' : 
                alert.level === 'critical' ? '#FF6600' : '#FFCC00';

  const slackMessage = {
    text: `🚨 ALCHM Crisis System Alert`,
    attachments: [{
      color,
      title: `${alert.level.toUpperCase()}: ${alert.service}`,
      text: alert.message,
      fields: [
        {
          title: 'Impact',
          value: alert.impact,
          short: true
        },
        {
          title: 'Timestamp',
          value: alert.timestamp,
          short: true
        }
      ],
      footer: 'ALCHM Crisis Monitoring',
      ts: Math.floor(new Date(alert.timestamp).getTime() / 1000)
    }]
  };

  await fetch(webhookUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(slackMessage)
  });
}

// Send alert to PagerDuty
async function sendPagerDutyAlert(alert: CrisisAlert): Promise<void> {
  const apiKey = pagerDutyApiKey.value();
  if (!apiKey) return;

  const pagerDutyEvent = {
    routing_key: apiKey,
    event_action: 'trigger',
    payload: {
      summary: `ALCHM Crisis Emergency: ${alert.message}`,
      severity: 'critical',
      source: alert.service,
      component: 'crisis-system',
      group: 'alchm-emergency',
      class: 'crisis-monitoring',
      custom_details: alert.metadata
    }
  };

  await fetch('https://events.pagerduty.com/v2/enqueue', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Token token=${apiKey}`
    },
    body: JSON.stringify(pagerDutyEvent)
  });
}

// Automated crisis testing function (runs every 15 minutes)
export const runAutomatedCrisisTests = functions
  .runWith({ timeoutSeconds: 540, memory: '1GB' })
  .pubsub.schedule('every 15 minutes')
  .onRun(async (context) => {
    console.log('🧪 Starting automated crisis testing...');

    try {
      // Run abbreviated crisis detection tests
      const testResults = await runCrisisDetectionTests();
      
      // Store test results
      await db.collection('automated_crisis_tests').add({
        results: testResults,
        timestamp: admin.firestore.FieldValue.serverTimestamp(),
        testType: 'automated-monitoring'
      });

      // Check for failures and send alerts
      const failedTests = testResults.filter(result => !result.success);
      if (failedTests.length > 0) {
        await sendCriticalAlert({
          level: 'warning',
          message: `${failedTests.length} automated crisis tests failed`,
          service: 'automated-testing',
          timestamp: new Date().toISOString(),
          impact: 'medium',
          metadata: { failedTests: failedTests.map(t => t.testName) }
        });
      }

      console.log(`✅ Automated crisis testing complete. ${testResults.length - failedTests.length}/${testResults.length} tests passed`);
      return { status: 'success', results: testResults };

    } catch (error) {
      console.error('❌ Automated crisis testing failed:', error);
      
      await sendCriticalAlert({
        level: 'critical',
        message: 'Automated crisis testing system failure',
        service: 'automated-testing',
        timestamp: new Date().toISOString(),
        impact: 'high',
        metadata: { error: error instanceof Error ? error.message : 'Unknown error' }
      });

      throw error;
    }
  });

// Run crisis detection tests
async function runCrisisDetectionTests(): Promise<{ testName: string; success: boolean; responseTime: number; error?: string }[]> {
  const testCases = [
    {
      name: 'English Immediate Crisis',
      text: 'I want to kill myself',
      expectedDetection: true
    },
    {
      name: 'Spanish Crisis',
      text: 'quiero matarme',
      expectedDetection: true
    },
    {
      name: 'Normal Sadness',
      text: 'I feel sad today but things will get better',
      expectedDetection: false
    }
  ];

  const results = [];

  for (const testCase of testCases) {
    const startTime = Date.now();
    try {
      const response = await fetch('https://your-app-domain.com/api/crisis-detection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: testCase.text,
          userId: 'automated-test',
          userLanguage: 'en'
        })
      });

      const responseTime = Date.now() - startTime;
      const data = await response.json();
      
      const detectionCorrect = data.crisisDetected === testCase.expectedDetection;
      const responseTimeFast = responseTime <= 3000;

      results.push({
        testName: testCase.name,
        success: response.ok && detectionCorrect && responseTimeFast,
        responseTime,
        error: !response.ok ? `HTTP ${response.status}` : 
               !detectionCorrect ? 'Incorrect crisis detection' : 
               !responseTimeFast ? 'Response too slow' : undefined
      });

    } catch (error) {
      results.push({
        testName: testCase.name,
        success: false,
        responseTime: Date.now() - startTime,
        error: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  }

  return results;
}

// Crisis metrics aggregation function (runs daily)
export const aggregateCrisisMetrics = functions
  .pubsub.schedule('every 24 hours')
  .onRun(async (context) => {
    console.log('📊 Aggregating daily crisis metrics...');

    try {
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      
      // Aggregate health metrics
      const healthMetrics = await db.collection('crisis_health_metrics')
        .where('timestamp', '>=', admin.firestore.Timestamp.fromDate(yesterday))
        .get();

      // Aggregate cultural competency metrics
      const culturalTests = await db.collection('cultural_crisis_tests')
        .where('timestamp', '>=', admin.firestore.Timestamp.fromDate(yesterday))
        .get();

      // Aggregate UX metrics
      const uxTests = await db.collection('crisis_ux_tests')
        .where('timestamp', '>=', admin.firestore.Timestamp.fromDate(yesterday))
        .get();

      const dailyMetrics = {
        date: yesterday.toISOString().split('T')[0],
        healthChecks: {
          total: healthMetrics.size,
          averageResponseTime: calculateAverageResponseTime(healthMetrics.docs),
          availabilityRate: calculateAvailabilityRate(healthMetrics.docs)
        },
        culturalCompetency: {
          total: culturalTests.size,
          competencyRate: calculateCulturalCompetencyRate(culturalTests.docs),
          languageAccuracy: calculateLanguageAccuracy(culturalTests.docs)
        },
        userExperience: {
          total: uxTests.size,
          averageScore: calculateAverageUXScore(uxTests.docs),
          criticalIssues: countCriticalUXIssues(uxTests.docs)
        },
        timestamp: admin.firestore.FieldValue.serverTimestamp()
      };

      // Store daily metrics
      await db.collection('daily_crisis_metrics').add(dailyMetrics);

      console.log('✅ Daily crisis metrics aggregated successfully');
      return { status: 'success', metrics: dailyMetrics };

    } catch (error) {
      console.error('❌ Failed to aggregate crisis metrics:', error);
      throw error;
    }
  });

// Helper functions for metrics calculation
function calculateAverageResponseTime(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  if (docs.length === 0) return 0;
  const total = docs.reduce((sum, doc) => sum + (doc.data().responseTime || 0), 0);
  return total / docs.length;
}

function calculateAvailabilityRate(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  if (docs.length === 0) return 0;
  const available = docs.filter(doc => doc.data().status === 'healthy').length;
  return (available / docs.length) * 100;
}

function calculateCulturalCompetencyRate(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  if (docs.length === 0) return 0;
  const appropriate = docs.filter(doc => doc.data().culturallyAppropriate === true).length;
  return (appropriate / docs.length) * 100;
}

function calculateLanguageAccuracy(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  const multilingualTests = docs.filter(doc => doc.data().language !== 'en');
  if (multilingualTests.length === 0) return 100;
  
  const accurate = multilingualTests.filter(doc => 
    doc.data().culturallyAppropriate === true && doc.data().issues.length === 0
  ).length;
  
  return (accurate / multilingualTests.length) * 100;
}

function calculateAverageUXScore(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  if (docs.length === 0) return 0;
  const total = docs.reduce((sum, doc) => sum + (doc.data().overallScore || 0), 0);
  return total / docs.length;
}

function countCriticalUXIssues(docs: admin.firestore.QueryDocumentSnapshot[]): number {
  return docs.reduce((sum, doc) => sum + (doc.data().criticalIssues?.length || 0), 0);
}

// Emergency alert cleanup function (runs weekly)
export const cleanupResolvedAlerts = functions
  .pubsub.schedule('every sunday 02:00')
  .onRun(async (context) => {
    console.log('🧹 Cleaning up resolved crisis alerts...');

    try {
      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

      const resolvedAlerts = await db.collection('crisis_alerts')
        .where('resolved', '==', true)
        .where('timestamp', '<', admin.firestore.Timestamp.fromDate(oneWeekAgo))
        .get();

      const batch = db.batch();
      resolvedAlerts.docs.forEach(doc => {
        batch.delete(doc.ref);
      });

      await batch.commit();

      console.log(`✅ Cleaned up ${resolvedAlerts.size} resolved alerts`);
      return { status: 'success', deletedAlerts: resolvedAlerts.size };

    } catch (error) {
      console.error('❌ Failed to cleanup resolved alerts:', error);
      throw error;
    }
  });

// Manual crisis system test trigger
export const triggerCrisisSystemTest = functions.https.onCall(async (data, context) => {
  // Verify the user is authenticated and has admin privileges
  if (!context.auth || !context.auth.token.admin) {
    throw new functions.https.HttpsError('permission-denied', 'Admin access required');
  }

  console.log('🧪 Manual crisis system test triggered');

  try {
    const testResults = await runCrisisDetectionTests();
    
    // Store manual test results
    await db.collection('manual_crisis_tests').add({
      results: testResults,
      triggeredBy: context.auth.uid,
      timestamp: admin.firestore.FieldValue.serverTimestamp(),
      testType: 'manual-trigger'
    });

    return {
      status: 'success',
      results: testResults,
      timestamp: new Date().toISOString()
    };

  } catch (error) {
    console.error('❌ Manual crisis test failed:', error);
    throw new functions.https.HttpsError('internal', 'Crisis test execution failed');
  }
});