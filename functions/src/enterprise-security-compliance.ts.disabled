function calculateComplianceScore(findings: ComplianceFinding[]): number {
  const weights = { critical: 20, violation: 10, warning: 5, info: 1 };
  const totalDeductions = findings.reduce((sum, finding) => {
    return sum + (weights[finding.severity as keyof typeof weights] || 0);
  }, 0);
  
  return Math.max(0, 100 - totalDeductions);
}