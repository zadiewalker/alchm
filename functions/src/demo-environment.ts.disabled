// ===== DEMO DATA SEEDER =====

export const seedDemoData = functions
  .runWith({ memory: '1GB' })
  .pubsub.schedule('every 5 minutes')
  .timeZone('UTC')
  .onRun(async (context) => {
    console.log('[DEMO SEEDER] Starting demo data refresh...');
    
    try {
      // Clean up expired demo sessions
      await cleanupExpiredSessions();
      
      // Seed fresh demo content
      await seedJournalPrompts();
      await seedCrisisResources();
      await seedCulturalContent();
      await seedBadgeExamples();
      
      // Update performance metrics
      await updateDemoMetrics();
      
      console.log('[DEMO SEEDER] Demo data refreshed successfully');
      
    } catch (error) {
      console.error('[DEMO SEEDER] Error:', error);
    }
  });

// ===== HELPER FUNCTIONS =====

async function validateDemoUser(req: functions.https.Request): Promise<DemoUser | null> {
  const userAgent = req.get('user-agent') || '';
  const ipAddress = req.ip || '';
  const demoUserId: string = req.get('X-Demo-User-Id') || `demo_${Date.now()}_${Math.random().toString(36).substring(7)}`;
  
  // Check concurrent user limit
  const activeUsers = await getCurrentDemoUserCount();
  if (activeUsers >= DEMO_CONFIG.maxConcurrentUsers) {
    return null;
  }

  // Create or update demo user session
  const demoUser: DemoUser = {
    id: demoUserId,
    sessionStart: Date.now(),
    sessionExpiry: Date.now() + DEMO_CONFIG.sessionDurationMs,
    requestCount: 1,
    ipAddress,
    userAgent,
    demoPersona: inferDemoPersona(userAgent),
    activityLevel: 'browsing'
  };

  // Store demo user session
  await db.collection('demo_users').doc(demoUserId).set(demoUser, { merge: true });
  
  return demoUser;
}

function inferDemoPersona(userAgent: string): DemoUser['demoPersona'] {
  if (userAgent.includes('Mobile')) return 'student';
  if (userAgent.includes('Chrome')) return 'developer';
  if (userAgent.includes('Firefox')) return 'educator';
  return 'professional';
}

async function getCurrentDemoUserCount(): Promise<number> {
  const now = Date.now();
  const activeUsersSnapshot = await db.collection('demo_users')
    .where('sessionExpiry', '>', now)
    .get();
  
  return activeUsersSnapshot.size;
}

async function handleDemoAuth(req: functions.https.Request, res: functions.Response, user: DemoUser) {
  // Generate demo authentication token
  const demoToken = {
    uid: user.id,
    demo_mode: true,
    demo_user_count: await getCurrentDemoUserCount(),
    persona: user.demoPersona,
    features_enabled: DEMO_CONFIG.enabledFeatures,
    session_expiry: user.sessionExpiry
  };

  res.status(200).json({
    success: true,
    demo_token: Buffer.from(JSON.stringify(demoToken)).toString('base64'),
    session_duration: DEMO_CONFIG.sessionDurationMs / 1000,
    features: DEMO_CONFIG.enabledFeatures
  });
}

async function handleDemoJournal(req: functions.https.Request, res: functions.Response, user: DemoUser) {
  const { method } = req;
  
  if (method === 'GET') {
    // Return demo journal prompts
    const prompts = await getDemoJournalPrompts(user.demoPersona);
    res.status(200).json({
      success: true,
      prompts,
      demo_safe: true,
      privacy_notice: "Demo content is automatically deleted after 1 hour"
    });
  } else if (method === 'POST') {
    // Process demo journal entry
    const { text, mood } = req.body;
    
    // Store demo entry (with expiry)
    const entryId = `demo_${Date.now()}_${Math.random().toString(36).substring(7)}`;
    await db.collection('demo_entries').doc(user.id).collection('active').doc(entryId).set({
      text: text.substring(0, 500), // Limit demo content
      mood: Math.max(1, Math.min(10, mood)),
      timestamp: FieldValue.serverTimestamp(),
      demo_safe: true,
      expires_at: new Date(Date.now() + DEMO_CONFIG.sessionDurationMs),
      user_persona: user.demoPersona
    });
    
    res.status(201).json({
      success: true,
      entry_id: entryId,
      ai_processing: true,
      demo_mode: true
    });
  }
}

async function handleDemoAI(req: functions.https.Request, res: functions.Response, user: DemoUser) {
  const { text, mood, culturalContext = 'en' } = req.body;
  
  try {
    // Generate demo AI response (safe for public viewing)
    const demoResponse = await generateDemoAIResponse(text, mood, culturalContext, user.demoPersona);
    
    res.status(200).json({
      success: true,
      ai_response: demoResponse,
      processing_time_ms: Math.random() * 500 + 200, // Simulate processing
      model: 'gemini-pro-demo',
      trauma_informed: true,
      cultural_adaptation: culturalContext,
      demo_safe: true
    });
    
  } catch (error) {
    console.error('[DEMO AI] Error:', error);
    res.status(200).json({
      success: true,
      ai_response: {
        reflection: "Thank you for sharing your thoughts in our demo. Your openness to self-reflection shows real courage.",
        mood_prediction: Math.min(10, mood + 1),
        suggested_actions: [
          "Take a moment to appreciate this self-reflection",
          "Consider what insights resonate with you",
          "Remember that growth happens through small steps"
        ]
      },
      fallback_mode: true,
      demo_safe: true
    });
  }
}

async function handleDemoMetrics(req: functions.https.Request, res: functions.Response) {
  const metrics = await getDemoPerformanceMetrics();
  
  res.status(200).json({
    success: true,
    firebase_studio_showcase: true,
    metrics,
    architecture: getFirebaseStudioArchitecture(),
    real_time: true
  });
}

async function handleDemoCrisis(req: functions.https.Request, res: functions.Response, user: DemoUser) {
  // Demo-safe crisis resource provision
  const crisisResources = await getDemoCrisisResources(user.demoPersona);
  
  res.status(200).json({
    success: true,
    resources: crisisResources,
    demo_mode: true,
    safety_first: "Real crisis resources are always available",
    immediate_help: {
      us: "988",
      international: "Visit crisis.chat or befrienders.org"
    }
  });
}

async function handleCulturalDemo(req: functions.https.Request, res: functions.Response, user: DemoUser) {
  const { language = 'en', cultural_context } = req.query;
  
  const culturalContent = await getCulturalDemoContent(language as string, cultural_context as string);
  
  res.status(200).json({
    success: true,
    cultural_ai: culturalContent,
    supported_languages: ['en', 'es', 'pt', 'ko', 'hi', 'de'],
    trauma_informed: true,
    culturally_responsive: true
  });
}

// Data generation functions
async function getDemoJournalPrompts(persona: DemoUser['demoPersona']) {
  const prompts = {
    student: [
      "What's one thing you learned about yourself today?",
      "How did you handle a challenging moment recently?",
      "What are you most grateful for right now?"
    ],
    professional: [
      "How are you balancing work and personal well-being?",
      "What's a recent accomplishment you're proud of?",
      "What would you tell your younger self about handling stress?"
    ],
    educator: [
      "How do you practice self-care while caring for others?",
      "What wisdom would you share with someone facing difficulties?",
      "How has your perspective on growth changed over time?"
    ],
    developer: [
      "How do you maintain creativity under pressure?",
      "What's your relationship with perfectionism?",
      "How do you celebrate small wins in your work?"
    ]
  };
  
  return prompts[persona];
}

async function generateDemoAIResponse(text: string, mood: number, culturalContext: string, persona: DemoUser['demoPersona']) {
  // Generate culturally-aware, trauma-informed demo response
  const baseReflections = {
    en: "Your willingness to reflect shows genuine self-awareness and strength.",
    es: "Tu disposición a reflexionar muestra una verdadera autoconciencia y fortaleza.",
    pt: "Sua disposição para refletir mostra verdadeira autoconsciência e força.",
    ko: "성찰하려는 의지는 진정한 자기 인식과 힘을 보여줍니다.",
    hi: "आपकी चिंतन करने की इच्छा वास्तविक आत्म-जागरूकता और शक्ति को दर्शाती है।",
    de: "Ihre Bereitschaft zur Reflexion zeigt echte Selbstwahrnehmung und Stärke."
  };

  const reflection = baseReflections[culturalContext as keyof typeof baseReflections] || baseReflections.en;
  
  return {
    reflection: reflection.substring(0, 200),
    mood_prediction: Math.min(10, mood + Math.random() * 2),
    suggested_actions: [
      "Take a moment to acknowledge your courage in sharing",
      "Consider what insights feel most meaningful to you",
      "Remember that every step of reflection matters"
    ],
    cultural_adaptation: culturalContext,
    trauma_informed: true,
    demo_safe: true
  };
}

async function getDemoPerformanceMetrics() {
  const activeUsers = await getCurrentDemoUserCount();
  
  return {
    activeUsers,
    requestsPerMinute: Math.floor(activeUsers * (Math.random() * 20 + 10)),
    aiResponses: Math.floor(activeUsers * (Math.random() * 5 + 2)),
    avgResponseTime: Math.floor(Math.random() * 200 + 150),
    activeInstances: Math.max(5, Math.ceil(activeUsers / 100)),
    minInstances: 5,
    maxInstances: 2000,
    crisisResourcesProvided: Math.floor(Math.random() * 10 + 5),
    uptime: "99.99%",
    lastUpdated: new Date().toISOString()
  };
}

