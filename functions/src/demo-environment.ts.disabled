// Cleanup functions
async function cleanupExpiredSessions() {
  const now = Date.now();
  const expiredSessions = await db.collection('demo_users')
    .where('sessionExpiry', '<', now)
    .get();
  
  const batch = db.batch();
  expiredSessions.forEach(doc => {
    batch.delete(doc.ref);
  });
  
  await batch.commit();
  console.log(`[CLEANUP] Removed ${expiredSessions.size} expired demo sessions`);
}

