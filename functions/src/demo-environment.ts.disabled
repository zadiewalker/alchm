// ALCHM Demo Environment - DevHunt Traffic Handler
// Designed for 1000+ concurrent users showcasing Firebase Studio capabilities

import * as functions from 'firebase-functions';
import * as admin from 'firebase-admin';
import { getFirestore, FieldValue, Timestamp } from 'firebase-admin/firestore';
import { GoogleGenerativeAI } from "@google/generative-ai";

const db = getFirestore();
const gemini = new GoogleGenerativeAI(process.env.GEMINI_API_KEY || "demo-key");

// ===== DEMO CONFIGURATION =====

const DEMO_CONFIG = {
  environment: "demo.alchm.app",
  maxConcurrentUsers: 1000,
  sessionDurationMs: 3600000, // 1 hour
  rateLimitPerMinute: 100,
  enabledFeatures: {
    journaling: true,
    ai_responses: true,
    crisis_detection: "demo_mode",
    analytics: "anonymized_only",
    cultural_ai: true,
    performance_metrics: "visible"
  },
  firebase_studio_showcase: {
    performance_metrics: "visible",
    deployment_info: "public", 
    architecture_diagrams: "embedded",
    cost_optimization: "documented"
  }
};

interface DemoUser {
  id: string;
  sessionStart: number;
  sessionExpiry: number;
  requestCount: number;
  ipAddress: string;
  userAgent: string;
  demoPersona: 'student' | 'professional' | 'educator' | 'developer';
  activityLevel: 'browsing' | 'testing' | 'deep-dive';
}

// ===== DEMO API HANDLER WITH RATE LIMITING =====

export const demoApiHandler = functions
  .runWith({ 
    memory: '2GB', 
    timeoutSeconds: 60,
    maxInstances: 2000
  })
  .https.onRequest(async (req, res): Promise<void> => {
    console.log(`[DEMO] ${req.method} ${req.url}`, {
      userAgent: req.get('user-agent'),
      ip: req.ip,
      timestamp: new Date().toISOString()
    });

    // Enable CORS for DevHunt testing
    res.set({
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization, X-Demo-User-Id',
      'X-Demo-Mode': 'true',
      'X-Firebase-Studio': 'ALCHM-DevHunt-2025'
    });

    if (req.method === 'OPTIONS') {
      res.status(200).end();
      return;
    }

    try {
      // Rate limiting and user validation
      const demoUser = await validateDemoUser(req);
      if (!demoUser) {
        res.status(429).json({
          error: 'Demo capacity reached',
          maxUsers: DEMO_CONFIG.maxConcurrentUsers,
          retryAfter: 60
        });
        return;
      }

      // Route demo API requests
      const endpoint = req.url.replace('/api/demo/', '');
      
      switch (endpoint) {
        case 'auth':
          await handleDemoAuth(req, res, demoUser);
          return;
        case 'journal':
          await handleDemoJournal(req, res, demoUser);
          return;
        case 'ai-response':
          await handleDemoAI(req, res, demoUser);
          return;
        case 'metrics':
          await handleDemoMetrics(req, res);
          return;
        case 'crisis-demo':
          await handleDemoCrisis(req, res, demoUser);
          return;
        case 'cultural-ai':
          await handleCulturalDemo(req, res, demoUser);
          return;
        default:
          res.status(404).json({ error: 'Demo endpoint not found' });
          return;
      }

    } catch (error) {
      console.error('[DEMO] Error:', error);
      res.status(500).json({ 
        error: 'Demo service temporarily unavailable',
        firebase_studio: 'Auto-scaling in progress'
      });
      return;
    }
  });

