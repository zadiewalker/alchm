  await db.collection('system_health').doc('crisis_monitoring').set({
    activeInterventions,
    staleAlerts,
    lastUpdate: FieldValue.serverTimestamp(),
    status: staleAlerts > 0 ? 'warning' : 'healthy'
  }, { merge: true });
}

