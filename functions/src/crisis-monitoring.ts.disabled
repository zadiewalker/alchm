async function triggerEmergencyEscalation(alertId: string, reason: string): Promise<void> {
  console.log(`🚨 EMERGENCY ESCALATION TRIGGERED for ${alertId}: ${reason}`);
  
  try {
    // Update alert with emergency escalation status
    await db.collection('crisis_alerts').doc(alertId).update({
      'escalation.level': 3,
      'escalation.escalatedAt': FieldValue.serverTimestamp(),
      'escalation.escalationReason': reason,
      'escalation.emergencyServicesContacted': false, // Will be updated when contacted
      'status': 'emergency_escalation'
    });
    
    // Trigger all available emergency protocols
    await Promise.all([
      notifyEmergencyTeam(alertId, reason),
      activateEmergencyDashboard(alertId),
      logEmergencyEscalation(alertId, reason)
    ]);
    
  } catch (error) {
    console.error('Error in emergency escalation:', error);
  }
}

