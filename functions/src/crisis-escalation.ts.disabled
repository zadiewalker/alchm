  // This would integrate with 911 dispatch systems or emergency service APIs
  // For now, logging the emergency service activation
  console.log(`🚨 EMERGENCY SERVICES ALERT - Alert ${alertId} requires immediate emergency intervention`);
  
  try {
    // Log emergency service activation
    await db.collection('emergency_service_activations').add({
      alertId,
      riskLevel: alertData.riskLevel,
      confidence: alertData.confidence,
      participantId: alertData.participantId,
      activatedAt: FieldValue.serverTimestamp(),
      reason: 'Crisis escalation reached emergency level',
      status: 'notified'
    });
    
    // In a real implementation, this would:
    // 1. Contact local emergency services with participant location
    // 2. Provide relevant crisis information to first responders
    // 3. Coordinate with local mental health crisis teams
    // 4. Ensure proper handoff to emergency medical services
    
  } catch (error) {
    console.error('Error in emergency service alert:', error);
  }
}

async function notifyEmergencyContacts(alertId: string, alertData: any, urgency: 'standby' | 'immediate'): Promise<void> {
  try {
    // Get participant's emergency contacts
    const participantDoc = await db.collection('participants').doc(alertData.participantId).get();
    
    if (!participantDoc.exists) {
      console.warn(`Participant ${alertData.participantId} not found for emergency contact notification`);
      return;
    }
    
    const emergencyContacts = participantDoc.data()?.emergencyContacts || [];
    
    if (emergencyContacts.length === 0) {
      console.warn(`No emergency contacts for participant ${alertData.participantId}`);
      return;
    }
    
    const message = urgency === 'immediate'
      ? `IMMEDIATE: Your emergency contact is receiving professional crisis support through ALCHM. Mental health professionals are responding. Contact: 988 Suicide & Crisis Lifeline if you need immediate assistance.`
      : `STANDBY: Your emergency contact may need additional support. ALCHM crisis professionals are monitoring the situation. We will update you if immediate action is needed.`;
    
    // Send notifications to emergency contacts
    const twilioConfig = functions.config().twilio;
    if (twilioConfig?.account_sid) {
      const Twilio = require('twilio');
      const twilioClient = new Twilio(twilioConfig.account_sid, twilioConfig.auth_token);
      
      const contactPromises = emergencyContacts.map(async (contact: any) => {
        if (contact.phone) {
          try {
            await twilioClient.messages.create({
              body: message,
              from: twilioConfig.crisis_number,
              to: contact.phone
            });
            console.log(`Emergency contact ${contact.name} notified (${urgency})`);
          } catch (error) {
            console.error(`Failed to notify emergency contact ${contact.name}:`, error);
          }
        }
      });
      
      await Promise.all(contactPromises);
    }
    
  } catch (error) {
    console.error('Error notifying emergency contacts:', error);
  }
}

// ===== HELPER FUNCTIONS =====

function getTimeSinceAlert(alertTimestamp: any): string {
  if (!alertTimestamp) return 'Unknown';
  
  const alertTime = alertTimestamp.toDate ? alertTimestamp.toDate() : new Date(alertTimestamp);
  const now = new Date();
  const diffMs = now.getTime() - alertTime.getTime();
  
  const hours = Math.floor(diffMs / (1000 * 60 * 60));
  const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
  
  if (hours > 0) {
    return `${hours}h ${minutes}m`;
  }
  return `${minutes}m`;
}

async function logEscalationEvent(
  alertId: string, 
  level: number, 
  eventType: string, 
  teamSize: number
): Promise<void> {
  try {
    await db.collection('escalation_events').add({
      alertId,
      escalationLevel: level,
      eventType,
      teamSize,
      timestamp: FieldValue.serverTimestamp(),
      processed: true
    });
  } catch (error) {
    console.error('Error logging escalation event:', error);
  }
}

async function logEmergencyEscalation(alertId: string, alertData: any): Promise<void> {
  await db.collection('emergency_escalations').add({
    alertId,
    participantId: alertData.participantId,
    riskLevel: alertData.riskLevel,
    confidence: alertData.confidence,
    originalTimestamp: alertData.timestamp,
    escalationTimestamp: FieldValue.serverTimestamp(),
    reason: 'No professional response to crisis alert',
    emergencyProtocolsActivated: true,
    systemStatus: 'maximum_escalation'
  });
}

async function triggerEmergencyEscalation(alertId: string, reason: string): Promise<void> {
  console.log(`🚨 TRIGGERING EMERGENCY ESCALATION for ${alertId}: ${reason}`);
  
  try {
    // Get alert data for emergency escalation
    const alertDoc = await db.collection('crisis_alerts').doc(alertId).get();
    const alertData = alertDoc.exists ? alertDoc.data() : {};
    
    await emergencyEscalation(alertId, alertData);
    
  } catch (error) {
    console.error('Error triggering emergency escalation:', error);
  }
}

async function fallbackEmergencyContact(alertId: string, alertData: any, originalError: any): Promise<void> {
  console.log(`Activating fallback emergency contact for ${alertId}`);
  
  try {
    // Log the critical failure
    await db.collection('critical_system_failures').add({
      alertId,
      failureType: 'emergency_escalation_failure',
      originalError: originalError.toString(),
      alertData: {
        riskLevel: alertData.riskLevel,
        participantId: alertData.participantId,
        timestamp: alertData.timestamp
      },
      fallbackActivated: true,
      timestamp: FieldValue.serverTimestamp()
    });
    
    // Attempt basic emergency notification via any available means
    console.log(`CRITICAL: Emergency escalation failed for ${alertId}. Manual intervention required.`);
    
  } catch (fallbackError) {
    console.error('CRITICAL: Even fallback emergency contact failed:', fallbackError);
  }
}

