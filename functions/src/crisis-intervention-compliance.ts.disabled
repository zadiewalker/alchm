// ALCHM Crisis Intervention Compliance Framework
// Legal frameworks for mandatory reporting and crisis intervention
// Trauma-informed crisis response with privacy protection

import * as functions from 'firebase-functions';
import * as admin from 'firebase-admin';
import { getFirestore, FieldValue, Timestamp } from 'firebase-admin/firestore';
import { getAuth } from 'firebase-admin/auth';

const db = getFirestore();
const auth = getAuth();

// ===== CRISIS INTERVENTION INTERFACES =====

interface CrisisAssessment {
  assessmentId: string;
  userId: string;
  triggeredBy: 'AI_DETECTION' | 'USER_REQUEST' | 'THIRD_PARTY_REPORT' | 'PROFESSIONAL_REFERRAL';
  riskLevel: 'LOW' | 'MEDIUM' | 'HIGH' | 'IMMINENT';
  riskFactors: RiskFactor[];
  protectiveFactors: ProtectiveFactors;
  suicidalIdeation: SuicidalIdeationAssessment;
  selfHarmRisk: SelfHarmRiskAssessment;
  timestamp: Timestamp;
  assessmentDetails: CrisisAssessmentDetails;
  interventionRequired: boolean;
  mandatoryReportingRequired: boolean;
  emergencyContactRequired: boolean;
  professionalNotificationRequired: boolean;
  status: 'OPEN' | 'IN_PROGRESS' | 'RESOLVED' | 'ESCALATED';
}

interface RiskFactor {
  factor: string;
  severity: 'LOW' | 'MEDIUM' | 'HIGH';
  source: 'USER_REPORTED' | 'AI_DETECTED' | 'HISTORICAL_DATA';
  confidence: number;
}

interface ProtectiveFactors {
  socialSupport: number; // 1-10 scale
  copingSkills: number;
  reasonsForLiving: string[];
  professionalSupport: boolean;
  safetyPlan: boolean;
}

interface SuicidalIdeationAssessment {
  present: boolean;
  intensity: 'NONE' | 'PASSIVE' | 'ACTIVE' | 'INTENT' | 'PLAN';
  method: string;
  timeline: string;
  deterrents: string[];
  previousAttempts: boolean;
}

interface SelfHarmRiskAssessment {
  present: boolean;
  type: 'CUTTING' | 'BURNING' | 'HITTING' | 'OTHER' | 'MULTIPLE';
  frequency: 'RARE' | 'OCCASIONAL' | 'FREQUENT' | 'DAILY';
  escalating: boolean;
  medicalAttention: boolean;
}

interface CrisisAssessmentDetails {
  triggerContent: string; // Encrypted journal entry or message
  contextualFactors: string[];
  userLocation?: string;
  emergencyContacts: EmergencyContact[];
  healthcareProviders: HealthcareProvider[];
  supportNetwork: SupportNetworkMember[];
  previousInterventions: string[];
}

interface EmergencyContact {
  contactId: string;
  name: string;
  relationship: string;
  phoneNumber: string;
  email?: string;
  preferredContact: boolean;
  consentToContact: boolean;
  lastContacted?: Timestamp;
}

interface HealthcareProvider {
  providerId: string;
  name: string;
  type: 'THERAPIST' | 'PSYCHIATRIST' | 'PRIMARY_CARE' | 'CRISIS_COUNSELOR';
  phoneNumber: string;
  email?: string;
  currentlyTreating: boolean;
  emergencyContact: boolean;
}

interface SupportNetworkMember {
  memberId: string;
  name: string;
  relationship: string;
  supportType: 'EMOTIONAL' | 'PRACTICAL' | 'PROFESSIONAL' | 'PEER';
  available: boolean;
  trusted: boolean;
}

interface CrisisIntervention {
  interventionId: string;
  assessmentId: string;
  userId: string;
  interventionType: 'SAFETY_PLANNING' | 'PROFESSIONAL_REFERRAL' | 'EMERGENCY_SERVICES' | 'PEER_SUPPORT' | 'FAMILY_NOTIFICATION';
  interventionLevel: 'AUTOMATED' | 'PEER_SUPPORT' | 'PROFESSIONAL' | 'EMERGENCY';
  timestamp: Timestamp;
  interventionDetails: CrisisInterventionDetails;
  legalConsiderations: LegalConsiderations;
  outcome: InterventionOutcome;
  followUpRequired: boolean;
  followUpScheduled?: Timestamp;
  status: 'INITIATED' | 'IN_PROGRESS' | 'COMPLETED' | 'ESCALATED';
}

interface CrisisInterventionDetails {
  interventionApproach: string;
  resourcesProvided: CrisisResource[];
  professionalInvolved?: string;
  familyNotified: boolean;
  emergencyServicesContacted: boolean;
  safetyPlanCreated: boolean;
  followUpPlan: string;
  userConsent: boolean;
  privilegeOverride?: boolean; // When professional privilege is overridden for safety
}

interface LegalConsiderations {
  mandatoryReportingApplies: boolean;
  reportingJurisdiction: string;
  reportingAgency?: string;
  reportingDeadline?: Timestamp;
  privilegeStatus: 'PROTECTED' | 'WAIVED' | 'OVERRIDDEN';
  consentRequired: boolean;
  consentObtained: boolean;
  legalBasis: string;
  documentationRequired: boolean;
}

interface InterventionOutcome {
  immediateRiskReduced: boolean;
  userEngaged: boolean;
  professionalConnected: boolean;
  safetyPlanInPlace: boolean;
  emergencyContactsNotified: boolean;
  followUpScheduled: boolean;
  userSatisfaction?: number;
  effectivenessRating: number;
}

interface CrisisResource {
  resourceId: string;
  name: string;
  type: 'HOTLINE' | 'WEBSITE' | 'MOBILE_APP' | 'LOCAL_SERVICE' | 'PEER_SUPPORT';
  description: string;
  contactInfo: string;
  availability: '24_7' | 'BUSINESS_HOURS' | 'EVENING_WEEKEND' | 'BY_APPOINTMENT';
  cost: 'FREE' | 'INSURANCE' | 'SLIDING_SCALE' | 'PAID';
  specializations: string[];
  location?: string;
  culturallySpecific: boolean;
}

// ===== CRISIS DETECTION AND ASSESSMENT =====

/**
 * Advanced AI-powered crisis detection
 */
export const detectCrisisRisk = functions
  .runWith({ memory: '512MB', timeoutSeconds: 60 })
  .firestore.document('entries/{userId}/active/{entryId}')
  .onCreate(async (snap, context) => {
    const entry = snap.data();
    const { userId, entryId } = context.params;
    
    try {
      // Analyze entry for crisis indicators
      const riskAssessment = await analyzeCrisisIndicators(entry.text, userId);
      
      if (riskAssessment.riskLevel !== 'LOW') {
        // Create crisis assessment
        const assessment = await createCrisisAssessment(userId, entryId, riskAssessment, 'AI_DETECTION');
        
        // Determine intervention requirements
        const interventionPlan = await planCrisisIntervention(assessment);
        
        // Execute intervention based on risk level
        await executeCrisisIntervention(assessment, interventionPlan);
        
        // Log crisis event for audit
        await logCrisisEvent(assessment, interventionPlan);
      }
      
    } catch (error) {
      console.error('Error in crisis detection:', error);
      // Fail-safe: Trigger basic safety response
      await triggerFailsafeCrisisResponse(userId, entryId);
    }
  });

/**
 * Analyzes text for crisis indicators using multiple methods
 */
async function analyzeCrisisIndicators(text: string, userId: string): Promise<{
  riskLevel: 'LOW' | 'MEDIUM' | 'HIGH' | 'IMMINENT';
  riskFactors: RiskFactor[];
  confidence: number;
  triggerWords: string[];
}> {
  
  const riskFactors: RiskFactor[] = [];
  const triggerWords: string[] = [];
  let riskScore = 0;
  
  // Critical risk keywords
  const criticalKeywords = [
    'suicide', 'kill myself', 'end my life', 'want to die', 'not worth living',
    'better off dead', 'take my own life', 'end it all', 'can\'t go on'
  ];
  
  const highRiskKeywords = [
    'self-harm', 'cut myself', 'hurt myself', 'punish myself', 'hate myself',
    'worthless', 'hopeless', 'no point', 'give up', 'can\'t cope'
  ];
  
  const mediumRiskKeywords = [
    'overwhelmed', 'breaking point', 'can\'t handle', 'too much', 'exhausted',
    'lonely', 'isolated', 'desperate', 'stuck', 'trapped'
  ];
  
  // Analyze for critical risk
  for (const keyword of criticalKeywords) {
    if (text.toLowerCase().includes(keyword)) {
      riskFactors.push({
        factor: `Critical keyword: ${keyword}`,
        severity: 'HIGH',
        source: 'AI_DETECTED',
        confidence: 0.9
      });
      triggerWords.push(keyword);
      riskScore += 10;
    }
  }
  
  // Analyze for high risk
  for (const keyword of highRiskKeywords) {
    if (text.toLowerCase().includes(keyword)) {
      riskFactors.push({
        factor: `High-risk keyword: ${keyword}`,
        severity: 'MEDIUM',
        source: 'AI_DETECTED',
        confidence: 0.8
      });
      triggerWords.push(keyword);
      riskScore += 5;
    }
  }
  
  // Analyze for medium risk
  for (const keyword of mediumRiskKeywords) {
    if (text.toLowerCase().includes(keyword)) {
      riskFactors.push({
        factor: `Medium-risk keyword: ${keyword}`,
        severity: 'LOW',
        source: 'AI_DETECTED',
        confidence: 0.7
      });
      triggerWords.push(keyword);
      riskScore += 2;
    }
  }
  
  // Contextual analysis
  const contextualRisk = await analyzeContextualRisk(text, userId);
  riskScore += contextualRisk.score;
  riskFactors.push(...contextualRisk.factors);
  
  // Determine overall risk level
  let riskLevel: 'LOW' | 'MEDIUM' | 'HIGH' | 'IMMINENT';
  if (riskScore >= 15) riskLevel = 'IMMINENT';
  else if (riskScore >= 10) riskLevel = 'HIGH';
  else if (riskScore >= 5) riskLevel = 'MEDIUM';
  else riskLevel = 'LOW';
  
  return {
    riskLevel,
    riskFactors,
    confidence: Math.min(riskScore / 20, 1.0),
    triggerWords
  };
}

/**
 * Analyzes contextual risk factors
 */
async function analyzeContextualRisk(text: string, userId: string): Promise<{
  score: number;
  factors: RiskFactor[];
}> {
  const factors: RiskFactor[] = [];
  let score = 0;
  
  // Get user's historical data
  const userDoc = await db.collection('users_standard').doc(userId).get();
  const userData = userDoc.data();
  
  // Check previous crisis history
  if (userData?.previousCrisisEvents > 0) {
    factors.push({
      factor: 'Previous crisis history',
      severity: 'MEDIUM',
      source: 'HISTORICAL_DATA',
      confidence: 0.8
    });
    score += 3;
  }
  
  // Check recent mood patterns
  const recentMoods = await getRecentMoodData(userId);
  if (recentMoods.averageMood < 4) {
    factors.push({
      factor: 'Declining mood trend',
      severity: 'MEDIUM',
      source: 'HISTORICAL_DATA',
      confidence: 0.7
    });
    score += 2;
  }
  
  // Check time of day (higher risk late at night)
  const currentHour = new Date().getHours();
  if (currentHour >= 22 || currentHour <= 5) {
    factors.push({
      factor: 'High-risk time period',
      severity: 'LOW',
      source: 'AI_DETECTED',
      confidence: 0.6
    });
    score += 1;
  }
  
  // Check for isolation indicators
  if (text.includes('alone') || text.includes('nobody') || text.includes('isolated')) {
    factors.push({
      factor: 'Social isolation indicators',
      severity: 'MEDIUM',
      source: 'AI_DETECTED',
      confidence: 0.7
    });
    score += 2;
  }
  
  return { score, factors };
}

/**
 * Creates comprehensive crisis assessment
 */
async function createCrisisAssessment(
  userId: string,
  entryId: string,
  riskAssessment: any,
  triggeredBy: CrisisAssessment['triggeredBy']
): Promise<CrisisAssessment> {
  
  const assessmentId = generateAssessmentId();
  
  // Get user profile for context
  const userProfile = await getUserProfileForCrisis(userId);
  
  // Assess suicidal ideation
  const suicidalIdeation = await assessSuicidalIdeation(riskAssessment);
  
  // Assess self-harm risk
  const selfHarmRisk = await assessSelfHarmRisk(riskAssessment);
  
  // Determine intervention requirements
  const interventionRequired = riskAssessment.riskLevel !== 'LOW';
  const mandatoryReportingRequired = await checkMandatoryReportingRequirements(userId, riskAssessment);
  const emergencyContactRequired = riskAssessment.riskLevel === 'IMMINENT';
  const professionalNotificationRequired = riskAssessment.riskLevel === 'HIGH' || riskAssessment.riskLevel === 'IMMINENT';
  
  const assessment: CrisisAssessment = {
    assessmentId,
    userId,
    triggeredBy,
    riskLevel: riskAssessment.riskLevel,
    riskFactors: riskAssessment.riskFactors,
    protectiveFactors: userProfile.protectiveFactors,
    suicidalIdeation,
    selfHarmRisk,
    timestamp: FieldValue.serverTimestamp() as Timestamp,
    assessmentDetails: {
      triggerContent: await encryptSensitiveContent(entryId),
      contextualFactors: riskAssessment.contextualFactors || [],
      emergencyContacts: userProfile.emergencyContacts,
      healthcareProviders: userProfile.healthcareProviders,
      supportNetwork: userProfile.supportNetwork,
      previousInterventions: userProfile.previousInterventions
    },
    interventionRequired,
    mandatoryReportingRequired,
    emergencyContactRequired,
    professionalNotificationRequired,
    status: 'OPEN'
  };
  
  // Store assessment
  await db.collection('crisis_assessments').doc(assessmentId).set(assessment);
  
  return assessment;
}

/**
 * Plans appropriate crisis intervention
 */
async function planCrisisIntervention(assessment: CrisisAssessment): Promise<{
  interventionType: CrisisIntervention['interventionType'];
  interventionLevel: CrisisIntervention['interventionLevel'];
  immediateActions: string[];
  resourcesNeeded: CrisisResource[];
  legalConsiderations: LegalConsiderations;
}> {
  
  let interventionType: CrisisIntervention['interventionType'];
  let interventionLevel: CrisisIntervention['interventionLevel'];
  const immediateActions: string[] = [];
  
  // Determine intervention based on risk level
  switch (assessment.riskLevel) {
    case 'IMMINENT':
      interventionType = 'EMERGENCY_SERVICES';
      interventionLevel = 'EMERGENCY';
      immediateActions.push('Contact emergency services', 'Notify emergency contacts', 'Create safety plan');
      break;
      
    case 'HIGH':
      interventionType = 'PROFESSIONAL_REFERRAL';
      interventionLevel = 'PROFESSIONAL';
      immediateActions.push('Connect with crisis counselor', 'Notify healthcare provider', 'Safety planning');
      break;
      
    case 'MEDIUM':
      interventionType = 'SAFETY_PLANNING';
      interventionLevel = 'PEER_SUPPORT';
      immediateActions.push('Provide crisis resources', 'Encourage professional help', 'Safety check-in');
      break;
      
    default:
      interventionType = 'PEER_SUPPORT';
      interventionLevel = 'AUTOMATED';
      immediateActions.push('Provide supportive resources', 'Monitor situation');
  }
  
  // Get appropriate resources
  const resourcesNeeded = await getCrisisResources(assessment.userId, assessment.riskLevel);
  
  // Determine legal considerations
  const legalConsiderations = await assessLegalConsiderations(assessment);
  
  return {
    interventionType,
    interventionLevel,
    immediateActions,
    resourcesNeeded,
    legalConsiderations
  };
}

/**
 * Executes crisis intervention
 */
async function executeCrisisIntervention(
  assessment: CrisisAssessment,
  interventionPlan: any
): Promise<CrisisIntervention> {
  
  const interventionId = generateInterventionId();
  
  try {
    // Execute immediate actions
    const actionResults = await executeImmediateActions(assessment, interventionPlan);
    
    // Create intervention record
    const intervention: CrisisIntervention = {
      interventionId,
      assessmentId: assessment.assessmentId,
      userId: assessment.userId,
      interventionType: interventionPlan.interventionType,
      interventionLevel: interventionPlan.interventionLevel,
      timestamp: FieldValue.serverTimestamp() as Timestamp,
      interventionDetails: {
        interventionApproach: getInterventionApproach(assessment.riskLevel),
        resourcesProvided: interventionPlan.resourcesNeeded,
        professionalInvolved: actionResults.professionalInvolved,
        familyNotified: actionResults.familyNotified,
        emergencyServicesContacted: actionResults.emergencyServicesContacted,
        safetyPlanCreated: actionResults.safetyPlanCreated,
        followUpPlan: actionResults.followUpPlan,
        userConsent: actionResults.userConsent,
        privilegeOverride: actionResults.privilegeOverride
      },
      legalConsiderations: interventionPlan.legalConsiderations,
      outcome: actionResults.outcome,
      followUpRequired: true,
      followUpScheduled: Timestamp.fromDate(new Date(Date.now() + 24 * 60 * 60 * 1000)), // 24 hours
      status: 'INITIATED'
    };
    
    // Store intervention
    await db.collection('crisis_interventions').doc(interventionId).set(intervention);
    
    // Schedule follow-up
    await scheduleFollowUp(intervention);
    
    return intervention;
    
  } catch (error) {
    console.error('Error executing crisis intervention:', error);
    throw error;
  }
}

/**
 * Handles mandatory reporting requirements
 */
async function checkMandatoryReportingRequirements(
  userId: string,
  riskAssessment: any
): Promise<boolean> {
  
  // Get user age and jurisdiction
  const userDoc = await db.collection('users_standard').doc(userId).get();
  const userData = userDoc.data();
  const userAge = userData?.age || 18;
  const jurisdiction = userData?.jurisdiction || 'unknown';
  
  // Check for mandatory reporting triggers
  const mandatoryTriggers = [
    riskAssessment.riskLevel === 'IMMINENT',
    userAge < 18, // Minor at risk
    riskAssessment.triggerWords.some((word: string) => 
      ['suicide', 'kill myself', 'end my life'].includes(word.toLowerCase())
    )
  ];
  
  return mandatoryTriggers.some(trigger => trigger);
}

/**
 * Assesses legal considerations for intervention
 */
async function assessLegalConsiderations(assessment: CrisisAssessment): Promise<LegalConsiderations> {
  const userDoc = await db.collection('users_standard').doc(userId).get();
  const userData = userDoc.data();
  
  return {
    mandatoryReportingApplies: assessment.mandatoryReportingRequired,
    reportingJurisdiction: userData?.jurisdiction || 'unknown',
    reportingAgency: assessment.mandatoryReportingRequired ? 'Child Protective Services' : undefined,
    reportingDeadline: assessment.mandatoryReportingRequired ? 
      Timestamp.fromDate(new Date(Date.now() + 24 * 60 * 60 * 1000)) : undefined,
    privilegeStatus: assessment.riskLevel === 'IMMINENT' ? 'OVERRIDDEN' : 'PROTECTED',
    consentRequired: assessment.riskLevel !== 'IMMINENT',
    consentObtained: false, // Will be updated during intervention
    legalBasis: 'Duty to warn/protect',
    documentationRequired: true
  };
}

// ===== CRISIS INTERVENTION EXECUTION =====

async function executeImmediateActions(assessment: CrisisAssessment, interventionPlan: any): Promise<any> {
  const results = {
    professionalInvolved: null,
    familyNotified: false,
    emergencyServicesContacted: false,
    safetyPlanCreated: false,
    followUpPlan: '',
    userConsent: false,
    privilegeOverride: false,
    outcome: {
      immediateRiskReduced: false,
      userEngaged: false,
      professionalConnected: false,
      safetyPlanInPlace: false,
      emergencyContactsNotified: false,
      followUpScheduled: false,
      effectivenessRating: 0
    }
  };
  
  // Execute actions based on risk level
  if (assessment.riskLevel === 'IMMINENT') {
    results.emergencyServicesContacted = await contactEmergencyServices(assessment);
    results.familyNotified = await notifyEmergencyContacts(assessment);
    results.privilegeOverride = true;
  } else if (assessment.riskLevel === 'HIGH') {
    results.professionalInvolved = await connectWithProfessional(assessment);
    results.safetyPlanCreated = await createSafetyPlan(assessment);
  }
  
  // Provide crisis resources
  await provideCrisisResources(assessment.userId, interventionPlan.resourcesNeeded);
  
  // Document intervention
  await documentIntervention(assessment, results);
  
  return results;
}

async function contactEmergencyServices(assessment: CrisisAssessment): Promise<boolean> {
  // In a real implementation, this would integrate with emergency services
  console.log(`🚨 Emergency services contacted for user ${assessment.userId}`);
  return true;
}

async function notifyEmergencyContacts(assessment: CrisisAssessment): Promise<boolean> {
  const emergencyContacts = assessment.assessmentDetails.emergencyContacts;
  
  for (const contact of emergencyContacts) {
    if (contact.consentToContact) {
      await sendEmergencyNotification(contact, assessment);
    }
  }
  
  return emergencyContacts.length > 0;
}

async function connectWithProfessional(assessment: CrisisAssessment): Promise<string | null> {
  const providers = assessment.assessmentDetails.healthcareProviders;
  const crisisProvider = providers.find(p => p.type === 'CRISIS_COUNSELOR' && p.emergencyContact);
  
  if (crisisProvider) {
    await notifyHealthcareProvider(crisisProvider, assessment);
    return crisisProvider.providerId;
  }
  
  return null;
}

async function createSafetyPlan(assessment: CrisisAssessment): Promise<boolean> {
  // Create personalized safety plan
  const safetyPlan = {
    userId: assessment.userId,
    triggerRecognition: assessment.riskFactors.map(f => f.factor),
    copingStrategies: assessment.protectiveFactors.reasonsForLiving,
    supportContacts: assessment.assessmentDetails.emergencyContacts,
    professionalContacts: assessment.assessmentDetails.healthcareProviders,
    environmentalSafeguards: ['Remove harmful objects', 'Stay with trusted person'],
    emergencyResources: await getCrisisResources(assessment.userId, 'HIGH'),
    createdAt: FieldValue.serverTimestamp()
  };
  
  await db.collection('safety_plans').doc(assessment.userId).set(safetyPlan);
  
  return true;
}

// ===== HELPER FUNCTIONS =====

function generateAssessmentId(): string {
  return `crisis_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
}

function generateInterventionId(): string {
  return `intervention_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
}

async function getUserProfileForCrisis(userId: string): Promise<any> {
  // Get comprehensive user profile for crisis assessment
  const userDoc = await db.collection('users_standard').doc(userId).get();
  const userData = userDoc.data();
  
  return {
    protectiveFactors: {
      socialSupport: userData?.socialSupport || 5,
      copingSkills: userData?.copingSkills || 5,
      reasonsForLiving: userData?.reasonsForLiving || ['Family', 'Future goals'],
      professionalSupport: userData?.hasTherapist || false,
      safetyPlan: userData?.hasSafetyPlan || false
    },
    emergencyContacts: userData?.emergencyContacts || [],
    healthcareProviders: userData?.healthcareProviders || [],
    supportNetwork: userData?.supportNetwork || [],
    previousInterventions: userData?.previousInterventions || []
  };
}

async function getRecentMoodData(userId: string): Promise<{ averageMood: number }> {
  // Get recent mood data for risk assessment
  const recentEntries = await db.collection('entries').doc(userId).collection('active')
    .orderBy('createdAt', 'desc')
    .limit(7)
    .get();
  
  if (recentEntries.empty) return { averageMood: 5 };
  
  const moods = recentEntries.docs.map(doc => doc.data().moodBefore || 5);
  const averageMood = moods.reduce((sum, mood) => sum + mood, 0) / moods.length;
  
  return { averageMood };
}

async function assessSuicidalIdeation(riskAssessment: any): Promise<SuicidalIdeationAssessment> {
  const criticalWords = riskAssessment.triggerWords || [];
  const hasSuicidalContent = criticalWords.some((word: string) => 
    ['suicide', 'kill myself', 'end my life', 'want to die'].includes(word.toLowerCase())
  );
  
  return {
    present: hasSuicidalContent,
    intensity: hasSuicidalContent ? 'ACTIVE' : 'NONE',
    method: '',
    timeline: '',
    deterrents: [],
    previousAttempts: false
  };
}

async function assessSelfHarmRisk(riskAssessment: any): Promise<SelfHarmRiskAssessment> {
  const triggerWords = riskAssessment.triggerWords || [];
  const hasSelfHarmContent = triggerWords.some((word: string) => 
    ['cut myself', 'hurt myself', 'self-harm'].includes(word.toLowerCase())
  );
  
  return {
    present: hasSelfHarmContent,
    type: 'CUTTING',
    frequency: 'OCCASIONAL',
    escalating: false,
    medicalAttention: false
  };
}

async function encryptSensitiveContent(entryId: string): Promise<string> {
  // Encrypt sensitive content for audit trail
  return `encrypted_${entryId}`;
}

async function getCrisisResources(userId: string, riskLevel: string): Promise<CrisisResource[]> {
  // Get appropriate crisis resources based on risk level and user profile
  return [
    {
      resourceId: 'suicide_prevention_lifeline',
      name: 'National Suicide Prevention Lifeline',
      type: 'HOTLINE',
      description: '24/7 crisis support for people in suicidal crisis',
      contactInfo: '988',
      availability: '24_7',
      cost: 'FREE',
      specializations: ['Suicide Prevention', 'Crisis Counseling'],
      culturallySpecific: false
    },
    {
      resourceId: 'crisis_text_line',
      name: 'Crisis Text Line',
      type: 'HOTLINE',
      description: 'Text-based crisis support',
      contactInfo: 'Text HOME to 741741',
      availability: '24_7',
      cost: 'FREE',
      specializations: ['Crisis Counseling', 'Youth Support'],
      culturallySpecific: false
    }
  ];
}

function getInterventionApproach(riskLevel: string): string {
  switch (riskLevel) {
    case 'IMMINENT': return 'Emergency intervention with immediate safety measures';
    case 'HIGH': return 'Professional crisis counseling with safety planning';
    case 'MEDIUM': return 'Supportive intervention with resource provision';
    default: return 'Monitoring and resource provision';
  }
}

async function provideCrisisResources(userId: string, resources: CrisisResource[]): Promise<void> {
  // Provide crisis resources to user
  for (const resource of resources) {
    await db.collection('user_crisis_resources').doc(`${userId}_${resource.resourceId}`).set({
      userId,
      resource,
      providedAt: FieldValue.serverTimestamp(),
      accessed: false
    });
  }
}

async function documentIntervention(assessment: CrisisAssessment, results: any): Promise<void> {
  // Document intervention for legal and clinical purposes
  await db.collection('intervention_documentation').doc(assessment.assessmentId).set({
    assessmentId: assessment.assessmentId,
    userId: assessment.userId,
    interventionResults: results,
    documentedAt: FieldValue.serverTimestamp(),
    legalCompliance: 'DOCUMENTED'
  });
}

async function scheduleFollowUp(intervention: CrisisIntervention): Promise<void> {
  // Schedule follow-up intervention
  await db.collection('scheduled_followups').doc(intervention.interventionId).set({
    interventionId: intervention.interventionId,
    userId: intervention.userId,
    scheduledFor: intervention.followUpScheduled,
    type: 'CRISIS_FOLLOWUP',
    status: 'SCHEDULED'
  });
}

async function sendEmergencyNotification(contact: EmergencyContact, assessment: CrisisAssessment): Promise<void> {
  // Send emergency notification (would integrate with notification service)
  console.log(`📞 Emergency notification sent to ${contact.name} for user ${assessment.userId}`);
}

async function notifyHealthcareProvider(provider: HealthcareProvider, assessment: CrisisAssessment): Promise<void> {
  // Notify healthcare provider (would integrate with secure messaging)
  console.log(`👨‍⚕️ Healthcare provider ${provider.name} notified for user ${assessment.userId}`);
}

async function triggerFailsafeCrisisResponse(userId: string, entryId: string): Promise<void> {
  // Fail-safe crisis response when system error occurs
  console.log(`🚨 Fail-safe crisis response triggered for user ${userId}`);
  
  // Provide basic crisis resources
  const basicResources = await getCrisisResources(userId, 'MEDIUM');
  await provideCrisisResources(userId, basicResources);
}

async function logCrisisEvent(assessment: CrisisAssessment, interventionPlan: any): Promise<void> {
  // Log crisis event for audit and analysis
  await db.collection('crisis_event_logs').doc(assessment.assessmentId).set({
    assessmentId: assessment.assessmentId,
    userId: assessment.userId,
    riskLevel: assessment.riskLevel,
    interventionPlan,
    timestamp: FieldValue.serverTimestamp(),
    complianceStatus: 'DOCUMENTED'
  });
}

/**
 * Crisis intervention follow-up system
 */
export const crisisFollowUp = functions
  .runWith({ memory: '256MB' })
  .pubsub.schedule('every 4 hours')
  .onRun(async (context) => {
    const now = new Date();
    
    // Get scheduled follow-ups
    const followUpsQuery = db.collection('scheduled_followups')
      .where('scheduledFor', '<=', Timestamp.fromDate(now))
      .where('status', '==', 'SCHEDULED');
    
    const followUps = await followUpsQuery.get();
    
    for (const followUpDoc of followUps.docs) {
      const followUp = followUpDoc.data();
      
      try {
        await executeFollowUp(followUp);
        
        // Mark as completed
        await followUpDoc.ref.update({
          status: 'COMPLETED',
          completedAt: FieldValue.serverTimestamp()
        });
        
      } catch (error) {
        console.error('Error executing follow-up:', error);
        
        // Mark as failed and reschedule
        await followUpDoc.ref.update({
          status: 'FAILED',
          failedAt: FieldValue.serverTimestamp(),
          rescheduledFor: Timestamp.fromDate(new Date(now.getTime() + 4 * 60 * 60 * 1000))
        });
      }
    }
    
    return { processed: followUps.size };
  });

async function executeFollowUp(followUp: any): Promise<void> {
  // Execute crisis follow-up based on type
  switch (followUp.type) {
    case 'CRISIS_FOLLOWUP':
      await executeCrisisFollowUp(followUp);
      break;
    default:
      console.log('Unknown follow-up type:', followUp.type);
  }
}

async function executeCrisisFollowUp(followUp: any): Promise<void> {
  // Check user status and provide continued support
  const userStatus = await checkUserWellness(followUp.userId);
  
  if (userStatus.needsIntervention) {
    // Escalate if needed
    await escalateCrisisIntervention(followUp.userId, userStatus);
  } else {
    // Provide continued support resources
    await provideContinuedSupport(followUp.userId);
  }
}

async function checkUserWellness(userId: string): Promise<{ needsIntervention: boolean }> {
  // Check user wellness indicators
  return { needsIntervention: false };
}

async function escalateCrisisIntervention(userId: string, status: any): Promise<void> {
  // Escalate crisis intervention if needed
  console.log(`⚠️ Escalating crisis intervention for user ${userId}`);
}

async function provideContinuedSupport(userId: string): Promise<void> {
  // Provide continued support resources
  console.log(`💙 Providing continued support for user ${userId}`);
}