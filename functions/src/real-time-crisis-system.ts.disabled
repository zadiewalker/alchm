async function getEmergencyContacts(location: string): Promise<any[]> {
  return [
    { name: 'National Suicide Prevention Lifeline', number: '988' },
    { name: 'Crisis Text Line', number: 'Text HOME to 741741' }
  ];
}

function getImmediateActions(urgency: string): string[] {
  return ['Call 988', 'Reach out to trusted person', 'Go to safe space'];
}

async function getBasicCrisisResources(): Promise<any[]> {
  return [
    {
      name: 'National Suicide Prevention Lifeline',
      number: '988',
      description: '24/7 crisis support'
    }
  ];
}