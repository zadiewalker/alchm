// ALCHM Real-Time Crisis Detection and Professional Alert System
// Enterprise-grade mental health crisis intervention with <1 second response times
// Firebase Studio Advanced Architecture

import * as functions from 'firebase-functions/v2';
import * as admin from 'firebase-admin';
import { getFirestore, FieldValue, Timestamp } from 'firebase-admin/firestore';
import { getAuth } from 'firebase-admin/auth';
import { PubSub } from '@google-cloud/pubsub';
import { GoogleGenerativeAI } from "@google/generative-ai";

// Initialize services
const db = getFirestore();
const auth = getAuth();
const pubsub = new PubSub();

// Initialize AI with advanced safety configurations
const gemini = new GoogleGenerativeAI(process.env.GEMINI_API_KEY || '');

// ===== INTERFACES =====

interface CrisisAlert {
  id: string;
  userId: string;
  triggerType: 'keyword' | 'pattern' | 'ai_assessment' | 'user_request';
  severity: 'low' | 'moderate' | 'high' | 'critical';
  confidence: number; // 0-1
  content: string;
  metadata: {
    timestamp: admin.firestore.Timestamp;
    userTier: string;
    location?: string;
    deviceInfo?: string;
    sessionDuration: number;
  };
  professionalAlerted: boolean;
  responseRequired: boolean;
}

interface ProfessionalResponse {
  alertId: string;
  professionalId: string;
  responseTime: number; // milliseconds
  interventionType: 'assessment' | 'resources' | 'escalation' | 'followup';
  notes: string;
  outcome: 'resolved' | 'ongoing' | 'escalated';
  timestamp: admin.firestore.Timestamp;
}

interface RealTimeSession {
  userId: string;
  sessionId: string;
  startTime: admin.firestore.Timestamp;
  lastActivity: admin.firestore.Timestamp;
  riskLevel: 'low' | 'moderate' | 'high' | 'critical';
  interventionsTriggered: string[];
  professionalEngaged: boolean;
  active: boolean;
}

// ===== REAL-TIME CRISIS MONITORING =====

export const realTimeCrisisMonitor = functions.firestore.onDocumentWritten({
  document: 'entries/{userId}/active/{entryId}',
  region: 'us-central1',
  memory: '1GiB',
  timeoutSeconds: 30,
  maxInstances: 200,
  concurrency: 20
}, async (event) => {
  const { userId, entryId } = event.params;
  const before = event.data?.before?.data();
  const after = event.data?.after?.data();
  
  // Skip if document was deleted
  if (!after) return;
  
  const startTime = Date.now();
  
  try {
    console.log(`[Real-Time Monitor] Processing entry ${entryId} for user ${userId}`);
    
    // Stage 1: Immediate crisis keyword detection (<100ms)
    const immediateRisk = await detectImmediateCrisisKeywords(after.text, userId);
    
    if (immediateRisk.critical) {
      // IMMEDIATE ALERT - No AI processing delay
      await triggerImmediateCrisisAlert(userId, entryId, immediateRisk);
      console.log(`[CRITICAL ALERT] Immediate crisis detected for user ${userId}`);
    }
    
    // Stage 2: Start real-time session tracking
    await updateRealTimeSession(userId, immediateRisk.riskLevel);
    
    // Stage 3: Parallel processing for comprehensive analysis
    const [
      aiAnalysis,
      patternAnalysis,
      userContext
    ] = await Promise.all([
      performAIRiskAnalysis(after.text, userId),
      analyzeUserPatterns(userId),
      getUserContextForCrisis(userId)
    ]);
    
    // Stage 4: Combine analyses for final risk assessment
    const finalRiskAssessment = combineRiskAnalyses(
      immediateRisk, 
      aiAnalysis, 
      patternAnalysis, 
      userContext
    );
    
    // Stage 5: Trigger appropriate interventions
    if (finalRiskAssessment.severity === 'high' || finalRiskAssessment.severity === 'critical') {
      await triggerProfessionalIntervention(userId, entryId, finalRiskAssessment);
    } else if (finalRiskAssessment.severity === 'moderate') {
      await triggerAutomatedSupport(userId, finalRiskAssessment);
    }
    
    // Stage 6: Store assessment and update user profile
    await Promise.all([
      storeCrisisAssessment(userId, entryId, finalRiskAssessment),
      updateUserRiskProfile(userId, finalRiskAssessment),
      logPerformanceMetrics(userId, Date.now() - startTime, finalRiskAssessment.severity)
    ]);
    
    console.log(`[Real-Time Monitor] Completed in ${Date.now() - startTime}ms for user ${userId}`);
    
  } catch (error) {
    console.error('[Real-Time Monitor] Error:', error);
    
    // Emergency fallback
    await triggerEmergencyFallback(userId, entryId, after.text);
  }
});

// ===== IMMEDIATE CRISIS DETECTION =====

async function detectImmediateCrisisKeywords(text: string, userId: string): Promise<any> {
  const lowerText = text.toLowerCase();
  
  // Immediate crisis indicators requiring instant response
  const criticalKeywords = [
    'suicide plan', 'kill myself tonight', 'end my life today', 
    'taking pills', 'jumping off', 'hanging myself',
    'goodbye everyone', 'final message', 'can\'t take anymore'
  ];
  
  // High urgency keywords
  const highUrgencyKeywords = [
    'suicide', 'want to die', 'kill myself', 'end it all',
    'no point living', 'better off dead', 'can\'t go on'
  ];
  
  // Pattern analysis for crisis indicators
  const hasGoodbyeTheme = lowerText.includes('goodbye') && text.length > 500;
  const hasFinality = /\b(final|last|ending|over|done)\b/gi.test(text);
  const hasIsolation = /\b(alone|nobody|abandoned|worthless)\b/gi.test(text);
  
  let riskLevel = 'low';
  let critical = false;
  let confidence = 0;
  let triggers: string[] = [];
  
  // Check critical keywords
  for (const keyword of criticalKeywords) {
    if (lowerText.includes(keyword)) {
      critical = true;
      riskLevel = 'critical';
      confidence = 0.95;
      triggers.push(`Critical keyword: ${keyword}`);
      break;
    }
  }
  
  // Check high urgency if not already critical
  if (!critical) {
    for (const keyword of highUrgencyKeywords) {
      if (lowerText.includes(keyword)) {
        riskLevel = 'high';
        confidence = Math.max(confidence, 0.8);
        triggers.push(`High urgency: ${keyword}`);
      }
    }
  }
  
  // Pattern-based escalation
  if (hasGoodbyeTheme) {
    confidence += 0.3;
    triggers.push('Long goodbye message detected');
  }
  
  if (hasFinality && hasIsolation) {
    confidence += 0.2;
    triggers.push('Finality and isolation patterns');
  }
  
  // Adjust confidence based on user history
  const userHistory = await getUserCrisisHistory(userId);
  if (userHistory.previousCrisisEvents > 0) {
    confidence += 0.1;
    triggers.push('User has crisis history');
  }
  
  return {
    riskLevel,
    critical,
    confidence: Math.min(confidence, 1.0),
    triggers,
    timestamp: Date.now()
  };
}

// ===== PROFESSIONAL ALERT SYSTEM =====

export const professionalAlertSystem = functions.pubsub.topic('crisis-intervention').onMessagePublished({
  region: 'us-central1',
  memory: '512MiB',
  timeoutSeconds: 60,
  maxInstances: 50
}, async (event) => {
  const messageData = event.data.message.data;
  const alertData = JSON.parse(Buffer.from(messageData, 'base64').toString());
  
  try {
    console.log(`[Professional Alert] Processing alert ${alertData.alertId}`);
    
    // Find available crisis professionals
    const availableProfessionals = await findAvailableCrisisProfessionals(
      alertData.severity,
      alertData.location
    );
    
    if (availableProfessionals.length === 0) {
      // Escalate to backup team
      await escalateToBackupTeam(alertData);
      return;
    }
    
    // Assign to most appropriate professional
    const assignedProfessional = selectBestProfessional(availableProfessionals, alertData);
    
    // Create professional alert
    const professionalAlert = {
      id: `prof_${Date.now()}_${alertData.userId}`,
      alertId: alertData.alertId,
      userId: alertData.userId,
      assignedProfessional: assignedProfessional.id,
      severity: alertData.severity,
      assignedAt: FieldValue.serverTimestamp(),
      status: 'assigned',
      responseDeadline: new Date(Date.now() + (alertData.severity === 'critical' ? 60000 : 300000)), // 1-5 min
      metadata: alertData
    };
    
    await db.collection('professional_alerts').doc(professionalAlert.id).set(professionalAlert);
    
    // Notify professional immediately
    await Promise.all([
      notifyProfessionalEmail(assignedProfessional, professionalAlert),
      notifyProfessionalSMS(assignedProfessional, professionalAlert),
      notifyProfessionalPush(assignedProfessional, professionalAlert)
    ]);
    
    // Set up response monitoring
    await scheduleResponseMonitoring(professionalAlert);
    
    console.log(`[Professional Alert] Assigned to ${assignedProfessional.id}`);
    
  } catch (error) {
    console.error('[Professional Alert] Error:', error);
    
    // Emergency escalation
    await emergencyEscalation(alertData);
  }
});

// ===== REAL-TIME SESSION MANAGEMENT =====

export const sessionManager = functions.firestore.onDocumentWritten({
  document: 'real_time_sessions/{sessionId}',
  region: 'us-central1',
  memory: '256MiB',
  timeoutSeconds: 30,
  maxInstances: 100
}, async (event) => {
  const sessionData = event.data?.after?.data();
  
  if (!sessionData || !sessionData.active) return;
  
  try {
    const session = sessionData as RealTimeSession;
    
    // Check for session timeout (5 minutes of inactivity)
    const now = Date.now();
    const lastActivity = session.lastActivity.toMillis();
    const inactiveTime = now - lastActivity;
    
    if (inactiveTime > 300000) { // 5 minutes
      await handleSessionTimeout(session);
      return;
    }
    
    // Check for risk escalation
    if (session.riskLevel === 'critical' && !session.professionalEngaged) {
      await escalateToImmediate(session);
    }
    
    // Update session analytics
    await updateSessionAnalytics(session);
    
  } catch (error) {
    console.error('[Session Manager] Error:', error);
  }
});

// ===== PROFESSIONAL RESPONSE MONITORING =====

export const responseMonitor = functions.pubsub.schedule('every 1 minutes')
  .timeZone('UTC')
  .onRun(async (context) => {
    try {
      const now = Date.now();
      
      // Check for overdue professional responses
      const overdueAlerts = await db.collection('professional_alerts')
        .where('status', '==', 'assigned')
        .where('responseDeadline', '<', new Date(now))
        .get();
      
      console.log(`[Response Monitor] Found ${overdueAlerts.size} overdue alerts`);
      
      for (const alertDoc of overdueAlerts.docs) {
        const alert = alertDoc.data();
        
        // Escalate based on severity and time overdue
        if (alert.severity === 'critical') {
          await escalateCriticalAlert(alert);
        } else if (alert.severity === 'high') {
          await escalateHighAlert(alert);
        }
        
        // Update alert status
        await alertDoc.ref.update({
          status: 'overdue',
          escalatedAt: FieldValue.serverTimestamp()
        });
      }
      
      // Monitor active crisis sessions
      await monitorActiveCrisisSessions();
      
      // Update system health metrics
      await updateCrisisSystemHealth(overdueAlerts.size);
      
    } catch (error) {
      console.error('[Response Monitor] Error:', error);
    }
  });

// ===== CRISIS RESOURCE DELIVERY =====

export const crisisResourceDelivery = functions.https.onCall({
  region: 'us-central1',
  memory: '512MiB',
  timeoutSeconds: 30,
  maxInstances: 100
}, async (request) => {
  const { userId, location, urgency, language } = request.data;
  
  try {
    // Get user context for personalized resources
    const userContext = await getUserContextForCrisis(userId);
    
    // Get location-specific crisis resources
    const localResources = await getCrisisResourcesByLocation(location, language);
    
    // Get personalized resources based on user tier and history
    const personalizedResources = await getPersonalizedCrisisResources(userContext);
    
    // Combine and prioritize resources
    const prioritizedResources = prioritizeResources(
      localResources,
      personalizedResources,
      urgency
    );
    
    // Log resource delivery for analytics
    await logResourceDelivery(userId, prioritizedResources, urgency);
    
    return {
      success: true,
      resources: prioritizedResources,
      emergencyContacts: await getEmergencyContacts(location),
      immediateActions: getImmediateActions(urgency)
    };
    
  } catch (error) {
    console.error('[Crisis Resource Delivery] Error:', error);
    
    // Return basic crisis resources as fallback
    return {
      success: false,
      resources: await getBasicCrisisResources(),
      emergencyContacts: [
        { name: 'National Suicide Prevention Lifeline', number: '988' },
        { name: 'Crisis Text Line', number: 'Text HOME to 741741' }
      ],
      immediateActions: ['Call 988', 'Go to nearest emergency room', 'Call 911']
    };
  }
});

// ===== HELPER FUNCTIONS =====

async function triggerImmediateCrisisAlert(
  userId: string, 
  entryId: string, 
  riskData: any
): Promise<void> {
  const alertId = `immediate_${Date.now()}_${userId}`;
  
  const crisisAlert: CrisisAlert = {
    id: alertId,
    userId,
    triggerType: 'keyword',
    severity: 'critical',
    confidence: riskData.confidence,
    content: `Immediate crisis detected: ${riskData.triggers.join(', ')}`,
    metadata: {
      timestamp: Timestamp.now(),
      userTier: 'unknown', // Will be updated
      sessionDuration: 0
    },
    professionalAlerted: false,
    responseRequired: true
  };
  
  // Store crisis alert
  await db.collection('crisis_alerts').doc(alertId).set(crisisAlert);
  
  // Publish to crisis intervention topic
  await pubsub.topic('crisis-intervention').publishMessage({
    data: Buffer.from(JSON.stringify({
      alertId,
      userId,
      severity: 'critical',
      confidence: riskData.confidence,
      triggers: riskData.triggers,
      timestamp: new Date().toISOString()
    }))
  });
  
  // Update crisis alert with professional notification
  await db.collection('crisis_alerts').doc(alertId).update({
    professionalAlerted: true,
    alertSentAt: FieldValue.serverTimestamp()
  });
}

async function updateRealTimeSession(userId: string, riskLevel: string): Promise<void> {
  const sessionId = `session_${userId}_${Date.now()}`;
  
  const session: RealTimeSession = {
    userId,
    sessionId,
    startTime: Timestamp.now(),
    lastActivity: Timestamp.now(),
    riskLevel: riskLevel as 'low' | 'moderate' | 'high' | 'critical',
    interventionsTriggered: [],
    professionalEngaged: false,
    active: true
  };
  
  await db.collection('real_time_sessions').doc(sessionId).set(session);
}

async function performAIRiskAnalysis(text: string, userId: string): Promise<any> {
  try {
    const model = gemini.getGenerativeModel({ 
      model: "gemini-pro",
      safetySettings: [
        {
          category: "HARM_CATEGORY_DANGEROUS_CONTENT",
          threshold: "BLOCK_NONE"
        }
      ]
    });
    
    const prompt = `Analyze this journal entry for mental health crisis indicators. 
    Focus on: suicide ideation, self-harm, hopelessness, isolation, substance abuse.
    
    Entry: "${text}"
    
    Respond with JSON only:
    {
      "riskLevel": "low|moderate|high|critical",
      "confidence": 0.0-1.0,
      "indicators": ["specific indicators found"],
      "immediateActions": ["recommended actions"],
      "reasoning": "brief explanation"
    }`;
    
    const result = await model.generateContent(prompt);
    const response = await result.response;
    const analysis = JSON.parse(response.text());
    
    return {
      riskLevel: analysis.riskLevel || 'low',
      confidence: analysis.confidence || 0.5,
      indicators: analysis.indicators || [],
      immediateActions: analysis.immediateActions || [],
      reasoning: analysis.reasoning || ''
    };
    
  } catch (error) {
    console.error('AI Risk Analysis Error:', error);
    
    // Fallback analysis
    return {
      riskLevel: 'moderate',
      confidence: 0.3,
      indicators: ['AI analysis unavailable'],
      immediateActions: ['Encourage professional support'],
      reasoning: 'Fallback due to AI error'
    };
  }
}

async function analyzeUserPatterns(userId: string): Promise<any> {
  try {
    // Get recent entries for pattern analysis
    const recentEntries = await db.collection('entries').doc(userId)
      .collection('active')
      .orderBy('createdAt', 'desc')
      .limit(10)
      .get();
    
    if (recentEntries.empty) {
      return { patterns: [], riskTrend: 'unknown' };
    }
    
    const entries = recentEntries.docs.map(doc => doc.data());
    
    // Analyze mood trends
    const moodTrend = analyzeMoodTrend(entries);
    
    // Analyze frequency patterns
    const frequencyPattern = analyzeFrequencyPattern(entries);
    
    // Analyze content patterns
    const contentPatterns = analyzeContentPatterns(entries);
    
    return {
      patterns: contentPatterns,
      moodTrend,
      frequencyPattern,
      riskTrend: calculateRiskTrend(moodTrend, frequencyPattern, contentPatterns)
    };
    
  } catch (error) {
    console.error('Pattern Analysis Error:', error);
    return { patterns: [], riskTrend: 'unknown' };
  }
}

async function getUserContextForCrisis(userId: string): Promise<any> {
  try {
    // Get user profile
    const userDoc = await db.collection('users_premium').doc(userId).get()
      .catch(() => db.collection('users_standard').doc(userId).get());
    
    if (!userDoc.exists) {
      return { tier: 'free', hasSupport: false, riskHistory: [] };
    }
    
    const userData = userDoc.data()!;
    
    // Get crisis history
    const crisisHistory = await db.collection('crisis_assessments')
      .where('userId', '==', userId)
      .orderBy('processedAt', 'desc')
      .limit(5)
      .get();
    
    return {
      tier: userData.tier || 'free',
      hasSupport: userData.hasSupport || false,
      riskHistory: crisisHistory.docs.map(doc => doc.data().riskLevel),
      communicationStyle: userData.communicationStyle || 'gentle',
      professionalCare: userData.inProfessionalCare || false,
      location: userData.location || 'unknown'
    };
    
  } catch (error) {
    console.error('User Context Error:', error);
    return { tier: 'free', hasSupport: false, riskHistory: [] };
  }
}

function combineRiskAnalyses(
  immediateRisk: any,
  aiAnalysis: any,
  patternAnalysis: any,
  userContext: any
): any {
  // Weight different analysis components
  const weights = {
    immediate: 0.4,
    ai: 0.3,
    patterns: 0.2,
    context: 0.1
  };
  
  // Convert risk levels to numeric values
  const riskValues = { low: 1, moderate: 2, high: 3, critical: 4 };
  
  const immediateValue = riskValues[immediateRisk.riskLevel as keyof typeof riskValues] || 1;
  const aiValue = riskValues[aiAnalysis.riskLevel as keyof typeof riskValues] || 1;
  const patternValue = getPatternRiskValue(patternAnalysis.riskTrend);
  const contextValue = getContextRiskValue(userContext);
  
  // Calculate weighted risk score
  const weightedScore = 
    (immediateValue * weights.immediate) +
    (aiValue * weights.ai) +
    (patternValue * weights.patterns) +
    (contextValue * weights.context);
  
  // Convert back to risk level
  let finalRiskLevel = 'low';
  if (weightedScore >= 3.5) finalRiskLevel = 'critical';
  else if (weightedScore >= 2.5) finalRiskLevel = 'high';
  else if (weightedScore >= 1.5) finalRiskLevel = 'moderate';
  
  // Combine confidence scores
  const combinedConfidence = Math.min(
    (immediateRisk.confidence + aiAnalysis.confidence) / 2,
    1.0
  );
  
  return {
    severity: finalRiskLevel,
    confidence: combinedConfidence,
    triggers: [
      ...immediateRisk.triggers,
      ...aiAnalysis.indicators
    ],
    immediateActions: [
      ...immediateRisk.triggers.length > 0 ? ['Immediate professional intervention'] : [],
      ...aiAnalysis.immediateActions
    ],
    analysis: {
      immediate: immediateRisk,
      ai: aiAnalysis,
      patterns: patternAnalysis,
      context: userContext
    }
  };
}

