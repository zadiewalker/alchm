async function storeCrisisAssessment(userId: string, entryId: string, assessment: any): Promise<void> {
  await db.collection('crisis_assessments').doc(`${userId}_${entryId}`).set({
    ...assessment,
    userId,
    entryId,
    processedAt: FieldValue.serverTimestamp()
  });
}

async function updateUserRiskProfile(userId: string, assessment: any): Promise<void> {
  const userRef = db.collection('users_premium').doc(userId);
  await userRef.update({
    lastRiskAssessment: assessment.severity,
    lastAssessmentDate: FieldValue.serverTimestamp(),
    riskHistory: FieldValue.arrayUnion(assessment.severity)
  }).catch(async () => {
    // Try standard users collection
    const standardRef = db.collection('users_standard').doc(userId);
    await standardRef.update({
      lastRiskAssessment: assessment.severity,
      lastAssessmentDate: FieldValue.serverTimestamp(),
      riskHistory: FieldValue.arrayUnion(assessment.severity)
    });
  });
}

async function logPerformanceMetrics(userId: string, processingTime: number, severity: string): Promise<void> {
  await db.collection('performance_metrics').add({
    userId,
    processingTime,
    severity,
    timestamp: FieldValue.serverTimestamp(),
    component: 'real_time_crisis_detection'
  });
}

async function triggerEmergencyFallback(userId: string, entryId: string, text: string): Promise<void> {
  console.error(`[Emergency Fallback] Triggered for user ${userId}`);
  
  // Create emergency alert
  await db.collection('crisis_alerts').add({
    userId,
    entryId,
    severity: 'high', // Conservative fallback
    triggerType: 'emergency_fallback',
    content: 'System error during crisis detection',
    createdAt: FieldValue.serverTimestamp(),
    professionalAlerted: false,
    responseRequired: true
  });
}

