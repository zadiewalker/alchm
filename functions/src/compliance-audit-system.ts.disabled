async function checkGDPRConsent(userId: string, purpose: string): Promise<boolean> {
  const consentDoc = await db.collection('gdpr_consent_records').doc(`${userId}_latest`).get();
  if (!consentDoc.exists) return false;
  
  const data = consentDoc.data()!;
  return data.purposes?.includes(purpose) === true;
}

