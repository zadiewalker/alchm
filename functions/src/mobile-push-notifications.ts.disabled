// ===== BACKUP SYSTEMS =====
async function triggerBackupNotificationSystem(alertId: string, alert: CrisisAlert): Promise<void> {
  console.log(`🔄 Triggering backup notification systems for alert ${alertId}`);
  
  // Trigger SMS backup
  await admin.firestore()
    .collection('crisis_sms_queue')
    .add({
      alertId,
      alertData: alert,
      priority: 'backup_system',
      createdAt: Timestamp.now()
    });
  
  // Trigger email backup
  await admin.firestore()
    .collection('crisis_email_queue')
    .add({
      alertId,
      alertData: alert,
      priority: 'backup_system',
      createdAt: Timestamp.now()
    });
}

async function triggerEmergencyProtocol(alertId: string, alert: CrisisAlert): Promise<void> {
  console.log(`🚨 EMERGENCY PROTOCOL ACTIVATED for alert ${alertId}`);
  
  // Log emergency protocol activation
  await admin.firestore()
    .collection('emergency_protocol_logs')
    .add({
      alertId,
      riskLevel: alert.riskLevel,
      reason: 'escalation_system_failure',
      timestamp: Timestamp.now(),
      participantId: alert.participantId
    });
  
  // Notify system administrators immediately
  await admin.firestore()
    .collection('system_admin_alerts')
    .add({
      type: 'emergency_protocol_activation',
      alertId,
      severity: 'critical',
      message: `Emergency protocol activated for crisis alert ${alertId} - Risk level: ${alert.riskLevel}`,
      timestamp: Timestamp.now()
    });
}

// ===== UTILITY FUNCTIONS =====
async function logNotificationError(alertId: string, error: any): Promise<void> {
  await admin.firestore()
    .collection('crisis_system_errors')
    .add({
      alertId,
      errorType: 'push_notification_failure',
      error: error.message,
      stack: error.stack,
      timestamp: Timestamp.now()
    });
}

// ===== FCM TOKEN MANAGEMENT =====
export const updateProfessionalFCMToken = functions
  .runWith({ memory: '256MB', timeoutSeconds: 30 })
  .https.onCall(async (data, context) => {
    try {
      const { professionalId, fcmToken } = data;
      
      // Validate professional authentication
      if (!context.auth) {
        throw new functions.https.HttpsError('unauthenticated', 'Professional must be authenticated');
      }
      
      // Update FCM token
      await admin.firestore()
        .collection('crisis_professionals')
        .doc(professionalId)
        .update({
          'contactMethods.fcmToken': fcmToken,
          lastFCMUpdate: Timestamp.now(),
          updatedBy: context.auth.uid
        });
      
      console.log(`📱 FCM token updated for professional ${professionalId}`);
      
      return { success: true, message: 'FCM token updated successfully' };
      
    } catch (error) {
      console.error('Failed to update FCM token:', error);
      throw new functions.https.HttpsError('internal', 'Failed to update FCM token');
    }
  });