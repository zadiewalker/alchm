/**
 * Generate competitive intelligence report
 */
async function generateCompetitiveReport(type: string, startDate: Date, endDate: Date): Promise<any> {
  try {
    // Gather data for report
    const alertsSnapshot = await db.collection('competitive_intelligence_alerts')
      .where('detectedAt', '>=', startDate)
      .where('detectedAt', '<=', endDate)
      .get();
    
    const opportunitiesSnapshot = await db.collection('competitive_intelligence_opportunities')
      .where('identifiedDate', '>=', startDate)
      .where('identifiedDate', '<=', endDate)
      .get();
    
    const alerts = alertsSnapshot.docs.map(doc => doc.data());
    const opportunities = opportunitiesSnapshot.docs.map(doc => doc.data());
    
    // Generate report
    const report = {
      type,
      title: `Competitive Intelligence ${type.replace('-', ' ')} - ${formatDateRange(startDate, endDate)}`,
      startDate,
      endDate,
      generatedAt: new Date(),
      generatedBy: 'automated',
      
      executiveSummary: generateExecutiveSummary(alerts, opportunities),
      keyFindings: generateKeyFindings(alerts, opportunities),
      recommendations: generateRecommendations(alerts, opportunities),
      
      alertsSummary: {
        total: alerts.length,
        critical: alerts.filter(a => a.severity === 'critical').length,
        high: alerts.filter(a => a.severity === 'high').length,
        trends: identifyAlertTrends(alerts)
      },
      
      opportunitiesSummary: {
        total: opportunities.length,
        highPriority: opportunities.filter(o => o.priority === 'high').length,
        estimatedValue: calculateOpportunityValue(opportunities)
      },
      
      confidenceLevel: 0.85,
      dataQualityScore: 0.9
    };
    
    return report;
  } catch (error) {
    logger.error('Error generating report:', error);
    throw error;
  }
}

/**
 * Rate limiting enforcement
 */
async function respectRateLimit(serviceId: string): Promise<void> {
  const now = Date.now();
  const rateLimitInfo = rateLimits.get(serviceId);
  
  if (!rateLimitInfo || now > rateLimitInfo.resetTime) {
    // Reset rate limit
    rateLimits.set(serviceId, {
      requests: 1,
      resetTime: now + 60000, // 1 minute
      lastRequest: now
    });
    return;
  }
  
  // Check if we're within limits
  const requestsPerMinute = 60; // Conservative limit
  if (rateLimitInfo.requests >= requestsPerMinute) {
    const waitTime = rateLimitInfo.resetTime - now;
    logger.info(`Rate limit reached for ${serviceId}, waiting ${waitTime}ms`);
    await new Promise(resolve => setTimeout(resolve, waitTime));
    
    // Reset after waiting
    rateLimits.set(serviceId, {
      requests: 1,
      resetTime: now + 60000,
      lastRequest: now
    });
  } else {
    // Increment counter
    rateLimitInfo.requests++;
    rateLimitInfo.lastRequest = now;
  }
}

/**
 * Alert checking functions
 */
async function checkForRankingAlerts(competitorId: string, metrics: any): Promise<void> {
  // Get previous metrics to compare
  const previousMetricsSnapshot = await db.collection('competitive_intelligence_app_metrics')
    .where('competitorId', '==', competitorId)
    .where('platform', '==', metrics.platform)
    .orderBy('date', 'desc')
    .limit(2)
    .get();
  
  if (previousMetricsSnapshot.docs.length >= 2) {
    const previousMetrics = previousMetricsSnapshot.docs[1].data();
    const rankingChange = previousMetrics.categoryRank - metrics.categoryRank;
    
    // Alert if significant ranking change
    if (Math.abs(rankingChange) >= 5) {
      await createRankingAlert(competitorId, metrics, previousMetrics, rankingChange);
    }
  }
}

async function checkForSentimentAlerts(competitorId: string, analysis: any): Promise<void> {
  // Check for significant sentiment shifts
  if (analysis.sentimentScore < -0.5) {
    await createSentimentAlert(competitorId, analysis, 'negative_trend');
  }
}

