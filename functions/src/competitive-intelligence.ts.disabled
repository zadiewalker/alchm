// ==================== UTILITY FUNCTIONS ====================

function extractTopicsFromText(text: string): any[] {
  const topics = ['performance', 'usability', 'features', 'support', 'pricing'];
  return topics.filter(topic => 
    text.toLowerCase().includes(topic)
  ).map(topic => ({
    topic,
    relevanceScore: Math.random(),
    mentions: 1
  }));
}

function extractFeaturesFromText(text: string): string[] {
  const features = ['AI', 'chat', 'journal', 'export', 'sync'];
  return features.filter(feature => 
    text.toLowerCase().includes(feature.toLowerCase())
  );
}

function extractIssuesFromText(text: string): string[] {
  const issues = ['bug', 'crash', 'slow', 'error'];
  return issues.filter(issue => 
    text.toLowerCase().includes(issue)
  );
}

function generateInsights(content: string, sentimentScore: number): string[] {
  const insights = [];
  
  if (sentimentScore > 0.5) {
    insights.push('User highly satisfied with experience');
  } else if (sentimentScore < -0.5) {
    insights.push('User expressing significant dissatisfaction');
  }
  
  if (content.toLowerCase().includes('ai')) {
    insights.push('AI features mentioned in review');
  }
  
  return insights;
}

function formatDateRange(startDate: Date, endDate: Date): string {
  return `${startDate.toLocaleDateString()} - ${endDate.toLocaleDateString()}`;
}

function generateExecutiveSummary(alerts: any[], opportunities: any[]): string {
  return `During this period, ${alerts.length} alerts were generated and ${opportunities.length} opportunities were identified. Key focus areas include competitive positioning and market gap analysis.`;
}

function generateKeyFindings(alerts: any[], opportunities: any[]): string[] {
  return [
    `${alerts.filter(a => a.severity === 'high' || a.severity === 'critical').length} high-priority alerts require attention`,
    `${opportunities.filter(o => o.priority === 'high').length} high-value opportunities identified`,
    'Market sentiment remains stable with emerging growth opportunities'
  ];
}

function generateRecommendations(alerts: any[], opportunities: any[]): string[] {
  return [
    'Prioritize addressing high-severity competitive alerts',
    'Evaluate and pursue high-confidence market opportunities',
    'Strengthen monitoring in identified weak areas'
  ];
}

function identifyAlertTrends(alerts: any[]): string[] {
  return ['Increased competitor feature releases', 'Pricing pressure in market'];
}

function calculateOpportunityValue(opportunities: any[]): string {
  return '$2.5M estimated'; // Mock calculation
}