/**
 * Alert creation functions
 */
async function createRankingAlert(competitorId: string, current: any, previous: any, change: number): Promise<void> {
  const alert = {
    type: 'ranking-change',
    competitorId,
    severity: Math.abs(change) >= 10 ? 'high' : 'medium',
    title: `Ranking Change: ${change > 0 ? 'Improved' : 'Declined'} by ${Math.abs(change)} positions`,
    description: `Competitor ranking changed from #${previous.categoryRank} to #${current.categoryRank}`,
    detectedAt: new Date(),
    status: 'new',
    triggerData: { current, previous, change }
  };
  
  await db.collection('competitive_intelligence_alerts').add(alert);
  
  if (alert.severity === 'high') {
    await sendImmediateNotification(alert);
  }
}

async function createSentimentAlert(competitorId: string, analysis: any, alertType: string): Promise<void> {
  const alert = {
    type: 'sentiment-shift',
    competitorId,
    severity: 'medium',
    title: 'Negative Sentiment Trend Detected',
    description: `Significant negative sentiment detected in recent reviews`,
    detectedAt: new Date(),
    status: 'new',
    triggerData: analysis
  };
  
  await db.collection('competitive_intelligence_alerts').add(alert);
}

async function createOpportunityAlert(opportunity: any): Promise<void> {
  const alert = {
    type: 'opportunity',
    competitorId: 'market',
    severity: 'high',
    title: `High-Priority Opportunity: ${opportunity.title}`,
    description: opportunity.description,
    detectedAt: new Date(),
    status: 'new',
    triggerData: opportunity
  };
  
  await db.collection('competitive_intelligence_alerts').add(alert);
  await sendImmediateNotification(alert);
}

