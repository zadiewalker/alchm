/**
 * ALCHM Competitive Intelligence Firebase Functions
 * Automated data collection and processing for competitive monitoring
 */

import { onSchedule } from 'firebase-functions/v2/scheduler';
import { onRequest } from 'firebase-functions/v2/https';
import { initializeApp } from 'firebase-admin/app';
import { getFirestore } from 'firebase-admin/firestore';
import { logger } from 'firebase-functions';

// Initialize Firebase Admin
initializeApp();
const db = getFirestore();

// Rate limiting and privacy compliance
interface RateLimitTracker {
  requests: number;
  resetTime: number;
  lastRequest: number;
}

const rateLimits = new Map<string, RateLimitTracker>();

/**
 * Scheduled function to collect app store data
 * Runs daily at 2 AM UTC
 */
export const collectAppStoreData = onSchedule({
  schedule: '0 2 * * *', // Daily at 2 AM UTC
  timeZone: 'UTC',
  memory: '512MiB',
  timeoutSeconds: 540
}, async (event) => {
  try {
    logger.info('Starting automated app store data collection');
    
    // Get active competitors
    const competitorsSnapshot = await db.collection('competitive_intelligence_competitors')
      .where('isActive', '==', true)
      .get();
    
    const competitors = competitorsSnapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data()
    }));
    
    logger.info(`Processing ${competitors.length} competitors`);
    
    // Process each competitor
    for (const competitor of competitors) {
      try {
        await processCompetitorData(competitor);
        
        // Respect rate limits
        await respectRateLimit('app-store-api');
        
      } catch (error) {
        logger.error(`Error processing competitor ${competitor.id}:`, error);
      }
    }
    
    logger.info('App store data collection completed');
  } catch (error) {
    logger.error('Error in app store data collection:', error);
    throw error;
  }
});

/**
 * Scheduled function to analyze reviews and sentiment
 * Runs every 4 hours
 */
export const analyzeReviewSentiment = onSchedule({
  schedule: '0 */4 * * *', // Every 4 hours
  timeZone: 'UTC',
  memory: '1GiB',
  timeoutSeconds: 540
}, async (event) => {
  try {
    logger.info('Starting review sentiment analysis');
    
    // Get recent reviews that need analysis
    const reviewsSnapshot = await db.collection('competitive_intelligence_reviews')
      .where('analysisCompleted', '==', false)
      .limit(100)
      .get();
    
    logger.info(`Analyzing ${reviewsSnapshot.docs.length} reviews`);
    
    for (const reviewDoc of reviewsSnapshot.docs) {
      try {
        const review = reviewDoc.data();
        const analysis = await performSentimentAnalysis(review);
        
        // Update review with analysis
        await reviewDoc.ref.update({
          ...analysis,
          analysisCompleted: true,
          analysisDate: new Date()
        });
        
        // Check for alerts
        await checkForSentimentAlerts(review.competitorId, analysis);
        
      } catch (error) {
        logger.error(`Error analyzing review ${reviewDoc.id}:`, error);
      }
    }
    
    logger.info('Review sentiment analysis completed');
  } catch (error) {
    logger.error('Error in review sentiment analysis:', error);
    throw error;
  }
});

/**
 * Scheduled function to detect feature changes
 * Runs weekly on Sundays at 3 AM
 */
export const detectFeatureChanges = onSchedule({
  schedule: '0 3 * * 0', // Weekly on Sunday at 3 AM
  timeZone: 'UTC',
  memory: '1GiB',
  timeoutSeconds: 540
}, async (event) => {
  try {
    logger.info('Starting feature change detection');
    
    const competitorsSnapshot = await db.collection('competitive_intelligence_competitors')
      .where('isActive', '==', true)
      .get();
    
    for (const competitorDoc of competitorsSnapshot.docs) {
      try {
        const competitor = { id: competitorDoc.id, ...competitorDoc.data() };
        await analyzeCompetitorFeatures(competitor);
        
      } catch (error) {
        logger.error(`Error analyzing features for ${competitorDoc.id}:`, error);
      }
    }
    
    logger.info('Feature change detection completed');
  } catch (error) {
    logger.error('Error in feature change detection:', error);
    throw error;
  }
});

/**
 * Scheduled function to identify market opportunities
 * Runs weekly on Mondays at 4 AM
 */
export const identifyOpportunities = onSchedule({
  schedule: '0 4 * * 1', // Weekly on Monday at 4 AM
  timeZone: 'UTC',
  memory: '2GiB',
  timeoutSeconds: 540
}, async (event) => {
  try {
    logger.info('Starting opportunity identification');
    
    // Run comprehensive opportunity analysis
    const opportunities = await runOpportunityAnalysis();
    
    // Store opportunities
    for (const opportunity of opportunities) {
      await db.collection('competitive_intelligence_opportunities').add({
        ...opportunity,
        identifiedDate: new Date(),
        status: 'new'
      });
      
      // Create high-priority alerts
      if (opportunity.priority === 'high') {
        await createOpportunityAlert(opportunity);
      }
    }
    
    logger.info(`Identified ${opportunities.length} new opportunities`);
  } catch (error) {
    logger.error('Error in opportunity identification:', error);
    throw error;
  }
});

/**
 * Scheduled function to generate weekly reports
 * Runs weekly on Mondays at 9 AM
 */
export const generateWeeklyReport = onSchedule({
  schedule: '0 9 * * 1', // Weekly on Monday at 9 AM
  timeZone: 'UTC',
  memory: '1GiB',
  timeoutSeconds: 540
}, async (event) => {
  try {
    logger.info('Starting weekly report generation');
    
    const endDate = new Date();
    const startDate = new Date(endDate.getTime() - 7 * 24 * 60 * 60 * 1000);
    
    const report = await generateCompetitiveReport('weekly-brief', startDate, endDate);
    
    // Store report
    await db.collection('competitive_intelligence_reports').add(report);
    
    // Send notifications
    await sendReportNotifications(report);
    
    logger.info('Weekly report generated and sent');
  } catch (error) {
    logger.error('Error generating weekly report:', error);
    throw error;
  }
});

/**
 * HTTP function for manual data collection trigger
 */
export const triggerDataCollection = onRequest({
  cors: true,
  memory: '512MiB',
  timeoutSeconds: 300
}, async (req, res) => {
  try {
    // Verify authentication (in production, implement proper auth)
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      res.status(401).json({ error: 'Unauthorized' });
      return;
    }
    
    const competitorId = req.body.competitorId;
    const dataType = req.body.dataType || 'all';
    
    logger.info(`Manual data collection triggered for ${competitorId}, type: ${dataType}`);
    
    if (competitorId) {
      // Get specific competitor
      const competitorDoc = await db.collection('competitive_intelligence_competitors')
        .doc(competitorId)
        .get();
      
      if (!competitorDoc.exists) {
        res.status(404).json({ error: 'Competitor not found' });
        return;
      }
      
      const competitor = { id: competitorDoc.id, ...competitorDoc.data() };
      
      // Process based on data type
      switch (dataType) {
        case 'metrics':
          await processCompetitorData(competitor);
          break;
        case 'features':
          await analyzeCompetitorFeatures(competitor);
          break;
        case 'all':
          await processCompetitorData(competitor);
          await analyzeCompetitorFeatures(competitor);
          break;
      }
    } else {
      // Process all competitors
      const competitorsSnapshot = await db.collection('competitive_intelligence_competitors')
        .where('isActive', '==', true)
        .get();
      
      for (const competitorDoc of competitorsSnapshot.docs) {
        const competitor = { id: competitorDoc.id, ...competitorDoc.data() };
        await processCompetitorData(competitor);
      }
    }
    
    res.json({ 
      success: true, 
      message: 'Data collection completed',
      timestamp: new Date().toISOString()
    });
    
  } catch (error) {
    logger.error('Error in manual data collection:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

/**
 * HTTP function for real-time alert webhooks
 */
export const alertWebhook = onRequest({
  cors: true,
  memory: '256MiB',
  timeoutSeconds: 60
}, async (req, res) => {
  try {
    // Validate webhook signature (implement in production)
    
    const alertData = req.body;
    
    // Process alert
    await db.collection('competitive_intelligence_alerts').add({
      ...alertData,
      detectedAt: new Date(),
      status: 'new',
      source: 'webhook'
    });
    
    // Send immediate notifications for critical alerts
    if (alertData.severity === 'critical') {
      await sendImmediateNotification(alertData);
    }
    
    res.json({ success: true });
    
  } catch (error) {
    logger.error('Error processing alert webhook:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

