import * as functions from 'firebase-functions';
import { getFirestore, FieldValue } from 'firebase-admin/firestore';

const db = getFirestore();

// ===== STANDALONE USER TESTING FEEDBACK COLLECTION =====

export const userTestingFeedback = functions
  .runWith({ memory: '256MB' })
  .https.onRequest(async (req, res) => {
    // Enable CORS for all origins
    res.set('Access-Control-Allow-Origin', '*');
    res.set('Access-Control-Allow-Methods', 'POST, OPTIONS');
    res.set('Access-Control-Allow-Headers', 'Content-Type');

    // Handle preflight OPTIONS request
    if (req.method === 'OPTIONS') {
      res.status(204).send('');
      return;
    }

    if (req.method !== 'POST') {
      res.status(405).json({ error: 'Method not allowed. Use POST.' });
      return;
    }

    try {
      const feedback = req.body;
      
      // Add server-side metadata
      const feedbackDocId = generateFeedbackId();
      const feedbackDoc = {
        ...feedback,
        submittedAt: FieldValue.serverTimestamp(),
        ipAddress: req.ip,
        userAgent: req.get('User-Agent'),
        referer: req.get('Referer'),
        sessionId: generateSessionId(),
        id: feedbackDocId
      };

      // Store in Firestore
      await db.collection('user_testing_feedback').add(feedbackDoc);
      
      // Also store in a daily aggregation collection for easy analysis
      const today = new Date().toISOString().split('T')[0]!; // YYYY-MM-DD, guaranteed to exist
      await db.collection('user_testing_daily').doc(today).update({
        [`feedback_${feedbackDocId}`]: feedbackDoc,
        totalResponses: FieldValue.increment(1),
        lastUpdated: FieldValue.serverTimestamp()
      }).catch(async () => {
        // If document doesn't exist, create it
        await db.collection('user_testing_daily').doc(today).set({
          [`feedback_${feedbackDocId}`]: feedbackDoc,
          totalResponses: 1,
          createdAt: FieldValue.serverTimestamp(),
          lastUpdated: FieldValue.serverTimestamp()
        });
      });

      console.log(`User testing feedback received: ${feedbackDoc.id}`);
      
      res.status(200).json({ 
        success: true, 
        message: 'Feedback received successfully',
        feedbackId: feedbackDoc.id,
        timestamp: new Date().toISOString()
      });

    } catch (error) {
      console.error('Error saving user testing feedback:', error);
      res.status(500).json({ 
        error: 'Failed to save feedback',
        message: 'Please try again or contact support' 
      });
    }
  });

// ===== HELPER FUNCTIONS =====

function generateSessionId(): string {
  return Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
}

function generateFeedbackId(): string {
  return 'feedback_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
}