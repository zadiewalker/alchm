/**
 * Check emergency rollback status
 */
export const checkEmergencyRollbackStatus = functions
  .runWith({ 
    memory: '256MB', 
    timeoutSeconds: 10,
    maxInstances: 10 
  })
  .https.onCall(async (data: { rollbackId?: string }, context) => {
    try {
      if (data.rollbackId) {
        // Get specific rollback status
        const rollbackDoc = await db.collection('emergency_rollbacks').doc(data.rollbackId).get();
        
        if (rollbackDoc.exists) {
          return {
            rollbackId: data.rollbackId,
            ...rollbackDoc.data()
          };
        } else {
          return { error: 'Rollback not found' };
        }
      } else {
        // Get all active rollbacks
        const activeRollbacks = await db.collection('emergency_rollbacks')
          .where('status', 'in', ['initiated', 'in_progress'])
          .orderBy('startTime', 'desc')
          .limit(10)
          .get();
        
        return {
          activeRollbacks: activeRollbacks.docs.map(doc => ({
            rollbackId: doc.id,
            ...doc.data()
          }))
        };
      }
      
    } catch (error) {
      console.error('Failed to check rollback status:', error);
      return { error: String(error) };
    }
  });

/**
 * Cancel emergency rollback (if still in progress)
 */
export const cancelEmergencyRollback = functions
  .runWith({ 
    memory: '256MB', 
    timeoutSeconds: 30,
    maxInstances: 5 
  })
  .https.onCall(async (data: { rollbackId: string; reason: string }, context) => {
    const { rollbackId, reason } = data;
    
    try {
      // Check if rollback is still in progress
      const rollbackDoc = await db.collection('emergency_rollbacks').doc(rollbackId).get();
      
      if (!rollbackDoc.exists) {
        return { success: false, error: 'Rollback not found' };
      }
      
      const rollbackData = rollbackDoc.data();
      
      if (!['initiated', 'in_progress'].includes(rollbackData?.status)) {
        return { success: false, error: 'Rollback cannot be cancelled in current state' };
      }
      
      // Cancel the rollback
      await db.collection('emergency_rollbacks').doc(rollbackId).update({
        status: 'cancelled',
        cancellationReason: reason,
        cancelledAt: FieldValue.serverTimestamp(),
        cancelledBy: context.auth?.uid || 'system'
      });
      
      // Deactivate emergency mode if this was the only active rollback
      const otherActiveRollbacks = await db.collection('emergency_rollbacks')
        .where('status', 'in', ['initiated', 'in_progress'])
        .get();
      
      if (otherActiveRollbacks.empty) {
        const realtimeDb = admin.database();
        await realtimeDb.ref('emergency_mode').remove();
      }
      
      console.log(`Emergency rollback ${rollbackId} cancelled: ${reason}`);
      
      return { success: true, message: 'Rollback cancelled successfully' };
      
    } catch (error) {
      console.error('Failed to cancel emergency rollback:', error);
      return { success: false, error: String(error) };
    }
  });

export {
  EmergencyRollbackRequest,
  EmergencyRollbackStatus,
  RollbackStep,
  EmergencyNotification
};