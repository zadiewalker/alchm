{
  "name": "alchm",
  "version": "1.0.16",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/prepare-next-build.js && next build && node scripts/copy-static-export.js",
    "build:ios-release": "npm run build && npx cap sync ios --deployment && npm run verify:native-bundle",
    "build:safe": "bash scripts/safe-clean-build.sh",
    "cap:sync": "npx cap sync ios --deployment",
    "certify:release": "npm run qa:governance && npm run lint && npm run typecheck && npm run verify:manifest-assets && npm run build:ios-release && npm run release:manifest && npm run verify:release-manifest && npm run verify:deployment-topology && npm run test:offline-replay",
    "design:check": "npm run design:validate --silent",
    "design:enforce": "npm run design:validate && npm run build",
    "design:validate": "node scripts/validate-design.js",
    "dev": "next dev",
    "e2e:navigation": "node scripts/e2e-navigation.mjs",
    "qa:emotional-language-guards": "node scripts/check-emotional-language-guards.js",
    "qa:governance": "npm run qa:emotional-language-guards && npm run qa:return-restraint-guards && npm run qa:khepera-guards && npm run qa:repository-coherence",
    "qa:khepera-guards": "node scripts/check-khepera-invariants.js",
    "qa:repository-coherence": "node scripts/check-repository-coherence.js",
    "qa:return-restraint-guards": "node scripts/check-resurfacing-guardrails.js",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "test:offline-replay": "node scripts/test-offline-replay-integrity.mjs",
    "lint": "eslint",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "verify:branch-protection": "bash scripts/check-branch-protection.sh",
    "verify:deployment-topology": "node scripts/verify-deployment-topology.mjs && npm run verify:vercel-authority",
    "verify:manifest-assets": "node scripts/verify-manifest-assets.mjs",
    "verify:native-bundle": "node scripts/verify-native-bundle.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "verify:vercel-authority": "node scripts/verify-vercel-authority.mjs",
    "start": "next start",
    "sync:ios": "npm run sync:ios:bundle",
    "sync:ios:bundle": "npm run build && npx cap sync ios",
    "sync:ios:server": "node -e \"if(!process.env.CAPACITOR_SERVER_URL){console.error('Missing CAPACITOR_SERVER_URL');process.exit(1)}\" && CAPACITOR_USE_SERVER=true npx cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.1.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@sentry/nextjs": "^10.38.0",
    "@sentry/node": "^10.38.0",
    "@sentry/react": "^10.38.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "chart.js": "^4.5.1",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.6.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.563.0",
    "next": "^16.2.6",
    "openai": "^6.16.0",
    "react": "^19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.1",
    "stripe": "^17.5.0",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.58.2",
    "postcss": "8.5.14",
    "typescript": "^5"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "postcss": "$postcss",
    "uuid": "^11.1.1"
  }
}
