{
  "name": "alchm",
  "version": "1.0.16",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "build:safe": "bash scripts/safe-clean-build.sh",
    "design:check": "npm run design:validate --silent",
    "design:enforce": "npm run design:validate && npm run build",
    "design:validate": "node scripts/validate-design.js",
    "dev": "next dev",
    "e2e:navigation": "node scripts/e2e-navigation.mjs",
    "qa:khepera-guards": "node scripts/check-resurfacing-guardrails.js",
    "qa:return-restraint-guards": "node scripts/check-resurfacing-guardrails.js",
    "lint": "eslint src eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "check:invariants": "node --test src/__tests__/architectureInvariants.test.mjs",
    "check:firestore-rules": "node --test src/__tests__/firestoreRulesContract.test.mjs",
    "check:integrity": "node --test src/__tests__/integrityInfrastructure.test.mjs && node scripts/check-emotional-language-guards.js",
    "check:khepera-gateway": "npm --prefix functions run build && node --test functions/__tests__/kheperaGatewayCore.test.cjs",
    "check:container-transitions": "npm --prefix functions run build && node --test functions/__tests__/containerTransitionsCore.test.cjs functions/__tests__/continuityRuntimeGateCore.test.cjs functions/__tests__/runtimeAttestationVerifierCore.test.cjs",
    "check:release-trust": "node scripts/check-release-trust-evidence.mjs",
    "check:release-scope": "node scripts/check-release-scope.mjs",
    "check:release-authority": "node scripts/check-release-authority.mjs",
    "check:deployment-topology": "node scripts/check-deployment-topology.mjs",
    "check:runtime-attestation": "node scripts/check-runtime-attestation-evidence.mjs",
    "check:sensitive-write-authority": "node scripts/check-sensitive-write-authority.mjs",
    "check:functions-trust-lint": "npm --prefix functions run lint:trust-critical",
    "check:firestore-emulator-evidence": "node scripts/run-firestore-emulator-evidence.mjs",
    "test": "node --test src/__tests__/architectureInvariants.test.mjs src/__tests__/clinicalStabilization.test.mjs src/__tests__/onboardingEntryFlow.test.mjs src/__tests__/queueLease.test.mjs src/__tests__/firestoreRulesContract.test.mjs src/__tests__/releaseTrustRemediation.test.mjs src/__tests__/integrityInfrastructure.test.mjs src/lib/khepera/cognition/__tests__/adaptiveCognition.test.mjs",
    "validate": "npm run typecheck && npm run lint && npm run check:release-trust && npm run check:release-scope && npm run check:release-authority && npm run check:deployment-topology && npm run check:runtime-attestation && npm run check:sensitive-write-authority && npm run check:invariants && npm run check:firestore-rules && npm run check:integrity && npm run check:khepera-gateway && npm run check:container-transitions && npm test && npm run build",
    "prepare": "husky",
    "start": "next start",
    "sync:ios": "npm run sync:ios:bundle",
    "sync:ios:bundle": "npm run build && npx cap sync ios",
    "sync:ios:server": "node -e \"if(!process.env.CAPACITOR_SERVER_URL){console.error('Missing CAPACITOR_SERVER_URL');process.exit(1)}\" && CAPACITOR_USE_SERVER=true npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@sentry/nextjs": "^10.38.0",
    "@sentry/node": "^10.38.0",
    "@sentry/react": "^10.38.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "chart.js": "^4.5.1",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.563.0",
    "next": "14.2.15",
    "openai": "^6.16.0",
    "react": "18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "18.2.0",
    "stripe": "^17.5.0",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "14.2.15",
    "firebase-tools": "^14.12.0",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "typescript": "^5"
  }
}
