{
  "name": "alchm",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "ALCHM — Trauma-informed, AI-powered journaling OS",
  "author": "Zadie Walker",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "next build",
    "build:copy-assets": "cp -r .next/static .next/standalone/ || mkdir -p .next/standalone/static && cp -r .next/static/* .next/standalone/static/",
    "build:firebase": "next build && npm run build:copy-assets",
    "build:ios": "next build && npx cap copy ios && npx cap sync ios",
    "build:android": "next build && npx cap copy android && npx cap sync android",
    "build:analyze": "ANALYZE=true npm run build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:lighthouse": "lighthouse http://localhost:3001 --output=json --output-path=./lighthouse-report.json",
    
    "firebase:emulators": "firebase emulators:start --only firestore,functions,auth",
    "firebase:deploy": "firebase deploy --only hosting,functions,firestore",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "firebase:login": "firebase login",
    "firebase:login:ci": "firebase login:ci",
    
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:link": "vercel link",
    
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:add:android": "npx cap add android", 
    "capacitor:open:ios": "npx cap open ios",
    "capacitor:open:android": "npx cap open android",
    "capacitor:sync": "npx cap sync",
    "capacitor:run:ios": "npx cap run ios",
    "capacitor:run:android": "npx cap run android",
    
    "ios:build": "./scripts/build-ios-testflight.sh",
    "ios:testflight": "cd ios && fastlane beta",
    "ios:screenshots": "cd ios && fastlane screenshots",
    "testflight:prepare": "node scripts/testflight-preparation.js",
    
    "android:build:debug": "./scripts/build-android.sh debug",
    "android:build:testing": "./scripts/build-android.sh testing", 
    "android:build:release": "./scripts/build-android.sh release",
    "android:test:all": "./scripts/android-testing-pipeline.sh",
    "android:test:unit": "cd android && ./gradlew testDebugUnitTest",
    "android:test:instrumented": "cd android && ./gradlew connectedDebugAndroidTest",
    "android:test:accessibility": "cd android && ./gradlew connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.alchm.identityos.ALCHMInstrumentedTestFramework#testAccessibilityCompliance",
    "android:prepare": "node scripts/android-testing-preparation.js",
    
    "mobile:prepare": "node scripts/mobile-testing-master.js",
    "mobile:build": "./scripts/build-mobile-master.sh both",
    "mobile:test:all": "./scripts/continuous-testing-pipeline.sh",
    "mobile:release": "./scripts/release-automation.sh",
    
    "deploy": "./scripts/deploy.sh",
    "deploy:all": "npm run build && firebase deploy && vercel --prod",
    "deploy:functions": "cd functions && pnpm run build && cd .. && firebase deploy --only functions",
    "audit:fix": "npm audit fix --force",
    "audit:security": "pnpm audit --audit-level high",
    "performance:test": "npm run build && npm run test:lighthouse",
    "precommit": "npm run typecheck && npm run lint",
    
    "studio:diagnostic": "node scripts/firebase-studio-diagnostic.js",
    "studio:check": "node scripts/quick-firebase-studio-check.js",
    "studio:audit": "./scripts/run-firebase-studio-audit.sh",
    
    "404:fix": "node scripts/quick-404-fix.js",
    "404:debug": "node scripts/firebase-studio-404-debugger.js",
    "404:validate": "node scripts/validate-firebase-studio.js",
    "404:diagnose": "./scripts/run-404-diagnostic.sh",
    
    "env:diagnostic": "node scripts/multi-env-diagnostic.js",
    "env:analyze": "node scripts/multi-env-diagnostic.js",
    "firebase:studio:fix": "node scripts/multi-env-diagnostic.js",
    
    "homepage:audit": "node scripts/firebase-homepage-404-audit.js",
    "homepage:404:fix": "node scripts/firebase-homepage-404-audit.js",
    "firebase:homepage:debug": "node scripts/firebase-homepage-404-audit.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor-firebase/analytics": "^6.0.0",
    "@capacitor-firebase/crashlytics": "^6.0.0",
    "@capacitor-firebase/performance": "^6.0.0",
    
    "@firebase/app": "^0.10.0",
    "@firebase/auth": "^1.6.0",
    "@firebase/firestore": "^4.6.1",
    "@firebase/functions": "^0.11.0",
    "@firebase/storage": "^0.14.0",
    "@types/ioredis": "^5.0.0",
    "chart.js": "^4.5.0",
    "compression-webpack-plugin": "^11.1.0",
    "firebase": "^11.0.0",
    "firebase-admin": "12.5.0",
    "firebase-functions": "5.1.1",
    "ioredis": "^5.7.0",
    "next": "^15.4.6",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "stripe": "^14.23.0",
    "tailwindcss": "^3.4.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.10.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.2",
    "@vercel/analytics": "^1.0.0",
    "ajv": "^6.12.6",
    "ajv-cli": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^29.7.0",
    "eslint": "^9.2.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.44.0",
    "postcss": "^8.4.39",
    "vercel": "^37.0.0",
    "webpack": "^5.101.2",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "permissions": {
    "android": {
      "INTERNET": true,
      "ACCESS_NETWORK_STATE": true,
      "CAMERA": true,
      "READ_EXTERNAL_STORAGE": true,
      "WRITE_EXTERNAL_STORAGE": true,
      "RECORD_AUDIO": true,
      "VIBRATE": true,
      "ACCESS_NOTIFICATION_POLICY": true
    },
    "ios": {
      "NSCameraUsageDescription": "ALCHM needs camera access for journal photo attachments",
      "NSPhotoLibraryAddUsageDescription": "Save journal reflections as PDFs and images",
      "NSPhotoLibraryUsageDescription": "Attach photos to your journal entries",
      "NSMicrophoneUsageDescription": "Record voice notes for your journal (future feature)",
      "NSUserTrackingUsageDescription": "Help improve ALCHM's AI insights while protecting your privacy"
    }
  },
  "engines": {
    "node": ">=18 <=20",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "fast-json-patch": ">=3.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18",
        "react-dom": "18"
      }
    }
  }
}