rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsCreatedDocument() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.verified == true;
    }
    
    // Helper function to check admin permission
    function hasAdminPermission(permission) {
      return isAdmin() && 
             permission in get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.permissions;
    }
    
    // Legacy dataService collections remain user-owned while active UI surfaces are retired or migrated.
    match /journalEntries/{document} {
      allow create: if ownsCreatedDocument();
      allow read, update, delete: if ownsExistingDocument();
    }

    match /dreamEntries/{document} {
      allow create: if ownsCreatedDocument();
      allow read, update, delete: if ownsExistingDocument();
    }

    match /pathwayProgress/{document} {
      allow create: if ownsCreatedDocument();
      allow read, update, delete: if ownsExistingDocument();
    }

    match /shadowWorkProgress/{document} {
      allow create: if ownsCreatedDocument();
      allow read, update, delete: if ownsExistingDocument();
    }
    
    // Canonical user-owned ALCHM data lives under users/{uid}.
    match /users/{userId} {
      allow read, write: if ownsUserPath(userId);
      // Allow admins to read anonymized user data for demographics (without personal info)
      allow read: if hasAdminPermission('view_crisis_events');

      match /profile/{profileId} {
        allow read, write: if ownsUserPath(userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if ownsUserPath(userId);
      }

      match /containers/{containerId} {
        allow read, write: if ownsUserPath(userId);
      }

      match /khepera/{document} {
        allow read, write: if ownsUserPath(userId);
      }

      match /kheperaDelayedReflections/{document} {
        allow read, write: if ownsUserPath(userId);
      }
    }
    
    // Legacy analysis documents are intentionally retired with the non-canonical analysis runtime.
    match /users/{userId}/analyses/{analysisId} {
      allow read, write: if false;
    }
    
    // Crisis events - admin access only with proper permissions
    match /crisisEvents/{eventId} {
      allow read: if hasAdminPermission('view_crisis_events');
      allow write: if hasAdminPermission('escalate_crisis') || hasAdminPermission('resolve_crisis');
      // Only allow server-side writes (functions can bypass these rules)
    }
    
    // Admin users collection - only system admins can manage
    match /adminUsers/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if hasAdminPermission('manage_admin_users');
    }
    
    // Alert rules - admin access only
    match /alertRules/{ruleId} {
      allow read, write: if hasAdminPermission('manage_alerts');
    }
    
    // Alert logs - admin read access only
    match /alertLog/{logId} {
      allow read: if hasAdminPermission('view_analytics');
      // Write access only for functions
    }
    
    // Admin audit log - system admin access only
    match /adminAuditLog/{logId} {
      allow read: if hasAdminPermission('system_configuration');
      // Write access only for functions
    }
    
    // System health data - admin read access
    match /systemHealth/{healthId} {
      allow read: if hasAdminPermission('view_analytics');
      // Write access only for functions
    }
    
    // Daily analytics - admin read access
    match /dailyAnalytics/{date} {
      allow read: if hasAdminPermission('view_analytics');
      // Write access only for functions
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
