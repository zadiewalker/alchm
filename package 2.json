{
  "name": "alchm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ALCHM — Trauma-informed, AI-powered journaling OS",
  "author": "Zadie Walker",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:lighthouse": "lighthouse http://localhost:3001 --output=json --output-path=./lighthouse-report.json",
    "firebase:emulators": "firebase emulators:start --only firestore,functions,auth",
    "firebase:deploy": "firebase deploy --only hosting,functions,firestore",
    "audit:fix": "npm audit fix --force",
    "audit:security": "pnpm audit --audit-level high",
    "performance:test": "npm run build && npm run test:lighthouse"
  },
  "dependencies": {
    "@firebase/app": "^0.10.0",
    "@firebase/auth": "^1.6.0",
    "@firebase/firestore": "^4.6.1",
    "@firebase/functions": "^0.11.0",
    "@firebase/storage": "^0.14.0",
    "firebase": "^11.0.0",
    "firebase-admin": "12.5.0",
    "firebase-functions": "5.1.1",
    "next": "^15.4.6",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^14.23.0",
    "tailwindcss": "^3.4.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.2",
    "ajv": "^6.12.6",
    "ajv-cli": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.2.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "playwright": "^1.44.0",
    "postcss": "^8.4.39",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "engines": {
    "node": ">=18 <20",
    "npm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "fast-json-patch": ">=3.1.1"
    }
  }
}
