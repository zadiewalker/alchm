# ALCHM Environment Variables Template
# Copy this file to .env.local and fill in your values

# ===== FIREBASE CONFIGURATION =====
# Get these from Firebase Console > Project Settings > General Tab
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Optional: Firebase Measurement ID for Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== STRIPE CONFIGURATION =====
# Get these from Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_key_here
STRIPE_SECRET_KEY=sk_test_or_sk_live_key_here

# Stripe Webhook Secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_webhook_secret_here

# Stripe Price IDs for subscription tiers
STRIPE_DEEP_CUT_PRICE_ID=price_deep_cut_monthly
STRIPE_ORACLE_PRICE_ID=price_oracle_monthly

# ===== AUTHENTICATION =====
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com

# ===== ENVIRONMENT =====
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production

# ===== API CONFIGURATION =====
NEXT_PUBLIC_API_URL=https://your-domain.com

# ===== AI SERVICES (OPTIONAL) =====
# OpenAI API Key for enhanced AI features
# OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic API Key for Claude integration
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google AI (Gemini) API Key
# GOOGLE_AI_API_KEY=your_google_ai_key_here

# ===== ANALYTICS & MONITORING (OPTIONAL) =====
# Google Analytics 4 Measurement ID
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# SENTRY_DSN=https://your_sentry_dsn_here

# Mixpanel Token for analytics
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# ===== NOTIFICATIONS (OPTIONAL) =====
# Slack Webhook for deployment notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord Webhook for alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Email for alerts
# ALERT_EMAIL=alerts@yourdomain.com

# ===== PAGERDUTY (OPTIONAL) =====
# PagerDuty Integration Key for critical alerts
# PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# ===== CRISIS SUPPORT (REQUIRED FOR PRODUCTION) =====
# Crisis support hotline numbers (comma-separated)
NEXT_PUBLIC_CRISIS_HOTLINES="988,1-800-273-8255"

# Crisis support text line
NEXT_PUBLIC_CRISIS_TEXT_LINE="741741"

# Emergency services number
NEXT_PUBLIC_EMERGENCY_NUMBER="911"

# ===== RATE LIMITING =====
# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== DATABASE CONFIGURATION =====
# Firestore region
FIRESTORE_REGION=us-central1

# Database connection limits
MAX_DB_CONNECTIONS=100

# ===== STORAGE CONFIGURATION =====
# File upload limits (in bytes)
MAX_FILE_SIZE=10485760
MAX_AUDIO_FILE_SIZE=52428800
MAX_DOCUMENT_FILE_SIZE=26214400

# ===== CACHE CONFIGURATION =====
# Redis URL for caching (optional)
# REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
CACHE_TTL=3600

# ===== PERFORMANCE =====
# Enable/disable optimizations
ENABLE_BUNDLE_ANALYZER=false
ENABLE_COMPRESSION=true
ENABLE_SERVICE_WORKER=true

# ===== SECURITY =====
# Content Security Policy (CSP) settings
CSP_REPORT_URI=https://your-domain.com/api/csp-report

# Trusted domains for external resources
TRUSTED_DOMAINS=firebasestorage.googleapis.com,googleapis.com

# ===== BACKUP CONFIGURATION =====
# Backup storage bucket
BACKUP_BUCKET=gs://your-project-backups

# Backup retention period (days)
BACKUP_RETENTION_DAYS=30

# ===== FEATURE FLAGS =====
# Enable/disable features
ENABLE_AI_FEATURES=true
ENABLE_CRISIS_PREVENTION=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_ANALYTICS=true

# ===== DEBUGGING =====
# Debug mode (development only)
DEBUG=false
VERBOSE_LOGGING=false

# ===== INSTRUCTIONS =====
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to version control
# 4. Ensure all required variables are set before deployment
# 5. Test your configuration with: npm run dev

# ===== SECURITY NOTES =====
# - Keep your API keys secure and never share them
# - Use test keys for development and live keys for production
# - Regularly rotate your secrets
# - Monitor usage and set up billing alerts
# - Use environment-specific configurations
