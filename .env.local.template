# ALCHM PRIVACY-COMPLIANT ENVIRONMENT CONFIGURATION
# =====================================================
# CRITICAL: Never commit actual credentials to version control
# Use this template to create your local .env.local file

# Firebase Configuration (Client-side - Public Keys)
# These are safe to expose but should still be managed securely
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (Server-side - HIGHLY SENSITIVE)
# These credentials provide full administrative access
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PROJECT_ID=your-project-id

# Stripe Payment Processing (PRODUCTION - HIGHLY SENSITIVE)
# These control real financial transactions
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AI Processing Keys (SENSITIVE - User Data Processing)
# These keys process mental health data and must be protected
OPENAI_API_KEY=sk-proj-your_openai_key_here
GOOGLE_AI_API_KEY=AIzaSy_your_google_ai_key_here

# Crisis Detection & Support (CRITICAL - Life Safety)
# These support crisis intervention systems
CRISIS_DETECTION_API_KEY=your_crisis_detection_key_here
EMERGENCY_CONTACT_API_KEY=your_emergency_contact_key_here

# Development/Testing (Use test credentials only)
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Security & Compliance
ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# GDPR/COPPA Compliance
DATA_RETENTION_DAYS=365
MINOR_DATA_RETENTION_DAYS=30
PARENTAL_CONSENT_REQUIRED=true

# Crisis Support Configuration
CRISIS_HOTLINE_NUMBER=988
CRISIS_TEXT_NUMBER=741741
EMERGENCY_EMAIL=crisis@your-domain.com