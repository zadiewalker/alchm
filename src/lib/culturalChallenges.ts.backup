// Culturally Adapted Challenge System
import { CulturalContext, CulturalAdaptation } from './i18n';
import { Challenge } from './transformationEngine';

export interface CulturalChallenge extends Challenge {
  culturalAdaptations: {
    collectivist: Partial<Challenge>;
    individualist: Partial<Challenge>;
    spiritual: Partial<Challenge>;
    secular: Partial<Challenge>;
    formal: Partial<Challenge>;
    informal: Partial<Challenge>;
  };
  culturalSensitivity: {
    appropriateFor: string[]; // Cultural contexts where this is appropriate
    avoidFor: string[]; // Cultural contexts to avoid
    alternatives: Record<string, string>; // Alternative challenges for different cultures
  };
}

