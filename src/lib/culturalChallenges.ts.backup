// Cultural challenge adaptation engine
export class CulturalChallengeEngine {
  static adaptChallenge(challenge: CulturalChallenge, culturalContext: CulturalContext): Challenge {
    let adaptedChallenge = { ...challenge };

    // Apply cultural value adaptations
    if (culturalContext.culturalValues.collectivism > 0.6) {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.collectivist };
    } else {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.individualist };
    }

    if (culturalContext.culturalValues.spirituality > 0.6) {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.spiritual };
    } else {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.secular };
    }

    if (culturalContext.culturalValues.formalityLevel > 0.6) {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.formal };
    } else {
      adaptedChallenge = { ...adaptedChallenge, ...challenge.culturalAdaptations.informal };
    }

    // Apply communication style adaptation
    if (adaptedChallenge.prompt) {
      adaptedChallenge.prompt = CulturalAdaptation.adaptCommunicationStyle(
        adaptedChallenge.prompt, 
        culturalContext
      );
    }

    if (adaptedChallenge.description) {
      adaptedChallenge.description = CulturalAdaptation.adaptCommunicationStyle(
        adaptedChallenge.description, 
        culturalContext
      );
    }

    // Apply healing practice adaptation
    adaptedChallenge = CulturalAdaptation.adaptHealingPractice(adaptedChallenge, culturalContext);

    return adaptedChallenge;
  }

  static getCulturallyAppropriate(
    challenges: CulturalChallenge[], 
    culturalContext: CulturalContext
  ): CulturalChallenge[] {
    return challenges.filter(challenge => {
      // Check if challenge is appropriate for this cultural context
      const appropriate = challenge.culturalSensitivity.appropriateFor.includes('all') ||
        challenge.culturalSensitivity.appropriateFor.some(context => 
          culturalContext.healingTraditions.includes(context) ||
          this.matchesCulturalValue(context, culturalContext)
        );

      // Check if challenge should be avoided
      const shouldAvoid = challenge.culturalSensitivity.avoidFor.some(context =>
        this.matchesCulturalValue(context, culturalContext)
      );

      return appropriate && !shouldAvoid;
    });
  }

  static getAlternativeChallenge(
    originalChallenge: CulturalChallenge,
    culturalContext: CulturalContext,
    allChallenges: CulturalChallenge[]
  ): CulturalChallenge | null {
    // Look for culturally appropriate alternatives
    for (const [context, alternativeId] of Object.entries(originalChallenge.culturalSensitivity.alternatives)) {
      if (this.matchesCulturalValue(context, culturalContext)) {
        const alternative = allChallenges.find(c => c.id === alternativeId);
        if (alternative) return alternative;
      }
    }
    return null;
  }

  static generateCulturalInsight(challenge: Challenge, culturalContext: CulturalContext): string {
    const insights = [];

    if (culturalContext.culturalValues.collectivism > 0.6) {
      insights.push("This practice emphasizes community connection and shared growth.");
    }

    if (culturalContext.culturalValues.spirituality > 0.6) {
      insights.push("This aligns with spiritual traditions and inner wisdom practices.");
    }

    if (culturalContext.culturalValues.familyInvolvement > 0.6) {
      insights.push("Consider involving family members or honoring family wisdom in this practice.");
    }

    if (culturalContext.healingTraditions.includes('mindfulness')) {
      insights.push("This practice draws from mindfulness traditions valued in your culture.");
    }

    return insights.length > 0 
      ? `Cultural insight: ${insights.join(' ')}`
      : "This practice can be adapted to honor your cultural values and traditions.";
  }

  private static matchesCulturalValue(context: string, culturalContext: CulturalContext): boolean {
    switch (context) {
      case 'collectivist':
        return culturalContext.culturalValues.collectivism > 0.6;
      case 'individualist':
        return culturalContext.culturalValues.collectivism <= 0.4;
      case 'spiritual':
        return culturalContext.culturalValues.spirituality > 0.6;
      case 'secular':
        return culturalContext.culturalValues.spirituality <= 0.4;
      case 'traditional':
        return culturalContext.healingTraditions.includes('traditional');
      case 'family-oriented':
        return culturalContext.culturalValues.familyInvolvement > 0.6;
      default:
        return false;
    }
  }
}