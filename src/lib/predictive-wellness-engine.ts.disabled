  }

  private getSocialConnectionCulturalConsiderations(culture: string): string[] {
    const considerationsMap: Record<string, string[]> = {
      'es': ['Extended family importance', 'Community celebration integration'],
      'ko': ['Hierarchical relationship respect', 'Social obligation balance'],
      'hi': ['Community dharma participation', 'Spiritual community connection'],
      'de': ['Quality over quantity relationships', 'Professional boundary maintenance']
    };

    return considerationsMap[culture] || ['Individual social preferences'];
  }

  private calculatePredictionAccuracy(prediction: WellnessPrediction, actualOutcome: any): number {
    // Simplified accuracy calculation
    let accuracy = 0;
    const predictions = 5; // Number of prediction aspects

    // Wellness score accuracy (within 20 points = good)
    const wellnessAccuracy = Math.max(0, 1 - Math.abs(prediction.predicted_state.wellness_score - actualOutcome.wellness_score) / 20);
    accuracy += wellnessAccuracy / predictions;

    // Risk level accuracy
    const riskLevels = ['low', 'medium', 'high', 'crisis'];
    const predictedRiskIndex = riskLevels.indexOf(prediction.predicted_state.risk_level);
    const actualRiskIndex = this.determineActualRiskLevel(actualOutcome);
    const riskAccuracy = Math.max(0, 1 - Math.abs(predictedRiskIndex - actualRiskIndex) / 3);
    accuracy += riskAccuracy / predictions;

    // Emotional state accuracy (simplified)
    const emotionAccuracy = Math.max(0, 1 - Math.abs(
      prediction.predicted_state.emotional_state.primaryEmotion.valence - 
      actualOutcome.emotional_state.primaryEmotion.valence
    ));
    accuracy += emotionAccuracy / predictions;

    // Concern prediction accuracy
    const predictedConcerns = new Set(prediction.predicted_state.primary_concerns);
    const actualConcerns = new Set(actualOutcome.occurred_events);
    const concernIntersection = new Set([...predictedConcerns].filter(x => actualConcerns.has(x)));
    const concernAccuracy = predictedConcerns.size > 0 ? concernIntersection.size / predictedConcerns.size : 0.5;
    accuracy += concernAccuracy / predictions;

    // Overall prediction confidence calibration
    accuracy += Math.min(1, prediction.confidence_score) / predictions;

    return Math.max(0, Math.min(1, accuracy));
  }

  private determineActualRiskLevel(actualOutcome: any): number {
    // Convert actual outcome to risk level index
    if (actualOutcome.wellness_score < 30) return 3; // crisis
    if (actualOutcome.wellness_score < 50) return 2; // high
    if (actualOutcome.wellness_score < 70) return 1; // medium
    return 0; // low
  }

  private async updateModelFromOutcome(
    userId: string,
    prediction: WellnessPrediction,
    actualOutcome: any,
    accuracy: number
  ): Promise<void> {
    // Update model weights based on what worked well
    const model = this.predictionModels.get(userId);
    if (!model) return;

    // If prediction was accurate, strengthen the factors that contributed
    if (accuracy > 0.7) {
      // Strengthen successful prediction factors
      model.prediction_factors.emotional_patterns *= 1.05;
      model.prediction_factors.temporal_patterns *= 1.03;
    } else if (accuracy < 0.3) {
      // Weaken unsuccessful factors and strengthen others
      model.prediction_factors.emotional_patterns *= 0.95;
      model.prediction_factors.behavioral_patterns *= 1.05;
    }

    // Normalize weights
    const totalWeight = Object.values(model.prediction_factors).reduce((sum, weight) => sum + weight, 0);
    Object.keys(model.prediction_factors).forEach(key => {
      model.prediction_factors[key as keyof typeof model.prediction_factors] /= totalWeight;
    });

    this.predictionModels.set(userId, model);
  }

  private predictOptimalJournalingTime(contextualFactors: ContextualFactors): string {
    // Simple heuristic based on context
    if (contextualFactors.temporal_context.time_of_day === 'evening') {
      return 'Evening reflection time (7-9 PM)';
    }
    if (contextualFactors.temporal_context.time_of_day === 'morning') {
      return 'Morning intention setting (7-9 AM)';
    }
    return 'Mid-day processing break (12-2 PM)';
  }

  private predictOptimalSupportTime(contextualFactors: ContextualFactors): string {
    if (contextualFactors.social_context.support_system_availability > 0.7) {
      return 'Support system highly available - reach out anytime';
    }
    return 'Evening or weekend connection (when people are more available)';
  }

  private predictOptimalRestTime(contextualFactors: ContextualFactors): string {
    if (contextualFactors.environmental_context.noise_level === 'high') {
      return 'Early morning or late evening for quiet rest';
    }
    return 'Midday rest break or early evening wind-down';
  }
}

// Export singleton instance
export const predictiveWellnessEngine = new PredictiveWellnessEngine();

// Export types and interfaces
export {
  WellnessPredictionModel,
  WellnessPrediction,
  InterventionRecommendation,
  PreventionStrategy,
  ContextualFactors,
  PredictiveWellnessEngine
};