  private getTraumaCulturalAdaptation(culture: string): string {
    const adaptationMap: Record<string, string> = {
      'es': 'Honor generational trauma and family healing',
      'ko': 'Approach with cultural sensitivity to shame and honor',
      'hi': 'Integrate karmic understanding and spiritual healing',
      'de': 'Systematic trauma processing with professional support'
    };

    return adaptationMap[culture] || 'Culturally informed trauma support';
  }

  private getEmotionalRegulationCulturalConsiderations(culture: string): string[] {
    const considerationsMap: Record<string, string[]> = {
      'es': ['Family emotional expression norms', 'Community support integration'],
      'ko': ['Emotional restraint cultural values', 'Social harmony maintenance'],
      'hi': ['Dharmic emotional balance', 'Spiritual practice integration'],
      'de': ['Direct emotional processing', 'Systematic regulation approaches']
    };

