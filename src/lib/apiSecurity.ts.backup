// Comprehensive API security measures for ALCHM
import { NextRequest } from 'next/server';
import { createHash, randomBytes, timingSafeEqual } from 'crypto';
import { ApiErrorCode, createApiError, RequestContext } from './apiUtils';

// Security configuration
export interface SecurityConfig {
  corsOrigins?: string[];
  csrfProtection?: boolean;
  requestSizeLimit?: number; // in bytes
  headerValidation?: boolean;
  ipWhitelist?: string[];
  ipBlacklist?: string[];
  requireHttps?: boolean;
  contentTypeValidation?: boolean;
  sqlInjectionProtection?: boolean;
  xssProtection?: boolean;
}

// CSRF token store
class CSRFTokenStore {
  private tokens = new Map<string, { token: string; expires: number }>();
  
  generate(identifier: string): string {
    const token = randomBytes(32).toString('hex');
    const expires = Date.now() + (60 * 60 * 1000); // 1 hour
    
    this.tokens.set(identifier, { token, expires });
    this.cleanup();
    
    return token;
  }
  
  validate(identifier: string, token: string): boolean {
    const stored = this.tokens.get(identifier);
    if (!stored || Date.now() > stored.expires) {
      this.tokens.delete(identifier);
      return false;
    }
    
    // Use timing-safe comparison to prevent timing attacks
    const storedBuffer = Buffer.from(stored.token, 'hex');
    const providedBuffer = Buffer.from(token, 'hex');
    
    if (storedBuffer.length !== providedBuffer.length) {
      return false;
    }
    
    return timingSafeEqual(storedBuffer, providedBuffer);
  }
  
  private cleanup(): void {
    const now = Date.now();
    for (const [key, value] of this.tokens.entries()) {
      if (now > value.expires) {
        this.tokens.delete(key);
      }
    }
  }
}

// Security utilities
export class ApiSecurity {
  private config: SecurityConfig;
  private csrfStore = new CSRFTokenStore();
  
  constructor(config: SecurityConfig = {}) {
    this.config = {
      corsOrigins: config.corsOrigins || [],
      csrfProtection: config.csrfProtection !== false,
      requestSizeLimit: config.requestSizeLimit || 1024 * 1024, // 1MB default
      headerValidation: config.headerValidation !== false,
      ipWhitelist: config.ipWhitelist || [],
      ipBlacklist: config.ipBlacklist || [],
      requireHttps: config.requireHttps !== false,
      contentTypeValidation: config.contentTypeValidation !== false,
      sqlInjectionProtection: config.sqlInjectionProtection !== false,
      xssProtection: config.xssProtection !== false
    };
  }

  // Validate request security
  async validateRequest(req: NextRequest, context: RequestContext): Promise<void> {
    // HTTPS enforcement
    if (this.config.requireHttps && process.env.NODE_ENV === 'production') {
      this.enforceHttps(req, context);
    }

    // IP filtering
    this.validateIpAddress(req, context);

    // CORS validation
    this.validateCors(req, context);

    // Header validation
    if (this.config.headerValidation) {
      this.validateHeaders(req, context);
    }

    // Content type validation
    if (this.config.contentTypeValidation && ['POST', 'PUT', 'PATCH'].includes(req.method)) {
      this.validateContentType(req, context);
    }

    // Request size validation
    this.validateRequestSize(req, context);

    // CSRF protection
    if (this.config.csrfProtection && ['POST', 'PUT', 'PATCH', 'DELETE'].includes(req.method)) {
      await this.validateCSRF(req, context);
    }
  }

  // Sanitize input data
  sanitizeInput(input: any): any {
    if (typeof input === 'string') {
      let sanitized = input;

      // XSS protection
      if (this.config.xssProtection) {
        sanitized = this.sanitizeXSS(sanitized);
      }

      // SQL injection protection
      if (this.config.sqlInjectionProtection) {
        sanitized = this.sanitizeSQL(sanitized);
      }

      return sanitized;
    }

    if (Array.isArray(input)) {
      return input.map(item => this.sanitizeInput(item));
    }

    if (input && typeof input === 'object') {
      const sanitized: any = {};
      for (const [key, value] of Object.entries(input)) {
        sanitized[key] = this.sanitizeInput(value);
      }
      return sanitized;
    }

    return input;
  }

  // Generate CSRF token
  generateCSRFToken(userId: string): string {
    return this.csrfStore.generate(userId);
  }

  // Security headers for response
  getSecurityHeaders(): Record<string, string> {
    return {
      // XSS Protection
      'X-XSS-Protection': '1; mode=block',
      
      // Content Type Options
      'X-Content-Type-Options': 'nosniff',
      
      // Frame Options
      'X-Frame-Options': 'DENY',
      
      // Content Security Policy
      'Content-Security-Policy': this.getCSPHeader(),
      
      // Strict Transport Security (HTTPS only)
      ...(process.env.NODE_ENV === 'production' && {
        'Strict-Transport-Security': 'max-age=31536000; includeSubDomains; preload'
      }),
      
      // Referrer Policy
      'Referrer-Policy': 'strict-origin-when-cross-origin',
      
      // Permissions Policy
      'Permissions-Policy': 'camera=(), microphone=(), geolocation=()',
      
      // Remove server information
      'Server': 'ALCHM-API'
    };
  }

  // Private validation methods

  private enforceHttps(req: NextRequest, context: RequestContext): void {
    const url = new URL(req.url);
    if (url.protocol !== 'https:') {
      throw createApiError(
        ApiErrorCode.BAD_REQUEST,
        'HTTPS required',
        { protocol: url.protocol },
        'This endpoint requires a secure connection',
        context.requestId
      );
    }
  }

  private validateIpAddress(req: NextRequest, context: RequestContext): void {
    const ip = context.ip;

    // Check blacklist
    if (this.config.ipBlacklist?.includes(ip)) {
      throw createApiError(
        ApiErrorCode.FORBIDDEN,
        'IP address blocked',
        { ip },
        'Access denied',
        context.requestId
      );
    }

    // Check whitelist (if configured)
    if (this.config.ipWhitelist && this.config.ipWhitelist.length > 0) {
      if (!this.config.ipWhitelist.includes(ip)) {
        throw createApiError(
          ApiErrorCode.FORBIDDEN,
          'IP address not whitelisted',
          { ip },
          'Access denied',
          context.requestId
        );
      }
    }
  }

  private validateCors(req: NextRequest, context: RequestContext): void {
    const origin = req.headers.get('origin');
    
    if (origin && this.config.corsOrigins && this.config.corsOrigins.length > 0) {
      if (!this.config.corsOrigins.includes(origin)) {
        throw createApiError(
          ApiErrorCode.FORBIDDEN,
          'CORS origin not allowed',
          { origin },
          'Cross-origin request not allowed',
          context.requestId
        );
      }
    }
  }

  private validateHeaders(req: NextRequest, context: RequestContext): void {
    // Check for suspicious headers
    const suspiciousHeaders = [
      'x-forwarded-host',
      'x-original-url',
      'x-rewrite-url'
    ];

    for (const header of suspiciousHeaders) {
      if (req.headers.get(header)) {
        throw createApiError(
          ApiErrorCode.BAD_REQUEST,
          `Suspicious header detected: ${header}`,
          { header },
          'Invalid request headers',
          context.requestId
        );
      }
    }

    // Validate User-Agent
    const userAgent = req.headers.get('user-agent');
    if (!userAgent || userAgent.length < 10) {
      throw createApiError(
        ApiErrorCode.BAD_REQUEST,
        'Invalid or missing User-Agent',
        { userAgent },
        'Valid User-Agent header required',
        context.requestId
      );
    }
  }

  private validateContentType(req: NextRequest, context: RequestContext): void {
    const contentType = req.headers.get('content-type');
    
    if (!contentType) {
      throw createApiError(
        ApiErrorCode.BAD_REQUEST,
        'Missing Content-Type header',
        undefined,
        'Content-Type header is required',
        context.requestId
      );
    }

    const allowedTypes = [
      'application/json',
      'application/x-www-form-urlencoded',
      'multipart/form-data',
      'text/plain'
    ];

    const baseType = contentType.split(';')[0].toLowerCase();
    if (!allowedTypes.includes(baseType)) {
      throw createApiError(
        ApiErrorCode.BAD_REQUEST,
        `Unsupported Content-Type: ${baseType}`,
        { contentType },
        'Unsupported content type',
        context.requestId
      );
    }
  }

  private validateRequestSize(req: NextRequest, context: RequestContext): void {
    const contentLength = req.headers.get('content-length');
    
    if (contentLength) {
      const size = parseInt(contentLength, 10);
      if (size > this.config.requestSizeLimit!) {
        throw createApiError(
          ApiErrorCode.BAD_REQUEST,
          `Request too large: ${size} bytes`,
          { size, limit: this.config.requestSizeLimit },
          `Request size exceeds limit of ${Math.floor(this.config.requestSizeLimit! / 1024)}KB`,
          context.requestId
        );
      }
    }
  }

  private async validateCSRF(req: NextRequest, context: RequestContext): Promise<void> {
    // Skip CSRF for certain endpoints (e.g., webhooks)
    if (context.path.includes('/webhook')) {
      return;
    }

    const token = req.headers.get('x-csrf-token') || req.headers.get('csrf-token');
    
    if (!token) {
      throw createApiError(
        ApiErrorCode.FORBIDDEN,
        'CSRF token missing',
        undefined,
        'CSRF token required',
        context.requestId
      );
    }

    if (!context.userId) {
      throw createApiError(
        ApiErrorCode.UNAUTHORIZED,
        'User ID required for CSRF validation',
        undefined,
        'Authentication required',
        context.requestId
      );
    }

    if (!this.csrfStore.validate(context.userId, token)) {
      throw createApiError(
        ApiErrorCode.FORBIDDEN,
        'Invalid CSRF token',
        undefined,
        'CSRF token validation failed',
        context.requestId
      );
    }
  }

  private sanitizeXSS(input: string): string {
    // Basic XSS sanitization
    return input
      .replace(/[<>'"]/g, (char) => {
        const map: Record<string, string> = {
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#x27;'
        };
        return map[char] || char;
      })
      .replace(/javascript:/gi, '')
      .replace(/on\w+\s*=/gi, '');
  }

  private sanitizeSQL(input: string): string {
    // Basic SQL injection protection
    const sqlPatterns = [
      /(\b(ALTER|CREATE|DELETE|DROP|EXEC(UTE)?|INSERT( +INTO)?|MERGE|SELECT|UPDATE|UNION( +ALL)?)\b)/gi,
      /(;|'|"|`|\*|\/\*|\*\/|--)/g,
      /(\b(AND|OR)\b.*(\b(=|LIKE)\b))/gi
    ];

    let sanitized = input;
    for (const pattern of sqlPatterns) {
      sanitized = sanitized.replace(pattern, '');
    }

    return sanitized;
  }

  private getCSPHeader(): string {
    return [
      "default-src 'self'",
      "script-src 'self' 'unsafe-inline' 'unsafe-eval'", // Needed for Next.js
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data: https:",
      "font-src 'self' data:",
      "connect-src 'self' https:",
      "media-src 'self'",
      "object-src 'none'",
      "base-uri 'self'",
      "form-action 'self'",
      "frame-ancestors 'none'",
      "upgrade-insecure-requests"
    ].join('; ');
  }
}

// Input validation schemas
export const INPUT_VALIDATION_PATTERNS = {
  email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
  uuid: /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i,
  alphanumeric: /^[a-zA-Z0-9]+$/,
  noSpecialChars: /^[a-zA-Z0-9\s\-_.,!?()]+$/,
  safeHtml: /^[a-zA-Z0-9\s\-_.,!?()\[\]{}]+$/
};

// Rate limiting by user tier
export const SECURITY_TIERS = {
  free: {
    requestsPerMinute: 60,
    requestsPerHour: 1000,
    maxRequestSize: 512 * 1024, // 512KB
    allowedEndpoints: ['basic']
  },
  premium: {
    requestsPerMinute: 300,
    requestsPerHour: 10000,
    maxRequestSize: 2 * 1024 * 1024, // 2MB
    allowedEndpoints: ['basic', 'premium']
  },
  admin: {
    requestsPerMinute: 1000,
    requestsPerHour: 50000,
    maxRequestSize: 10 * 1024 * 1024, // 10MB
    allowedEndpoints: ['basic', 'premium', 'admin']
  }
};

// Honeypot fields for bot detection
export function validateHoneypot(input: any, context: RequestContext): void {
  const honeypotFields = ['email_confirm', 'phone_number', 'website_url'];
  
  for (const field of honeypotFields) {
    if (input[field] && input[field].length > 0) {
      throw createApiError(
        ApiErrorCode.FORBIDDEN,
        'Bot detected',
        { honeypotField: field },
        'Request rejected',
        context.requestId
      );
    }
  }
}

// Create security middleware
export function createSecurityMiddleware(config: SecurityConfig = {}) {
  const security = new ApiSecurity(config);

  return async (req: NextRequest, context: RequestContext) => {
    await security.validateRequest(req, context);
    return security;
  };
}

// Export singleton instance
export const defaultSecurity = new ApiSecurity({
  corsOrigins: process.env.ALLOWED_ORIGINS?.split(',') || [],
  requireHttps: process.env.NODE_ENV === 'production',
  ipBlacklist: process.env.IP_BLACKLIST?.split(',') || []
});