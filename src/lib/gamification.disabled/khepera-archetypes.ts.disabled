  private static detectCrisisLanguage(text: string): boolean {
    const lowerText = text.toLowerCase();
    return this.CRISIS_KEYWORDS.some(keyword => lowerText.includes(keyword));
  }
  
  private static getCrisisArchetype(): KheperaArchetype {
    return {
      id: 'crisis_guardian',
      name: 'The Crisis Guardian',
      title: 'Sacred Protector',
      description: 'Emergency response archetype for crisis situations',
      primaryGift: 'Immediate safety and crisis support',
      secondaryGifts: ['Professional resource connection', 'Emergency grounding', 'Safety planning'],
      voiceProfile: {
        tone: 'gentle',
        vocabulary: {
          affirmations: ["You matter deeply", "Help is available", "You are not alone"],
          transitions: ["Right now...", "In this moment...", "Please know..."],
          questionStems: ["Are you safe right now?", "What support do you need most?"],
          metaphors: ["protective shield", "safety net", "guiding light"],
          closingBlessings: ["You are valuable and worth fighting for"]
        },
        responseLength: 'brief',
        emotionalResonance: 'grounding',
        culturalSensitivity: 'universal'
      },
      responsePatterns: [{
        situationType: 'crisis',
        approach: { primary: 'comfort', secondary: 'guide' },
        exampleResponse: "I see you're in crisis. Please reach out for immediate support: 988 Suicide & Crisis Lifeline. You matter, and help is available.",
        avoidancePatterns: ['dismissing urgency', 'providing only platitudes']
      }],
      triggerConditions: [{
        userState: 'crisis' as any,
        journalPatterns: this.CRISIS_KEYWORDS,
        emotionalMarkers: ['suicidal', 'emergency', 'crisis'],
        timeContext: 'any'
      }],
      transformationPhase: {
        phase: 'dissolution',
        description: 'Creating immediate safety and stabilization',
        gifts: ['Safety', 'Hope', 'Connection to help'],
        challenges: ['Reaching out for help', 'Believing in worthiness of support'],
        duration: 'momentary'
      },
      symbology: {
        primarySymbol: '🛡️',
        secondarySymbols: ['🚨', '💙', '🤝'],
        colors: ['calming blue', 'warm red', 'safe green'],
        elementalAssociation: 'earth'
      }
    };
  }
  
  private static scoreArchetypeMatch(
    archetype: KheperaArchetype,
    journalEntry: string,
    userMood?: string,
    userProfile?: UserArchetypeProfile,
    emotionalState?: any,
    culturalContext?: string
  ): number {
    let score = 0;
    
    // Check trigger conditions
    for (const condition of archetype.triggerConditions) {
      if (condition.journalPatterns.some(pattern => 
        journalEntry.toLowerCase().includes(pattern.toLowerCase())
      )) {
        score += 0.4;
      }
      
      if (userMood && condition.emotionalMarkers.includes(userMood)) {
        score += 0.3;
      }
    }
    
    // User preferences
    if (userProfile?.preferredArchetypes.includes(archetype.id)) {
      score += 0.2;
    }
    
    if (userProfile?.avoidedArchetypes.includes(archetype.id)) {
      score -= 0.5;
    }
    
    // Transformation phase alignment
    if (userProfile?.personalizedGuidance.dominantTransformationPhase === archetype.transformationPhase.phase) {
      score += 0.1;
    }
    
    // Advanced emotional intelligence integration
    if (emotionalState) {
      // Shadow aspects alignment
      if (emotionalState.shadow_aspects?.integration_opportunity > 0.7 && archetype.id === 'shadow_integrator') {
        score += 0.3;
      }
      
      // Somatic awareness alignment
      if (emotionalState.somatic_markers?.embodied_awareness > 0.7 && archetype.id === 'somatic_healer') {
        score += 0.25;
      }
      
      // Neurological correlates alignment
      if (emotionalState.neurological_correlates?.prefrontal_activation > 0.8 && archetype.id === 'wise_challenger') {
        score += 0.2;
      }
      
      if (emotionalState.neurological_correlates?.mirror_neuron_activity > 0.8 && archetype.id === 'gentle_witness') {
        score += 0.2;
      }
    }
    
    // Cultural adaptation scoring
    if (culturalContext && archetype.culturalAdaptation.language_adaptations[culturalContext]) {
      score += 0.15;
    }
    
    // Developmental alignment scoring
    if (userProfile?.personalizedGuidance.dominantTransformationPhase) {
      const userPhase = userProfile.personalizedGuidance.dominantTransformationPhase;
      const archetypePhase = archetype.transformationPhase.phase;
      
      // Exact phase match gets highest score
      if (userPhase === archetypePhase) {
        score += 0.2;
      }
      // Adjacent phases get moderate score
      else if (this.isAdjacentPhase(userPhase, archetypePhase)) {
        score += 0.1;
      }
    }
    
    return Math.max(0, Math.min(1, score));
  }
  
  private static isArchetypeAvailable(archetypeId: string, userProfile?: UserArchetypeProfile): boolean {
    if (!userProfile) return true;
    
    const lastInteraction = userProfile.archetypeHistory
      .filter(interaction => interaction.archetypeId === archetypeId)
      .sort((a, b) => b.activatedAt.getTime() - a.activatedAt.getTime())[0];
    
    if (!lastInteraction) return true;
    
    const hoursSinceLastInteraction = (Date.now() - lastInteraction.activatedAt.getTime()) / (1000 * 60 * 60);
    return hoursSinceLastInteraction >= this.ARCHETYPE_COOLDOWN;
  }
  
  private static explainSelection(archetype: KheperaArchetype, journalEntry: string): string {
    return `${archetype.name} emerged because your reflection called for ${archetype.primaryGift.toLowerCase()}.`;
  }
  
  private static identifySituation(journalEntry: string, userMood?: string): ResponsePattern['situationType'] {
    const lowerEntry = journalEntry.toLowerCase();
    
    if (this.detectCrisisLanguage(journalEntry)) return 'crisis';
    if (lowerEntry.includes('breakthrough') || lowerEntry.includes('realize') || lowerEntry.includes('understand')) return 'breakthrough';
    if (lowerEntry.includes('stuck') || lowerEntry.includes('can\'t') || lowerEntry.includes('won\'t')) return 'resistance';
    if (lowerEntry.includes('celebrate') || lowerEntry.includes('proud') || lowerEntry.includes('achievement')) return 'celebration';
    if (lowerEntry.includes('confused') || lowerEntry.includes('don\'t know') || lowerEntry.includes('unclear')) return 'confusion';
    
    return 'integration';
  }
  
  private static personalizeMessage(
    archetype: KheperaArchetype,
    pattern: ResponsePattern,
    journalEntry: string,
    userProfile?: UserArchetypeProfile
  ): string {
    // This would use more sophisticated NLP and personalization in practice
    const vocabulary = archetype.voiceProfile.vocabulary;
    const affirmation = vocabulary.affirmations[Math.floor(Math.random() * vocabulary.affirmations.length)];
    const transition = vocabulary.transitions[Math.floor(Math.random() * vocabulary.transitions.length)];
    
    return `${transition} ${pattern.exampleResponse} ${affirmation}`;
  }
  
  private static generateFollowUpPrompt(archetype: KheperaArchetype, journalEntry: string): string {
    const questions = archetype.voiceProfile.vocabulary.questionStems;
    return questions[Math.floor(Math.random() * questions.length)] || "What feels most alive in this moment?";
  }
  
  private static generateBreathingSpace(archetype: KheperaArchetype): string {
    return "Take three slow breaths. Let this settle into your awareness.";
  }
  
  private static suggestNextArchetype(archetype: KheperaArchetype, situationType: string): string {
    // Advanced evolution logic with shadow integration
    if (archetype.evolutionPath) {
      for (const evolution of archetype.evolutionPath) {
        if (evolution.fromArchetype === archetype.id) {
          return evolution.toArchetype;
        }
      }
    }
    
    // Dynamic evolution based on situation
    if (archetype.id === 'gentle_witness' && situationType === 'breakthrough') {
      return 'wise_challenger';
    }
    if (archetype.id === 'wise_challenger' && situationType === 'integration') {
      return 'shadow_integrator';
    }
    if (archetype.id === 'shadow_integrator' && situationType === 'integration') {
      return 'mystical_guide';
    }
    if (archetype.id === 'nurturing_mother' && situationType === 'breakthrough') {
      return 'somatic_healer';
    }
    if (archetype.id === 'somatic_healer' && situationType === 'integration') {
      return 'shadow_integrator';
    }
    
    return archetype.id; // Stay with current archetype
  }
  
  /**
   * Detect shadow projection triggers in journal content
   */
  private static detectShadowTriggers(content: string): string[] {
    const shadowTriggers: string[] = [];
    const lowerContent = content.toLowerCase();
    
    // Projection language patterns
    const projectionPatterns = [
      'hate when people',
      'can\'t stand when',
      'disgusting when',
      'those people who',
      'why do they always',
      'people like that',
      'if only they',
      'they should',
      'everyone else',
      'people are so'
    ];
    
    projectionPatterns.forEach(pattern => {
      if (lowerContent.includes(pattern)) {
        shadowTriggers.push(`projection pattern: ${pattern}`);
      }
    });
    
    // Judgment and rejection language
    const judgmentPatterns = [
      'terrible',
      'awful',
      'disgusting',
      'pathetic',
      'weak',
      'selfish',
      'arrogant',
      'controlling'
    ];
    
    judgmentPatterns.forEach(pattern => {
      if (lowerContent.includes(pattern)) {
        shadowTriggers.push(`judgment: ${pattern}`);
      }
    });
    
    return shadowTriggers;
  }
  
  /**
   * Detect somatic/body-based content that suggests need for embodied support
   */
  private static detectSomaticTriggers(content: string): string[] {
    const somaticTriggers: string[] = [];
    const lowerContent = content.toLowerCase();
    
    const somaticPatterns = [
      'body feels',
      'tense',
      'tight',
      'nervous',
      'shaking',
      'breathing',
      'chest',
      'stomach',
      'heart racing',
      'energy',
      'exhausted',
      'drained',
      'numb',
      'disconnected from body',
      'can\'t feel',
      'sensation'
    ];
    
    somaticPatterns.forEach(pattern => {
      if (lowerContent.includes(pattern)) {
        somaticTriggers.push(pattern);
      }
    });
    
    return somaticTriggers;
  }
  
  /**
   * Identify shadow integration opportunity for selected archetype
   */
  private static identifyShadowIntegrationOpportunity(archetype: KheperaArchetype, journalEntry: string): string {
    const shadowAspects = archetype.shadowAspects;
    const lowerEntry = journalEntry.toLowerCase();
    
    // Check if user is exhibiting shadow patterns
    for (const trigger of shadowAspects.shadowTriggers) {
      if (lowerEntry.includes(trigger.toLowerCase())) {
        return `Integration opportunity: ${shadowAspects.shadowAspects.integration_gifts.join(', ')}`;
      }
    }
    
    // Check for projection patterns
    for (const projection of shadowAspects.projectionPatterns.common_projections) {
      if (lowerEntry.includes(projection.toLowerCase().slice(0, 10))) {
        return `Projection reclamation: ${projection}`;
      }
    }
    
    return shadowAspects.holisticWholeness.integrated_wholeness;
  }
  
  /**
   * Identify developmental edge for user
   */
  private static identifyDevelopmentalEdge(
    archetype: KheperaArchetype, 
    journalEntry: string, 
    userProfile?: UserArchetypeProfile
  ): string {
    const developmentalAlignment = archetype.developmentalAlignment;
    const lowerEntry = journalEntry.toLowerCase();
    
    // Check current edge indicators
    for (const indicator of developmentalAlignment.growth_edge_navigation.current_edge_indicators) {
      if (lowerEntry.includes(indicator.toLowerCase())) {
        return developmentalAlignment.growth_edge_navigation.next_developmental_invitation;
      }
    }
    
    // Check for trauma-informed considerations
    for (const trauma of developmentalAlignment.trauma_informed_considerations.trauma_response_awareness) {
      if (lowerEntry.includes(trauma.toLowerCase())) {
        return `Trauma-informed growth: ${developmentalAlignment.trauma_informed_considerations.window_of_tolerance_support.join(', ')}`;
      }
    }
    
    return developmentalAlignment.growth_edge_navigation.next_developmental_invitation;
  }
  
  /**
   * Check if two transformation phases are adjacent in development
   */
  private static isAdjacentPhase(phase1: string, phase2: string): boolean {
    const phaseOrder = ['dissolution', 'incubation', 'illumination', 'integration', 'emergence'];
    const index1 = phaseOrder.indexOf(phase1);
    const index2 = phaseOrder.indexOf(phase2);
    
    if (index1 === -1 || index2 === -1) return false;
    
    return Math.abs(index1 - index2) === 1;
  }
}

