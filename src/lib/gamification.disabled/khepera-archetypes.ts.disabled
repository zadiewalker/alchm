/**
 * ALCHM Khepera Archetype System
 * AI-powered transformational guides that adapt to user's healing journey
 */

export interface KheperaArchetype {
  id: string;
  name: string;
  title: string;
  description: string;
  primaryGift: string; // Core strength this archetype offers
  secondaryGifts: string[];
  voiceProfile: VoiceProfile;
  responsePatterns: ResponsePattern[];
  triggerConditions: TriggerCondition[];
  transformationPhase: TransformationPhase;
  symbology: ArchetypeSymbology;
  evolutionPath?: ArchetypeEvolution[];
  // Advanced shadow work integration
  shadowAspects: ShadowIntegrationProfile;
  multidimensionalProfile: MultidimensionalArchetypeProfile;
  culturalAdaptation: CulturalArchetypeAdaptation;
  developmentalStage: DevelopmentalAlignment;
}

export interface VoiceProfile {
  tone: 'gentle' | 'wise' | 'direct' | 'nurturing' | 'empowering' | 'mystical';
  vocabulary: VocabularySet;
  responseLength: 'brief' | 'moderate' | 'expansive';
  emotionalResonance: 'grounding' | 'uplifting' | 'challenging' | 'validating' | 'illuminating' | 'nurturing';
  culturalSensitivity: 'universal' | 'contextual';
}

export interface VocabularySet {
  affirmations: string[];
  transitions: string[];
  questionStems: string[];
  metaphors: string[];
  closingBlessings: string[];
}

export interface ResponsePattern {
  situationType: 'crisis' | 'breakthrough' | 'resistance' | 'celebration' | 'confusion' | 'integration';
  approach: ResponseApproach;
  exampleResponse: string;
  avoidancePatterns: string[]; // What this archetype never does
}

export interface ResponseApproach {
  primary: 'witness' | 'challenge' | 'comfort' | 'illuminate' | 'celebrate' | 'guide';
  secondary?: ResponseApproach['primary'];
  emergencyOverride?: ResponseApproach['primary']; // Crisis mode
}

export interface TriggerCondition {
  userState: 'overwhelmed' | 'breakthrough' | 'resistant' | 'curious' | 'celebrating' | 'integrating';
  journalPatterns: string[]; // Keywords/themes that activate this archetype
  emotionalMarkers: string[];
  timeContext: 'morning' | 'evening' | 'late_night' | 'any';
  durationSinceLastAppearance?: number; // Prevent over-activation
}

export interface TransformationPhase {
  phase: 'dissolution' | 'incubation' | 'illumination' | 'integration' | 'emergence';
  description: string;
  gifts: string[];
  challenges: string[];
  duration: 'momentary' | 'cycles' | 'extended' | 'lifelong';
}

export interface ArchetypeSymbology {
  primarySymbol: string; // Emoji or unicode
  secondarySymbols: string[];
  colors: string[];
  elementalAssociation: 'earth' | 'water' | 'fire' | 'air' | 'spirit';
  sacredGeometry?: string;
}

export interface ArchetypeEvolution {
  fromArchetype: string;
  toArchetype: string;
  catalyst: string;
  evolutionMessage: string;
}

// Advanced shadow work integration
export interface ShadowIntegrationProfile {
  shadowAspects: {
    suppressed_qualities: string[]; // What this archetype has learned to suppress
    projected_qualities: string[]; // What this archetype tends to project onto others
    integration_gifts: string[]; // Gifts that emerge when shadow is integrated
  };
  shadowTriggers: string[]; // What activates the shadow of this archetype
  integrationPractices: string[]; // Practices that help integrate shadow
  projectionPatterns: {
    common_projections: string[];
    recognition_signs: string[];
    reclamation_process: string[];
  };
  holisticWholeness: {
    light_qualities: string[];
    shadow_qualities: string[];
    integrated_wholeness: string;
    individuation_gifts: string[];
  };
}

// Multi-dimensional psychological development
export interface MultidimensionalArchetypeProfile {
  cognitiveStyle: {
    thinking_preference: 'analytical' | 'intuitive' | 'holistic' | 'creative' | 'systems';
    processing_speed: 'contemplative' | 'moderate' | 'rapid';
    complexity_tolerance: 'simple' | 'moderate' | 'complex' | 'paradoxical';
  };
  emotionalIntelligence: {
    self_awareness_level: number; // 0-1
    emotional_regulation: number;
    empathy_capacity: number;
    social_navigation: number;
  };
  somaticProfile: {
    body_awareness: 'disconnected' | 'emerging' | 'integrated' | 'mastery';
    energy_signature: 'grounded' | 'flowing' | 'dynamic' | 'transcendent';
    tension_patterns: string[];
    healing_modalities: string[];
  };
  spiritualDimension: {
    connection_to_transcendent: number; // 0-1
    meaning_making_style: 'personal' | 'interpersonal' | 'transpersonal' | 'cosmic';
    spiritual_practices: string[];
    mystical_openness: number; // 0-1
  };
}

// Cultural adaptation for global emotional intelligence
export interface CulturalArchetypeAdaptation {
  cultural_sensitivity: {
    collectivist_adaptation: ArchetypeVariation;
    individualist_adaptation: ArchetypeVariation;
    power_distance_sensitivity: ArchetypeVariation;
    uncertainty_avoidance_adaptation: ArchetypeVariation;
  };
  language_adaptations: Record<string, {
    vocabulary_shifts: string[];
    metaphor_adaptations: string[];
    cultural_concepts: string[];
    taboo_avoidances: string[];
  }>;
  healing_tradition_alignment: Record<string, string[]>; // Maps cultures to healing practices
}

export interface ArchetypeVariation {
  voice_modifications: Partial<VoiceProfile>;
  response_adaptations: string[];
  cultural_metaphors: string[];
  respectful_boundaries: string[];
}

// Developmental psychology integration
export interface DevelopmentalAlignment {
  spiral_dynamics_stage: 'survival' | 'tribal' | 'power' | 'order' | 'success' | 'community' | 'integral' | 'holistic';
  psychological_development: {
    ego_development_level: 'conformist' | 'conscientious' | 'individualistic' | 'autonomous' | 'integrated';
    moral_reasoning_level: 'preconventional' | 'conventional' | 'postconventional' | 'metaethical';
    cognitive_complexity: number; // 0-1
  };
  trauma_informed_considerations: {
    attachment_style_sensitivity: 'secure' | 'anxious' | 'avoidant' | 'disorganized' | 'all';
    trauma_response_awareness: string[];
    safety_prioritization: number; // 0-1
    window_of_tolerance_support: string[];
  };
  growth_edge_navigation: {
    current_edge_indicators: string[];
    next_developmental_invitation: string;
    integration_support: string[];
    regression_compassion: string[];
  };
}

export interface KheperaResponse {
  archetypeId: string;
  message: string;
  tone: VoiceProfile['tone'];
  followUpPrompt?: string;
  breathingSpace?: string; // Pause instruction
  emergencyEscalation?: boolean;
  nextArchetypeSuggestion?: string;
}

export interface UserArchetypeProfile {
  userId: string;
  activeArchetype?: string;
  archetypeHistory: ArchetypeInteraction[];
  personalizedGuidance: PersonalizedGuidance;
  avoidedArchetypes: string[]; // User preferences
  preferredArchetypes: string[];
  emergencyArchetype?: string; // Crisis default
}

export interface ArchetypeInteraction {
  archetypeId: string;
  activatedAt: Date;
  journalContext: string;
  userResponse?: string;
  helpfulnessRating?: number; // 1-5, optional
  completedAt?: Date;
}

export interface PersonalizedGuidance {
  dominantTransformationPhase: TransformationPhase['phase'];
  primaryGrowthAreas: string[];
  resistancePatterns: string[];
  celebrationPreferences: string[];
  communicationStyle: 'direct' | 'metaphorical' | 'questioning' | 'affirming';
}

export class KheperaArchetypeEngine {
  private static readonly ARCHETYPE_COOLDOWN = 24; // Hours between same archetype
  private static readonly CRISIS_KEYWORDS = [
    'suicide', 'kill myself', 'end it all', 'can\'t go on', 'hopeless', 
    'emergency', 'crisis', 'help me', 'desperate'
  ];
  
  /**
   * Select appropriate archetype with advanced shadow integration and multi-dimensional analysis
   */
  static selectArchetype(
    journalEntry: string,
    userMood?: string,
    timeOfDay?: 'morning' | 'evening' | 'late_night',
    userProfile?: UserArchetypeProfile,
    emotionalState?: any, // From advanced emotional intelligence system
    culturalContext?: string
  ): {
    archetype: KheperaArchetype;
    confidence: number;
    reasoning: string;
    shadowIntegrationOpportunity?: string;
    developmentalEdge?: string;
  } {
    // Crisis detection first
    if (this.detectCrisisLanguage(journalEntry)) {
      return {
        archetype: this.getCrisisArchetype(),
        confidence: 1.0,
        reasoning: "Crisis support activated. Your safety is priority.",
        shadowIntegrationOpportunity: "Crisis often emerges from suppressed needs or emotions",
        developmentalEdge: "Learning to ask for help and prioritize safety"
      };
    }
    
    // Shadow integration detection
    const shadowTriggers = this.detectShadowTriggers(journalEntry);
    if (shadowTriggers.length > 0) {
      const shadowArchetype = this.getArchetypeLibrary().find(a => a.id === 'shadow_integrator');
      if (shadowArchetype) {
        return {
          archetype: shadowArchetype,
          confidence: 0.9,
          reasoning: `Shadow integration opportunity detected: ${shadowTriggers.join(', ')}`,
          shadowIntegrationOpportunity: `Projection reclamation available for: ${shadowTriggers.join(', ')}`,
          developmentalEdge: "Integrating disowned aspects for wholeness"
        };
      }
    }
    
    // Somatic/body-based triggers
    const somaticTriggers = this.detectSomaticTriggers(journalEntry);
    if (somaticTriggers.length > 0) {
      const somaticArchetype = this.getArchetypeLibrary().find(a => a.id === 'somatic_healer');
      if (somaticArchetype) {
        return {
          archetype: somaticArchetype,
          confidence: 0.85,
          reasoning: `Somatic integration needed: ${somaticTriggers.join(', ')}`,
          shadowIntegrationOpportunity: "Body wisdom integration with mental processing",
          developmentalEdge: "Embodying emotional experience"
        };
      }
    }
    
    const archetypes = this.getArchetypeLibrary();
    const scoredArchetypes = archetypes.map(archetype => ({
      archetype,
      score: this.scoreArchetypeMatch(
        archetype, 
        journalEntry, 
        userMood, 
        userProfile, 
        emotionalState, 
        culturalContext
      )
    }));
    
    // Sort by score and apply cooldown filters
    const availableArchetypes = scoredArchetypes
      .filter(({ archetype }) => this.isArchetypeAvailable(archetype.id, userProfile))
      .sort((a, b) => b.score - a.score);
    
    const selected = availableArchetypes[0];
    
    if (!selected) {
      // Fallback to gentle witness if no selection is available
      const fallbackArchetype = this.getArchetypeLibrary().find(a => a.id === 'gentle_witness') || this.getCrisisArchetype();
      return {
        archetype: fallbackArchetype,
        confidence: 0.5,
        reasoning: "Default supportive presence activated.",
        shadowIntegrationOpportunity: "All experiences offer integration opportunities",
        developmentalEdge: "Present moment awareness and self-compassion"
      };
    }
    
    // Detect potential shadow and developmental opportunities
    const shadowOpportunity = this.identifyShadowIntegrationOpportunity(selected.archetype, journalEntry);
    const developmentalEdge = this.identifyDevelopmentalEdge(selected.archetype, journalEntry, userProfile);
    
    return {
      archetype: selected.archetype,
      confidence: selected.score,
      reasoning: this.explainSelection(selected.archetype, journalEntry),
      shadowIntegrationOpportunity: shadowOpportunity,
      developmentalEdge: developmentalEdge
    };
  }
  
  /**
   * Generate personalized response from selected archetype
   */
  static generateArchetypeResponse(
    archetype: KheperaArchetype,
    journalEntry: string,
    userMood?: string,
    userProfile?: UserArchetypeProfile
  ): KheperaResponse {
    const situationType = this.identifySituation(journalEntry, userMood);
    const pattern = archetype.responsePatterns.find(p => p.situationType === situationType) ||
                   archetype.responsePatterns[0];
    
    if (!pattern) {
      // Fallback pattern if none found
      const fallbackPattern = {
        situationType: 'integration' as const,
        approach: { primary: 'witness' as const },
        exampleResponse: "I see you in this moment. Your experience is valid and witnessed.",
        avoidancePatterns: []
      };
      
      const personalizedMessage = this.personalizeMessage(
        archetype,
        fallbackPattern,
        journalEntry,
        userProfile
      );
      
      return {
        archetypeId: archetype.id,
        message: personalizedMessage,
        tone: archetype.voiceProfile.tone,
        followUpPrompt: this.generateFollowUpPrompt(archetype, journalEntry),
        breathingSpace: this.generateBreathingSpace(archetype),
        emergencyEscalation: this.detectCrisisLanguage(journalEntry),
        nextArchetypeSuggestion: this.suggestNextArchetype(archetype, situationType)
      };
    }
    
    const personalizedMessage = this.personalizeMessage(
      archetype,
      pattern,
      journalEntry,
      userProfile
    );
    
    return {
      archetypeId: archetype.id,
      message: personalizedMessage,
      tone: archetype.voiceProfile.tone,
      followUpPrompt: this.generateFollowUpPrompt(archetype, journalEntry),
      breathingSpace: this.generateBreathingSpace(archetype),
      emergencyEscalation: this.detectCrisisLanguage(journalEntry),
      nextArchetypeSuggestion: this.suggestNextArchetype(archetype, situationType)
    };
  }
  
