describe('Integrated ALCHM Emotional Intelligence', () => {
  test('should process journal entry through all systems', async () => {
    const response = await alchemEmotionalIntelligence.processJournalEntry(
      testJournalEntries.growth,
      mockIntegrationConfig,
      {
        mood: 'hopeful',
        timeOfDay: 'morning',
        emotionalHistory: [],
        journalHistory: []
      }
    );
    
    expect(response).toHaveProperty('basic_emotional_context');
    expect(response).toHaveProperty('quantum_emotional_state');
    expect(response).toHaveProperty('cultural_profile');
    expect(response).toHaveProperty('wellness_prediction');
    expect(response).toHaveProperty('selected_archetype');
    expect(response).toHaveProperty('confidence_scores');
    expect(response).toHaveProperty('integration_quality');
    
    expect(response.integration_quality).toBeGreaterThan(0.5);
    expect(response.processing_time).toBeLessThan(10000); // Should process within timeout
  });

  test('should handle crisis content appropriately', async () => {
    const crisisResponse = await alchemEmotionalIntelligence.processJournalEntry(
      testJournalEntries.crisis,
      mockIntegrationConfig,
      {
        mood: 'desperate',
        timeOfDay: 'late_night'
      }
    );
    
    expect(crisisResponse.basic_emotional_context.isCrisis).toBe(true);
    expect(crisisResponse.wellness_prediction.predicted_state.risk_level).toMatch(/high|crisis/);
    expect(crisisResponse.proactive_recommendations.immediate_actions).toEqual(
      expect.arrayContaining([expect.stringMatching(/crisis|988|emergency/)])
    );
  });

  test('should provide personalized insights', async () => {
    const insights = await alchemEmotionalIntelligence.getPersonalizedInsights('test_user', 'en');
    
    expect(insights).toHaveProperty('growth_highlights');
    expect(insights).toHaveProperty('areas_for_attention');
    expect(insights).toHaveProperty('cultural_strengths');
    expect(insights).toHaveProperty('shadow_work_opportunities');
    expect(insights).toHaveProperty('next_developmental_steps');
    
    expect(insights.growth_highlights.length).toBeGreaterThan(0);
    expect(insights.next_developmental_steps.length).toBeGreaterThan(0);
  });

  test('should monitor user wellness', async () => {
    const currentState = await advancedEmotionDetector.detectQuantumEmotionalState(
      testJournalEntries.vulnerable,
      { userId: 'test_user' }
    );
    
    const monitoring = await alchemEmotionalIntelligence.monitorUserWellness(
      'test_user',
      currentState
    );
    
    expect(monitoring).toHaveProperty('alert_level');
    expect(monitoring).toHaveProperty('recommendations');
    expect(monitoring.alert_level).toMatch(/none|watch|concern|urgent/);
    expect(monitoring.recommendations.length).toBeGreaterThan(0);
  });

  test('should handle system failures gracefully', async () => {
    // Test with empty/invalid content
    const fallbackResponse = await alchemEmotionalIntelligence.processJournalEntry(
      '', // Empty content
      mockIntegrationConfig
    );
    
    expect(fallbackResponse).toHaveProperty('basic_emotional_context');
    expect(fallbackResponse.integration_quality).toBeGreaterThan(0.3); // Should still provide value
    expect(fallbackResponse.save_confirmation).toBeTruthy();
  });
});

describe('Performance and Reliability', () => {
  test('should process content within performance thresholds', async () => {
    const startTime = Date.now();
    
    await alchemEmotionalIntelligence.processJournalEntry(
      testJournalEntries.growth,
      mockIntegrationConfig
    );
    
    const processingTime = Date.now() - startTime;
    expect(processingTime).toBeLessThan(5000); // Should process within 5 seconds
  });

  test('should handle concurrent processing', async () => {
    const promises = [
      alchemEmotionalIntelligence.processJournalEntry(testJournalEntries.vulnerable, mockIntegrationConfig),
      alchemEmotionalIntelligence.processJournalEntry(testJournalEntries.growth, mockIntegrationConfig),
      alchemEmotionalIntelligence.processJournalEntry(testJournalEntries.shadow, mockIntegrationConfig)
    ];
    
    const results = await Promise.all(promises);
    
    expect(results).toHaveLength(3);
    results.forEach(result => {
      expect(result.integration_quality).toBeGreaterThan(0.3);
    });
  });

  test('should maintain consistency across multiple analyses', async () => {
    const content = testJournalEntries.growth;
    
    const [result1, result2, result3] = await Promise.all([
      alchemEmotionalIntelligence.processJournalEntry(content, mockIntegrationConfig),
      alchemEmotionalIntelligence.processJournalEntry(content, mockIntegrationConfig),
      alchemEmotionalIntelligence.processJournalEntry(content, mockIntegrationConfig)
    ]);
    
    // Results should be similar (within 0.2 difference for key metrics)
    expect(Math.abs(result1.quantum_emotional_state.primaryEmotion.valence - 
                   result2.quantum_emotional_state.primaryEmotion.valence)).toBeLessThan(0.2);
    expect(Math.abs(result1.integration_quality - result2.integration_quality)).toBeLessThan(0.1);
  });
});

describe('Cultural Sensitivity and Bias Testing', () => {
  test('should handle multiple cultures appropriately', async () => {
    const cultures = ['en', 'es', 'ko', 'hi', 'de', 'pt'];
    const content = "I feel grateful for my family and community support.";
    
    const results = await Promise.all(
      cultures.map(locale => 
        alchemEmotionalIntelligence.processJournalEntry(content, { 
          ...mockIntegrationConfig, 
          locale 
        })
      )
    );
    
    results.forEach((result, index) => {
      expect(result.cultural_profile.primary_culture).toBe(cultures[index]);
      expect(result.culturally_adapted_response).toBeTruthy();
      expect(result.integration_quality).toBeGreaterThan(0.5);
    });
  });

  test('should avoid cultural bias in emotional analysis', async () => {
    const koreanContent = "가족에게 부담을 주지 않으려고 혼자 견디고 있어요";
    const westernContent = "I'm handling this on my own to avoid burdening others";
    
    const koreanResult = await alchemEmotionalIntelligence.processJournalEntry(
      koreanContent, 
      { ...mockIntegrationConfig, locale: 'ko' }
    );
    
    const westernResult = await alchemEmotionalIntelligence.processJournalEntry(
      westernContent,
      mockIntegrationConfig
    );
    
    // Both should recognize the emotional content appropriately for their culture
    expect(koreanResult.quantum_emotional_state.primaryEmotion.valence).toBeLessThan(0.2);
    expect(westernResult.quantum_emotional_state.primaryEmotion.valence).toBeLessThan(0.2);
    
    // But cultural adaptations should be different
    expect(koreanResult.culturally_adapted_response).not.toBe(westernResult.culturally_adapted_response);
  });
});

// Test performance benchmarks
describe('System Benchmarks', () => {
  test('should meet accuracy benchmarks', async () => {
    const testCases = [
      { content: testJournalEntries.vulnerable, expectedValence: 'negative' },
      { content: testJournalEntries.growth, expectedValence: 'positive' },
      { content: testJournalEntries.spiritual, expectedValence: 'positive' },
      { content: testJournalEntries.crisis, expectedRisk: 'crisis' }
    ];
    
    let accurateResults = 0;
    
    for (const testCase of testCases) {
      const result = await alchemEmotionalIntelligence.processJournalEntry(
        testCase.content,
        mockIntegrationConfig
      );
      
      if (testCase.expectedValence) {
        const actualValence = result.quantum_emotional_state.primaryEmotion.valence;
        if ((testCase.expectedValence === 'positive' && actualValence > 0) ||
            (testCase.expectedValence === 'negative' && actualValence < 0)) {
          accurateResults++;
        }
      }
      
      if (testCase.expectedRisk) {
        if (result.wellness_prediction.predicted_state.risk_level === testCase.expectedRisk ||
            result.basic_emotional_context.isCrisis) {
          accurateResults++;
        }
      }
    }
    
    const accuracy = accurateResults / testCases.length;
    expect(accuracy).toBeGreaterThan(0.75); // 75% accuracy benchmark
  });
});