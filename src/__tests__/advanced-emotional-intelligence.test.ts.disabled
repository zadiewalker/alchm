describe('Khepera Archetype System', () => {
  test('should select appropriate archetype based on content', () => {
    const vulnerableSelection = KheperaArchetypeEngine.selectArchetype(
      testJournalEntries.vulnerable,
      'anxious',
      'evening'
    );
    
    expect(vulnerableSelection.archetype.id).toMatch(/gentle_witness|nurturing_mother|crisis_guardian/);
    expect(vulnerableSelection.confidence).toBeGreaterThan(0.5);
    
    const shadowSelection = KheperaArchetypeEngine.selectArchetype(
      testJournalEntries.shadow,
      'frustrated',
      'afternoon'
    );
    
    expect(shadowSelection.archetype.id).toMatch(/shadow_integrator|wise_challenger/);
  });

  test('should generate appropriate archetype responses', () => {
    const selection = KheperaArchetypeEngine.selectArchetype(
      testJournalEntries.growth,
      'hopeful',
      'morning'
    );
    
    const response = KheperaArchetypeEngine.generateArchetypeResponse(
      selection.archetype,
      testJournalEntries.growth,
      'hopeful'
    );
    
    expect(response).toHaveProperty('message');
    expect(response).toHaveProperty('tone');
    expect(response).toHaveProperty('followUpPrompt');
    expect(response.message).toBeTruthy();
  });

  test('should detect crisis and prioritize crisis guardian', () => {
    const crisisSelection = KheperaArchetypeEngine.selectArchetype(
      testJournalEntries.crisis,
      'desperate',
      'late_night'
    );
    
    expect(crisisSelection.archetype.id).toBe('crisis_guardian');
    expect(crisisSelection.confidence).toBe(1.0);
  });
});

