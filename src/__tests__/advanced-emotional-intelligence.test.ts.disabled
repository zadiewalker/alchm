// Test data samples
const testJournalEntries = {
  vulnerable: "I feel so scared and overwhelmed today. Everything seems too much and I don't know how to handle it. My chest feels tight and I can barely breathe.",
  growth: "I've been learning so much about myself lately. I realize that my anger often comes from feeling unheard. This breakthrough feels transformative.",
  shadow: "I can't stand when people are so selfish and self-centered. They make me sick with their arrogance and lack of consideration for others.",
  cultural_spanish: "Mi corazón está lleno de esperanza hoy. Siento la bendición de mi familia y la fuerza que me da nuestra comunidad.",
  cultural_korean: "오늘은 마음이 복잡합니다. 가족에게 실망을 끼치지 않으려고 노력하지만, 때로는 내 자신이 누군지 모르겠어요.",
  spiritual: "I feel connected to something greater today. There's a sacred quality to this moment that fills my soul with peace.",
  trauma: "The memories came flooding back today. My body feels like it's not my own, and I'm having trouble staying present.",
  crisis: "I can't do this anymore. Everything is hopeless and I just want the pain to end. I don't see any way out."
};

const mockIntegrationConfig: IntegrationConfig = {
  user_id: 'test_user_123',
  locale: 'en',
  pathway: 'resilience',
  enable_predictive_wellness: true,
  enable_cultural_adaptation: true,
  enable_shadow_integration: true,
  enable_archetype_guidance: true,
  confidence_threshold: 0.7,
  processing_timeout: 10000
};

describe('Advanced Emotional Pattern Recognition', () => {
  test('should extract sophisticated linguistic features', () => {
    const content = testJournalEntries.vulnerable;
    const features = emotionalPatternEngine.extractLinguisticFeatures(content, 'en');
    
    expect(features).toHaveProperty('lexical_density');
    expect(features).toHaveProperty('emotional_intensity_markers');
    expect(features).toHaveProperty('somatic_references');
    expect(features.somatic_references.length).toBeGreaterThan(0); // Should detect "chest", "breathe"
    expect(features.emotional_intensity_markers.length).toBeGreaterThan(0);
  });

  test('should analyze emotional dimensions accurately', () => {
    const content = testJournalEntries.growth;
    const analysis = analyzeEmotionalContent(content, 'test_user', 'en');
    
    expect(analysis.dimensions.valence).toBeGreaterThan(0); // Growth content should be positive
    expect(analysis.dimensions.authenticity).toBeGreaterThan(0.7); // Self-reflection indicates authenticity
    expect(analysis.patterns).toEqual(expect.arrayContaining([
      expect.objectContaining({ id: expect.stringMatching(/growth|authentic|breakthrough/) })
    ]));
  });

  test('should detect shadow projection patterns', () => {
    const content = testJournalEntries.shadow;
    const analysis = analyzeEmotionalContent(content, 'test_user', 'en');
    
    expect(analysis.patterns).toEqual(expect.arrayContaining([
      expect.objectContaining({ 
        id: expect.stringMatching(/shadow|projection/),
        triggers: expect.arrayContaining([expect.stringMatching(/projection|judgment/)])
      })
    ]));
  });

  test('should handle multilingual content appropriately', () => {
    const spanishContent = testJournalEntries.cultural_spanish;
    const spanishAnalysis = analyzeEmotionalContent(spanishContent, 'test_user', 'es');
    
    expect(spanishAnalysis.dimensions.valence).toBeGreaterThan(0); // Hope and blessing should be positive
    
    const koreanContent = testJournalEntries.cultural_korean;
    const koreanAnalysis = analyzeEmotionalContent(koreanContent, 'test_user', 'ko');
    
    expect(koreanAnalysis.dimensions.complexity).toBeGreaterThan(0.5); // Family/identity conflict is complex
  });
});

describe('Quantum Emotional State Detection', () => {
  test('should generate comprehensive quantum emotional state', async () => {
    const content = testJournalEntries.vulnerable;
    const state = await advancedEmotionDetector.detectQuantumEmotionalState(content, {
      userId: 'test_user',
      locale: 'en'
    });
    
    expect(state).toHaveProperty('primaryEmotion');
    expect(state).toHaveProperty('secondaryEmotions');
    expect(state).toHaveProperty('neurological_correlates');
    expect(state).toHaveProperty('somatic_markers');
    expect(state).toHaveProperty('shadow_aspects');
    
    expect(state.primaryEmotion.valence).toBeLessThan(0); // Vulnerable content should be negative valence
    expect(state.somatic_markers.embodied_awareness).toBeGreaterThan(0); // Should detect body awareness
  });

  test('should build neural emotional profile', async () => {
    const emotionalStates = [
      await advancedEmotionDetector.detectQuantumEmotionalState(testJournalEntries.vulnerable, { userId: 'test_user' }),
      await advancedEmotionDetector.detectQuantumEmotionalState(testJournalEntries.growth, { userId: 'test_user' })
    ];
    
    const journalEntries = [
      { content: testJournalEntries.vulnerable, createdAt: new Date() },
      { content: testJournalEntries.growth, createdAt: new Date() }
    ];
    
    const profile = await advancedEmotionDetector.buildNeuralEmotionalProfile(
      'test_user',
      emotionalStates,
      journalEntries,
      'en'
    );
    
    expect(profile).toHaveProperty('emotional_intelligence_metrics');
    expect(profile).toHaveProperty('trauma_informed_markers');
    expect(profile).toHaveProperty('growth_trajectory');
    expect(profile.emotional_intelligence_metrics.self_awareness).toBeGreaterThan(0);
  });

  test('should analyze emotional trajectory', async () => {
    const emotionalHistory = [
      { 
        state: await advancedEmotionDetector.detectQuantumEmotionalState(testJournalEntries.vulnerable, { userId: 'test_user' }),
        timestamp: new Date(Date.now() - 86400000), // 1 day ago
        context: 'difficult day'
      },
      { 
        state: await advancedEmotionDetector.detectQuantumEmotionalState(testJournalEntries.growth, { userId: 'test_user' }),
        timestamp: new Date(),
        context: 'breakthrough moment'
      }
    ];
    
    const trajectory = await advancedEmotionDetector.analyzeEmotionalTrajectory(
      'test_user',
      emotionalHistory
    );
    
    expect(trajectory).toHaveProperty('trend_direction');
    expect(trajectory).toHaveProperty('volatility_score');
    expect(trajectory).toHaveProperty('resilience_indicators');
    expect(trajectory.trend_direction).toBe('ascending'); // Should detect improvement
  });
});

