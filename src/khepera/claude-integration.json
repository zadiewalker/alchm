        "symbols": ["☯️", "🕉️", "🧘‍♀️"],
        "philosophies": ["taoism", "buddhism", "hinduism"],
        "adaptations": "balance, non-attachment, mindfulness practices"
      },
      "indigenous_wisdom": {
        "symbols": ["🦅", "🐺", "🌿"],
        "philosophies": ["animism", "shamanism", "earth_connection"],
        "adaptations": "ancestral honor, seven generations, earth connection"
      },
      "mystical_traditions": {
        "symbols": ["🔮", "⭐", "🌙"],
        "philosophies": ["hermeticism", "kabbalah", "sufism"],
        "adaptations": "sacred geometry, divine union, mystical symbolism"
      },
      "scientific_worldview": {
        "symbols": ["🔬", "🌌", "⚛️"],
        "philosophies": ["systems_thinking", "emergence_theory", "quantum_mechanics"],
        "adaptations": "evidence-based language, systems approach, empirical curiosity"
      }
    },
    "safety_protocols": {
      "crisis_triggers": ["session_type_crisis", "repeated_patterns", "safety_concerns"],
      "therapeutic_boundaries": ["validate_experience", "cultural_respect", "trauma_informed", "support_agency"],
      "required_flags_by_mood": {
        "ashamed": ["shame_spiral_pattern", "self_compassion_needed"],
        "angry": ["anger_management", "boundary_work_needed"],
        "grieving": ["grief_support", "meaning_making_support"],
