    "api_compatibility": {
      "openai": {
        "function_calling": true,
        "structured_outputs": true,
        "json_mode": true
      },
      "claude": {
        "tool_use": true,
        "json_parsing": true,
        "context_awareness": true
      },
      "gemini": {
        "function_declarations": true,
        "structured_generation": true,
        "safety_filters": true
      }
    },
    "implementation_details": {
      "typescript_modules": [
        "mood-routing-engine.ts",
        "routing-decision-tree.ts", 
        "prompt-shells.ts",
        "archetype-config.ts"
      ],
      "main_function": "route_mood_to_archetype",
      "prompt_generator": "generate_contextual_prompt",
      "archetype_library": "KHEPERA_ARCHETYPES"
    }
  }
}