{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alchm.app/schemas/reflection-export.json",
  "title": "ALCHM Reflection Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentTitle",
    "generatedAt",
    "exportVersion",
    "purpose",
    "whatHasBeenPresent",
    "recurringThreads",
    "emotionalLandscape",
    "selectedExcerpts",
    "conversationOpenings",
    "boundaryNote"
  ],
  "properties": {
    "documentTitle": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "exportVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 24,
      "maxLength": 220
    },
    "whatHasBeenPresent": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "recurringThreads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 12,
        "maxLength": 220
      }
    },
    "emotionalLandscape": {
      "type": "string",
      "minLength": 30,
      "maxLength": 800
    },
    "selectedExcerpts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceType",
          "createdAt",
          "excerpt"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "journal_entry",
              "khepera_reflection",
              "return"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "conversationOpenings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 12,
        "maxLength": 220
      }
    },
    "userNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "boundaryNote": {
      "type": "string",
      "const": "This summary was generated from material the user explicitly selected for export. It is intended as a reflection aid, not as diagnosis or treatment guidance."
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedSourceIds",
        "selectedExcerptIds",
        "sourceCount",
        "excerptCount"
      ],
      "properties": {
        "selectedSourceIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "selectedExcerptIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "sourceCount": {
          "type": "number"
        },
        "excerptCount": {
          "type": "number"
        }
      }
    }
  }
}
