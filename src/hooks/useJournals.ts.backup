'use client';

import { useState, useEffect, useCallback, useRef } from 'react';
import { firestoreClient } from '@/lib/firestoreClient';
import { journalCache } from '@/lib/cache';
import {
  JournalEntry,
  JournalQueryOptions,
  SubscriptionOptions,
  DatabaseError,
  SubscriptionState
} from '@/types/journal';

interface UseJournalsOptions extends JournalQueryOptions {
  enableRealtime?: boolean;
  enableCache?: boolean;
  subscriptionOptions?: SubscriptionOptions;
}

interface UseJournalsResult {
  entries: JournalEntry[];
  loading: boolean;
  error: DatabaseError | null;
  subscriptionState: SubscriptionState;
  // Actions
  createEntry: (entry: Omit<JournalEntry, 'id' | 'userId' | 'createdAt' | 'updatedAt' | 'version'>) => Promise<string>;
  updateEntry: (entryId: string, updates: Partial<JournalEntry>) => Promise<void>;
  deleteEntry: (entryId: string) => Promise<void>;
  refreshEntries: () => Promise<void>;
  loadMore: () => Promise<void>;
  // State
  hasMore: boolean;
  isLoadingMore: boolean;
}

export function useJournals(
  userId: string, 
  options: UseJournalsOptions = {}
): UseJournalsResult {
  const {
    enableRealtime = true,
    enableCache = true,
    subscriptionOptions,
    ...queryOptions
  } = options;

  const [entries, setEntries] = useState<JournalEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<DatabaseError | null>(null);
  const [hasMore, setHasMore] = useState(true);
  const [isLoadingMore, setIsLoadingMore] = useState(false);
  const [subscriptionState, setSubscriptionState] = useState<SubscriptionState>({
    isActive: false,
    isOnline: navigator.onLine,
    lastUpdate: null,
    error: null,
    pendingChanges: 0
  });

  const subscriptionIdRef = useRef<string | null>(null);
  const lastDocIdRef = useRef<string | null>(null);

  // Load cached entries on mount
  useEffect(() => {
    if (enableCache && userId) {
      const cached = journalCache.getJournals(userId);
      if (cached && cached.length > 0) {
        setEntries(cached);
        setLoading(false);
      }
    }
  }, [userId, enableCache]);

  // Setup real-time subscription or fetch data
  useEffect(() => {
    if (!userId) return;

    const setupData = async () => {
      try {
        if (enableRealtime) {
          // Setup real-time subscription
          const subscriptionId = firestoreClient.subscribeToEntries(
            userId,
            {
              maxEntries: queryOptions.limit || 20,
              onlyRecent: subscriptionOptions?.onlyRecent,
              ...subscriptionOptions
            },
            (newEntries, subscriptionError) => {
              if (subscriptionError) {
                setError(subscriptionError);
                setSubscriptionState(prev => ({
                  ...prev,
                  error: subscriptionError.message
                }));
              } else {
                setEntries(newEntries);
                setError(null);
                setHasMore(newEntries.length === (queryOptions.limit || 20));
                
                // Update last document ID for pagination
                if (newEntries.length > 0) {
                  lastDocIdRef.current = newEntries[newEntries.length - 1].id;
                }

                // Cache the entries
                if (enableCache) {
                  journalCache.setJournals(userId, newEntries);
                }

                // Update subscription state
                setSubscriptionState(firestoreClient.getSubscriptionState());
              }
              setLoading(false);
            }
          );

          subscriptionIdRef.current = subscriptionId;
          setSubscriptionState(prev => ({ ...prev, isActive: true }));
        } else {
          // One-time fetch
          const fetchedEntries = await firestoreClient.getEntries(userId, queryOptions);
          setEntries(fetchedEntries);
          setHasMore(fetchedEntries.length === (queryOptions.limit || 20));
          
          if (fetchedEntries.length > 0) {
            lastDocIdRef.current = fetchedEntries[fetchedEntries.length - 1].id;
          }

          if (enableCache) {
            journalCache.setJournals(userId, fetchedEntries);
          }
          
          setLoading(false);
        }
      } catch (err) {
        const dbError = err as DatabaseError;
        setError(dbError);
        setLoading(false);
      }
    };

    setupData();

    // Cleanup subscription on unmount
    return () => {
      if (subscriptionIdRef.current) {
        firestoreClient.unsubscribe(subscriptionIdRef.current);
        subscriptionIdRef.current = null;
      }
    };
  }, [userId, enableRealtime, JSON.stringify(queryOptions), JSON.stringify(subscriptionOptions)]);

  // Create entry with optimistic updates
  const createEntry = useCallback(async (
    entryData: Omit<JournalEntry, 'id' | 'userId' | 'createdAt' | 'updatedAt' | 'version'>
  ): Promise<string> => {
    try {
      setError(null);
      
      const tempId = `temp_${Date.now()}`;
      const now = new Date();
      
      // Optimistic update
      const optimisticEntry: JournalEntry = {
        id: tempId,
        userId,
        createdAt: now,
        updatedAt: now,
        version: 1,
        ...entryData
      };

      if (!enableRealtime) {
        setEntries(prev => [optimisticEntry, ...prev]);
      }

      // Create in Firestore
      const actualId = await firestoreClient.createEntry({
        userId,
        ...entryData
      });

      // Update optimistic entry with real ID if not using real-time
      if (!enableRealtime) {
        setEntries(prev => prev.map(entry => 
          entry.id === tempId ? { ...entry, id: actualId } : entry
        ));
      }

      // Invalidate cache
      if (enableCache) {
        journalCache.invalidateJournals(userId);
      }

      return actualId;
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
      
      // Remove optimistic entry on error
      if (!enableRealtime) {
        setEntries(prev => prev.filter(entry => !entry.id.startsWith('temp_')));
      }
      
      throw dbError;
    }
  }, [userId, enableRealtime, enableCache]);

  // Update entry with optimistic updates
  const updateEntry = useCallback(async (
    entryId: string, 
    updates: Partial<JournalEntry>
  ): Promise<void> => {
    try {
      setError(null);
      
      // Optimistic update
      if (!enableRealtime) {
        setEntries(prev => prev.map(entry => 
          entry.id === entryId 
            ? { ...entry, ...updates, updatedAt: new Date() }
            : entry
        ));
      }

      // Update in Firestore
      await firestoreClient.updateEntry(userId, entryId, updates);

      // Invalidate cache
      if (enableCache) {
        journalCache.invalidateJournals(userId);
      }
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
      
      // Revert optimistic update on error (would need original data)
      if (!enableRealtime) {
        await refreshEntries();
      }
      
      throw dbError;
    }
  }, [userId, enableRealtime, enableCache]);

  // Delete entry with optimistic updates
  const deleteEntry = useCallback(async (entryId: string): Promise<void> => {
    try {
      setError(null);
      
      // Store entry for potential rollback
      const entryToDelete = entries.find(e => e.id === entryId);
      
      // Optimistic update
      if (!enableRealtime) {
        setEntries(prev => prev.filter(entry => entry.id !== entryId));
      }

      // Delete from Firestore
      await firestoreClient.deleteEntry(userId, entryId);

      // Invalidate cache
      if (enableCache) {
        journalCache.invalidateJournals(userId);
      }
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
      
      // Restore entry on error
      if (!enableRealtime) {
        await refreshEntries();
      }
      
      throw dbError;
    }
  }, [userId, entries, enableRealtime, enableCache]);

  // Refresh entries manually
  const refreshEntries = useCallback(async (): Promise<void> => {
    try {
      setLoading(true);
      setError(null);
      
      const freshEntries = await firestoreClient.getEntries(userId, queryOptions);
      setEntries(freshEntries);
      setHasMore(freshEntries.length === (queryOptions.limit || 20));
      
      if (freshEntries.length > 0) {
        lastDocIdRef.current = freshEntries[freshEntries.length - 1].id;
      }

      if (enableCache) {
        journalCache.setJournals(userId, freshEntries);
      }
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
    } finally {
      setLoading(false);
    }
  }, [userId, JSON.stringify(queryOptions), enableCache]);

  // Load more entries for pagination
  const loadMore = useCallback(async (): Promise<void> => {
    if (!hasMore || isLoadingMore || !lastDocIdRef.current) return;

    try {
      setIsLoadingMore(true);
      setError(null);
      
      const moreEntries = await firestoreClient.getEntries(userId, {
        ...queryOptions,
        startAfter: lastDocIdRef.current
      });

      setEntries(prev => [...prev, ...moreEntries]);
      setHasMore(moreEntries.length === (queryOptions.limit || 20));
      
      if (moreEntries.length > 0) {
        lastDocIdRef.current = moreEntries[moreEntries.length - 1].id;
      }
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
    } finally {
      setIsLoadingMore(false);
    }
  }, [userId, hasMore, isLoadingMore, JSON.stringify(queryOptions)]);

  return {
    entries,
    loading,
    error,
    subscriptionState,
    createEntry,
    updateEntry,
    deleteEntry,
    refreshEntries,
    loadMore,
    hasMore,
    isLoadingMore
  };
}

// Hook for single journal entry
export function useJournalEntry(userId: string, entryId: string) {
  const [entry, setEntry] = useState<JournalEntry | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<DatabaseError | null>(null);

  useEffect(() => {
    if (!userId || !entryId) return;

    const fetchEntry = async () => {
      try {
        setLoading(true);
        setError(null);
        
        // Check cache first
        const cached = journalCache.getJournalEntry(entryId);
        if (cached) {
          setEntry(cached);
          setLoading(false);
        }

        // Fetch from Firestore
        const fetchedEntry = await firestoreClient.getEntry(userId, entryId);
        setEntry(fetchedEntry);
        
        // Update cache
        if (fetchedEntry) {
          journalCache.setJournalEntry(entryId, fetchedEntry);
        }
      } catch (err) {
        const dbError = err as DatabaseError;
        setError(dbError);
      } finally {
        setLoading(false);
      }
    };

    fetchEntry();
  }, [userId, entryId]);

  const updateEntry = useCallback(async (updates: Partial<JournalEntry>): Promise<void> => {
    if (!entry) return;

    try {
      setError(null);
      
      // Optimistic update
      setEntry(prev => prev ? { ...prev, ...updates, updatedAt: new Date() } : null);

      // Update in Firestore
      await firestoreClient.updateEntry(userId, entryId, updates);

      // Update cache
      const updatedEntry = { ...entry, ...updates, updatedAt: new Date() };
      journalCache.setJournalEntry(entryId, updatedEntry);
    } catch (err) {
      const dbError = err as DatabaseError;
      setError(dbError);
      
      // Revert optimistic update
      const freshEntry = await firestoreClient.getEntry(userId, entryId);
      setEntry(freshEntry);
      
      throw dbError;
    }
  }, [userId, entryId, entry]);

  return {
    entry,
    loading,
    error,
    updateEntry
  };
}