'use client';

import { useState } from 'react';
import Link from 'next/link';

const steps = [
  {
    title: 'Welcoming',
    content: `Everyone carries parts of themselves they would rather not look at. These are not necessarily "bad" parts - sometimes they are just inconvenient or misunderstood.

Shadow work is not about fixing what is broken. It is about meeting what you have been avoiding with curiosity instead of judgment.

You do not have to love these parts immediately. You just have to be willing to see them.`,
    prompt: 'What quality in other people triggers the strongest reaction in you? What might this say about you?',
  },
  {
    title: 'Recognizing',
    content: `The parts of ourselves we hide often developed for good reasons. They might have protected us, helped us belong, or kept us safe in difficult times.

What we call "negative" traits might actually be strengths that haven't found healthy expression yet.

Your shadow isn't your enemy - it's often your unintegrated power.`,
    prompt: 'What parts of yourself did you learn to hide early in life? What happened when you showed these parts?',
  },
  {
    title: 'Understanding',
    content: `Your disowned parts haven't disappeared. They show up in unexpected ways - in your triggers, your judgments, your patterns you can't quite break.

They're not trying to sabotage you. They're trying to be seen, heard, and integrated.

What if these parts had important information for you?`,
    prompt: 'If the part of you that you most judge could speak, what might it be trying to tell you?',
  },
  {
    title: 'Dialoguing',
    content: `Sometimes the best way to understand something is to have a conversation with it. Your shadow parts have been waiting a long time to be heard.

This isn't about giving them free reign in your life. It's about understanding what they need and finding healthy ways to honor their energy.

You can listen without losing yourself.`,
    prompt: 'Write a conversation between you and a part of yourself you usually try to suppress. What does it want you to know?',
  },
  {
    title: 'Integrating',
    content: `Integration doesn't mean acting on every impulse or becoming someone you're not. It means acknowledging all parts of yourself and finding conscious ways to work with them.

Your anger might become healthy boundaries. Your selfishness might become necessary self-care. Your darkness might become depth and authenticity.

Wholeness includes everything.`,
    prompt: 'How might you honor the energy of your shadow parts in healthy, conscious ways?',
  },
  {
    title: 'Embracing',
    content: `You are not just your best qualities, and you are not just your worst ones. You are the full spectrum of human experience.

When you stop fighting parts of yourself, energy that was trapped in resistance becomes available for growth and creativity.

This isn't about becoming perfect. It's about becoming whole.`,
    prompt: 'How does it feel to accept all of yourself? What becomes possible when you stop hiding?',
  },
];

export default function ShadowWorkPathway() {
  const [currentStep, setCurrentStep] = useState(0);
  const [journalEntry, setJournalEntry] = useState('');
  
  const step = steps[currentStep];
  const isLastStep = currentStep === steps.length - 1;




  return (
    <div className="min-h-screen bg-gradient-to-b from-[#8B9A7C] to-[#A8B5A0] flex flex-col">
      {/* Header */}
      <header className="px-6 pt-14 pb-4">
        <Link href="/pathways/" className="text-white/60 text-base mb-4 inline-block">
          ← Back
        </Link>
        <h1 className="text-white text-2xl font-light">Shadow Work</h1>
        <p className="text-white/50 text-sm mt-1">Embracing all of who you are</p>
        
        {/* Progress dots */}
        <div className="flex gap-2 mt-4">
          {steps.map((_, i) => (
            <div 
              key={i}
              className={`h-1 flex-1 rounded-full transition-colors ${
                i <= currentStep ? 'bg-[#8B9A7C]/60' : 'bg-white/15'
              }`}
            />
          ))}
        </div>
      </header>

      {/* Content */}
      <div className="flex-1 px-6 pb-24 overflow-y-auto">
        <div className="bg-[#8B9A7C]/15 backdrop-blur-sm rounded-2xl p-6 border border-[#8B9A7C]/20 mb-6">
          <h2 className="text-white text-xl font-light mb-4">{step.title}</h2>
          <div className="text-white/70 text-base leading-relaxed whitespace-pre-line">
            {step.content}
          </div>
        </div>

        {/* Journal prompt */}
        <div className="mb-6">
          <p className="text-white/50 text-sm mb-3 italic">"{step.prompt}"</p>
          <textarea
            value={journalEntry}
            onChange={(e) => setJournalEntry(e.target.value)}
            placeholder="Write whatever comes..."
            className="w-full h-32 bg-[#8B9A7C]/10 backdrop-blur-sm rounded-xl p-4 
                       text-white text-base leading-relaxed
                       placeholder:text-white/30
                       border border-[#8B9A7C]/15
                       focus:bg-[#8B9A7C]/20 focus:outline-none focus:border-[#8B9A7C]/30
                       transition-all duration-300 resize-none"
          />
        </div>

        {/* Navigation */}
        <div className="flex gap-3">
          {currentStep > 0 && (
            <button
              onClick={() => setCurrentStep(currentStep - 1)}
              className="px-6 py-3 rounded-full bg-white/10 hover:bg-white/15 transition-colors"
            >
              <span className="text-white/70 text-sm">Back</span>
            </button>
          )}
          
          <button
            onClick={() => {
              if (!isLastStep) {
                setCurrentStep(currentStep + 1);
                setJournalEntry('');
              }
            }}
            className="flex-1 px-6 py-3 rounded-full bg-[#8B9A7C]/25 hover:bg-[#8B9A7C]/35 transition-all duration-200 ease-out active:scale-[0.98] min-h-[44px]"
          >
            <span className="text-white text-sm font-medium">
              {isLastStep ? 'Complete' : 'Continue'}
            </span>
          </button>
        </div>
      </div>


      </div>
    </div>
  );
}