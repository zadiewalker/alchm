'use client';

import { useState } from 'react';
import Link from 'next/link';

const steps = [
  {
    title: 'Grounding',
    content: `When everything feels like too much, the first step is finding ground.

You don't have to understand the storm right now. You just have to find something solid to hold onto.

Feel your feet on the floor. The weight of your body. You are here. You are real. This moment will pass.`,
    prompt: 'Name five things you can see right now, without judging them.',
  },
  {
    title: 'Breathing Room',
    content: `Your breath is always with you. It doesn't need to be deep or special — just noticed.

When emotions surge, the breath often becomes shallow. That's okay. It's your body trying to protect you.

Can you give your breath just a little more room? Not forcing, just inviting.`,
    prompt: 'What happens when you let your exhale be just slightly longer than your inhale?',
  },
  {
    title: 'Naming',
    content: `There's something powerful about naming what we feel. Not analyzing it, not fixing it — just acknowledging it.

"I notice I'm feeling overwhelmed."
"There's fear here."
"This is grief."

The feeling doesn't have to change. It just wants to be seen.`,
    prompt: 'What emotions are present right now? Can you name them without adding a story?',
  },
  {
    title: 'Containing',
    content: `Sometimes feelings are too big to process all at once. That's not weakness — that's wisdom.

Imagine placing the overwhelm in a container for now. Not to ignore it, but to pace yourself. You can return to it when you have more resources.

You're allowed to take this slowly.`,
    prompt: 'If you could set one thing aside for now, knowing you can return to it later, what would it be?',
  },
  {
    title: 'Compassion',
    content: `You're in the middle of something hard. That deserves acknowledgment.

Whatever you're feeling makes sense given what you've been through. You're not broken. You're not too much. You're a human being having a human experience.

What would you say to a dear friend feeling this way?`,
    prompt: 'Can you offer yourself the same kindness you would offer someone you love?',
  },
  {
    title: 'Returning',
    content: `The storm doesn't define you. It's weather, and weather passes.

You've made it through difficult moments before. You're making it through this one now.

When you're ready, you'll find that the stillness was inside you all along — not the absence of the storm, but the quiet eye within it.`,
    prompt: 'What small act of care can you offer yourself in the next hour?',
  },
];

export default function CalmTheStormPathway() {
  const [currentStep, setCurrentStep] = useState(0);
  const [journalEntry, setJournalEntry] = useState('');
  
  const step = steps[currentStep];
  const isLastStep = currentStep === steps.length - 1;

  return (
    <div className="min-h-screen bg-gradient-to-b from-[#8B9A7C] to-[#A8B5A0] flex flex-col">
      {/* Header */}
      <header className="px-6 pt-14 pb-4">
        <Link href="/pathways/" className="text-white/60 text-base mb-4 inline-block hover:text-white/80 transition-all duration-200 ease-out active:scale-[0.98]">
          ← Back
        </Link>
        <h1 className="text-white text-2xl font-light">Finding Stillness</h1>
        <p className="text-white/50 text-sm mt-1">Working with overwhelming emotions</p>
        
        {/* Progress dots - subtle, no alarming colors */}
        <div className="flex gap-2 mt-4">
          {steps.map((_, i) => (
            <div 
              key={i}
              className={`h-1 flex-1 rounded-full transition-colors ${
                i <= currentStep ? 'bg-[#8B9A7C]/60' : 'bg-white/15'
              }`}
            />
          ))}
        </div>
      </header>

      {/* Content */}
      <div className="flex-1 px-6 pb-24 overflow-y-auto">
        <div className="bg-[#8B9A7C]/15 backdrop-blur-sm rounded-2xl p-6 border border-[#8B9A7C]/20 mb-6">
          <h2 className="text-white text-xl font-light mb-4">{step.title}</h2>
          <div className="text-white/70 text-base leading-relaxed whitespace-pre-line">
            {step.content}
          </div>
        </div>

        {/* Journal prompt */}
        <div className="mb-6">
          <p className="text-white/50 text-sm mb-3 italic">"{step.prompt}"</p>
          <textarea
            value={journalEntry}
            onChange={(e) => setJournalEntry(e.target.value)}
            placeholder="Write whatever comes..."
            className="w-full h-32 bg-[#8B9A7C]/10 backdrop-blur-sm rounded-xl p-4 
                       text-white text-base leading-relaxed
                       placeholder:text-white/30
                       border border-[#8B9A7C]/15
                       focus:bg-[#8B9A7C]/20 focus:outline-none focus:border-[#8B9A7C]/30
                       transition-all duration-200 ease-out resize-none"
          />
        </div>

        {/* Navigation */}
        <div className="flex gap-3">
          {currentStep > 0 && (
            <button
              onClick={() => setCurrentStep(currentStep - 1)}
              className="px-6 py-3 rounded-full bg-white/10 hover:bg-white/15 transition-all duration-200 ease-out active:scale-[0.98] min-h-[44px]"
            >
              <span className="text-white/70 text-sm">Back</span>
            </button>
          )}
          
          <button
            onClick={() => {
              if (!isLastStep) {
                setCurrentStep(currentStep + 1);
                setJournalEntry('');
              }
            }}
            className="flex-1 px-6 py-3 rounded-full bg-[#8B9A7C]/25 hover:bg-[#8B9A7C]/35 transition-all duration-200 ease-out active:scale-[0.98] min-h-[44px]"
          >
            <span className="text-white text-sm font-medium">
              {isLastStep ? 'Complete' : 'Continue'}
            </span>
          </button>
        </div>
      </div>


      </div>
    </div>
  );
}