'use client';

import { useState } from 'react';
import Link from 'next/link';

const steps = [
  {
    title: 'Acknowledging',
    content: `Loss changes us. It changes the landscape of our lives in ways we never expected.

You do not have to be "over it" or have it figured out. You do not have to be grateful for the lessons yet.

You are allowed to sit with what is gone and let it be real.`,
    prompt: 'What feels different about your world since this loss?',
  },
  {
    title: 'Allowing',
    content: `Grief does not follow timelines or rules. It comes in waves, in surprising moments, in dreams and memories.

Your grief is as unique as what you have lost. There is no right way to feel this.

All of it belongs - the anger, the relief, the confusion, the love that has nowhere to go.`,
    prompt: 'What does your grief feel like today? What does it need?',
  },
  {
    title: 'Remembering',
    content: `What was precious does not disappear when it ends. Love does not die with loss.

The connection you had was real. The impact was real. The meaning was real.

Your memories are not just echoes of the past - they are living parts of who you have become.`,
    prompt: 'What do you want to hold onto? What deserves to be remembered?',
  },
  {
    title: 'Holding Space',
    content: `Grief asks for witness. It asks for the sacred space between what was and what is now.

You do not have to carry this alone. You do not have to make it smaller for others comfort.

Your loss matters. Your pain has meaning. Your love continues.`,
    prompt: 'What would help you feel less alone in this?',
  },
  {
    title: 'Finding Tenderness',
    content: `In the midst of loss, be gentle with the part of you that loved so deeply it hurts to let go.

That capacity for love is not broken. It is not naive. It is the most courageous thing about you.

How can you hold your grieving heart with the same tenderness you would offer a dear friend?`,
    prompt: 'What does your heart need to feel held right now?',
  },
  {
    title: 'Continuing',
    content: `You will never be the same person you were before this loss. That is not failure - that is how love works.

The relationship continues, even though its form has changed. The love finds new ways to live.

You carry something forward that would not exist without what you have been through.`,
    prompt: 'How do you want to honor what you have lost as you continue forward?',
  },
];

export default function HonoringLossPathway() {
  const [currentStep, setCurrentStep] = useState(0);
  const [journalEntry, setJournalEntry] = useState('');
  
  const step = steps[currentStep];
  const isLastStep = currentStep === steps.length - 1;

  return (
    <div className="min-h-screen bg-gradient-to-b from-[#8B9A7C] to-[#A8B5A0] flex flex-col">
      {/* Header */}
      <header className="px-6 pt-14 pb-4">
        <Link href="/pathways/" className="text-white/60 text-base mb-4 inline-block">
          ← Back
        </Link>
        <h1 className="text-white text-2xl font-light">Honoring Loss</h1>
        <p className="text-white/50 text-sm mt-1">Making space for grief</p>
        
        {/* Progress dots */}
        <div className="flex gap-2 mt-4">
          {steps.map((_, i) => (
            <div 
              key={i}
              className={`h-1 flex-1 rounded-full transition-colors ${
                i <= currentStep ? 'bg-[#E5C97D]/60' : 'bg-white/15'
              }`}
            />
          ))}
        </div>
      </header>

      {/* Content */}
      <div className="flex-1 px-6 pb-24 overflow-y-auto">
        <div className="bg-[#E5C97D]/15 backdrop-blur-sm rounded-2xl p-6 border border-[#E5C97D]/20 mb-6">
          <h2 className="text-white text-xl font-light mb-4">{step.title}</h2>
          <div className="text-white/70 text-base leading-relaxed whitespace-pre-line">
            {step.content}
          </div>
        </div>

        {/* Journal prompt */}
        <div className="mb-6">
          <p className="text-white/50 text-sm mb-3 italic">"{step.prompt}"</p>
          <textarea
            value={journalEntry}
            onChange={(e) => setJournalEntry(e.target.value)}
            placeholder="Write whatever comes..."
            className="w-full h-32 bg-[#E5C97D]/10 backdrop-blur-sm rounded-xl p-4 
                       text-white text-base leading-relaxed
                       placeholder:text-white/30
                       border border-[#E5C97D]/15
                       focus:bg-[#E5C97D]/20 focus:outline-none focus:border-[#E5C97D]/30
                       transition-all duration-300 resize-none"
          />
        </div>

        {/* Navigation */}
        <div className="flex gap-3">
          {currentStep > 0 && (
            <button
              onClick={() => setCurrentStep(currentStep - 1)}
              className="px-6 py-3 rounded-full bg-white/10 hover:bg-white/15 transition-colors"
            >
              <span className="text-white/70 text-sm">Back</span>
            </button>
          )}
          
          <button
            onClick={() => {
              if (!isLastStep) {
                setCurrentStep(currentStep + 1);
                setJournalEntry('');
              }
            }}
            className="flex-1 px-6 py-3 rounded-full bg-[#E5C97D]/25 hover:bg-[#E5C97D]/35 transition-all duration-200 ease-out active:scale-[0.98] min-h-[44px]"
          >
            <span className="text-white text-sm font-medium">
              {isLastStep ? 'Complete' : 'Continue'}
            </span>
          </button>
        </div>
      </div>


      </div>
    </div>
  );
}