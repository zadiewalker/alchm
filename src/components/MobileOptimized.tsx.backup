// Mobile-Optimized UI Components for ALCHM iOS App
'use client';
import React, { useRef, useState, useEffect } from 'react';
import { useNativeFeatures } from '@/hooks/useNativeFeatures';

// Enhanced touch button with haptic feedback
interface TouchButtonProps {
  children: React.ReactNode;
  onClick?: () => void;
  onLongPress?: () => void;
  variant?: 'primary' | 'secondary' | 'danger' | 'success';
  size?: 'small' | 'medium' | 'large';
  disabled?: boolean;
  hapticFeedback?: 'light' | 'medium' | 'heavy';
  className?: string;
}

export function TouchButton({ 
  children, 
  onClick, 
  onLongPress,
  variant = 'primary',
  size = 'medium',
  disabled = false,
  hapticFeedback = 'light',
  className = ''
}: TouchButtonProps) {
  const { triggerHapticFeedback, isIOS } = useNativeFeatures();
  const [isPressed, setIsPressed] = useState(false);
  const pressTimer = useRef<NodeJS.Timeout | null>(null);
  const longPressTriggered = useRef(false);

  const baseClasses = 'touch-button transition-all duration-200 rounded-2xl font-medium text-center active:scale-95';
  
  const variantClasses = {
    primary: 'bg-white/20 hover:bg-white/30 border border-white/20 text-white',
    secondary: 'bg-black/20 hover:bg-black/30 border border-white/20 text-white',
    danger: 'bg-red-600/30 hover:bg-red-600/40 border border-red-500/30 text-red-200',
    success: 'bg-green-600/30 hover:bg-green-600/40 border border-green-500/30 text-green-200'
  };
  
  const sizeClasses = {
    small: 'px-4 py-2 text-sm',
    medium: 'px-6 py-3 text-base',
    large: 'px-8 py-4 text-lg'
  };

  const handleTouchStart = () => {
    if (disabled) return;
    
    setIsPressed(true);
    longPressTriggered.current = false;
    
    if (onLongPress) {
      pressTimer.current = setTimeout(() => {
        longPressTriggered.current = true;
        triggerHapticFeedback('medium');
        onLongPress();
      }, 500);
    }
  };

  const handleTouchEnd = () => {
    if (disabled) return;
    
    setIsPressed(false);
    
    if (pressTimer.current) {
      clearTimeout(pressTimer.current);
      pressTimer.current = null;
    }
    
    if (!longPressTriggered.current && onClick) {
      triggerHapticFeedback(hapticFeedback);
      onClick();
    }
  };

  const handleTouchCancel = () => {
    setIsPressed(false);
    if (pressTimer.current) {
      clearTimeout(pressTimer.current);
      pressTimer.current = null;
    }
  };

  return (
    <button
      className={`
        ${baseClasses}
        ${variantClasses[variant]}
        ${sizeClasses[size]}
        ${isPressed ? 'scale-95 brightness-110' : ''}
        ${disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}
        ${className}
      `}
      onTouchStart={handleTouchStart}
      onTouchEnd={handleTouchEnd}
      onTouchCancel={handleTouchCancel}
      onMouseDown={!isIOS ? handleTouchStart : undefined}
      onMouseUp={!isIOS ? handleTouchEnd : undefined}
      onMouseLeave={!isIOS ? handleTouchCancel : undefined}
      disabled={disabled}
      style={{
        WebkitTapHighlightColor: 'transparent',
        WebkitTouchCallout: 'none',
        WebkitUserSelect: 'none',
        userSelect: 'none'
      }}
    >
      {children}
    </button>
  );
}

// Swipeable card component
interface SwipeableCardProps {
  children: React.ReactNode;
  onSwipeLeft?: () => void;
  onSwipeRight?: () => void;
  onSwipeUp?: () => void;
  onSwipeDown?: () => void;
  swipeThreshold?: number;
  className?: string;
}

export function SwipeableCard({
  children,
  onSwipeLeft,
  onSwipeRight,
  onSwipeUp,
  onSwipeDown,
  swipeThreshold = 50,
  className = ''
}: SwipeableCardProps) {
  const { triggerHapticFeedback } = useNativeFeatures();
  const [touchStart, setTouchStart] = useState({ x: 0, y: 0 });
  const [touchMove, setTouchMove] = useState({ x: 0, y: 0 });
  const [isSwiping, setIsSwiping] = useState(false);

  const handleTouchStart = (e: React.TouchEvent) => {
    const touch = e.touches[0];
    setTouchStart({ x: touch.clientX, y: touch.clientY });
    setIsSwiping(false);
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!touchStart.x || !touchStart.y) return;
    
    const touch = e.touches[0];
    const moveX = touch.clientX - touchStart.x;
    const moveY = touch.clientY - touchStart.y;
    
    setTouchMove({ x: moveX, y: moveY });
    setIsSwiping(Math.abs(moveX) > 10 || Math.abs(moveY) > 10);
  };

  const handleTouchEnd = () => {
    if (!touchStart.x || !touchStart.y) return;
    
    const deltaX = touchMove.x;
    const deltaY = touchMove.y;
    const absDeltaX = Math.abs(deltaX);
    const absDeltaY = Math.abs(deltaY);
    
    if (absDeltaX > swipeThreshold || absDeltaY > swipeThreshold) {
      if (absDeltaX > absDeltaY) {
        // Horizontal swipe
        if (deltaX > 0 && onSwipeRight) {
          triggerHapticFeedback('light');
          onSwipeRight();
        } else if (deltaX < 0 && onSwipeLeft) {
          triggerHapticFeedback('light');
          onSwipeLeft();
        }
      } else {
        // Vertical swipe
        if (deltaY > 0 && onSwipeDown) {
          triggerHapticFeedback('light');
          onSwipeDown();
        } else if (deltaY < 0 && onSwipeUp) {
          triggerHapticFeedback('light');
          onSwipeUp();
        }
      }
    }
    
    setTouchStart({ x: 0, y: 0 });
    setTouchMove({ x: 0, y: 0 });
    setIsSwiping(false);
  };

  return (
    <div
      className={`
        ${className}
        ${isSwiping ? 'transition-transform duration-100' : 'transition-transform duration-300'}
        select-none
      `}
      onTouchStart={handleTouchStart}
      onTouchMove={handleTouchMove}
      onTouchEnd={handleTouchEnd}
      style={{
        transform: isSwiping ? `translate(${touchMove.x * 0.3}px, ${touchMove.y * 0.3}px)` : 'translate(0, 0)',
        WebkitTouchCallout: 'none',
        WebkitUserSelect: 'none',
        userSelect: 'none'
      }}
    >
      {children}
    </div>
  );
}

// Pull to refresh component
interface PullToRefreshProps {
  children: React.ReactNode;
  onRefresh: () => Promise<void>;
  refreshThreshold?: number;
  className?: string;
}

export function PullToRefresh({
  children,
  onRefresh,
  refreshThreshold = 80,
  className = ''
}: PullToRefreshProps) {
  const { triggerHapticFeedback } = useNativeFeatures();
  const [pullDistance, setPullDistance] = useState(0);
  const [isRefreshing, setIsRefreshing] = useState(false);
  const [startY, setStartY] = useState(0);
  const [canPull, setCanPull] = useState(true);

  useEffect(() => {
    const checkScrollTop = () => {
      setCanPull(window.scrollY <= 0);
    };
    
    window.addEventListener('scroll', checkScrollTop);
    return () => window.removeEventListener('scroll', checkScrollTop);
  }, []);

  const handleTouchStart = (e: React.TouchEvent) => {
    if (!canPull) return;
    setStartY(e.touches[0].clientY);
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!canPull || isRefreshing || startY === 0) return;
    
    const currentY = e.touches[0].clientY;
    const distance = Math.max(0, currentY - startY);
    
    if (distance > 0) {
      e.preventDefault();
      setPullDistance(Math.min(distance, refreshThreshold * 1.5));
      
      // Haptic feedback at threshold
      if (distance >= refreshThreshold && pullDistance < refreshThreshold) {
        triggerHapticFeedback('medium');
      }
    }
  };

  const handleTouchEnd = async () => {
    if (pullDistance >= refreshThreshold && !isRefreshing) {
      setIsRefreshing(true);
      triggerHapticFeedback('success');
      
      try {
        await onRefresh();
      } finally {
        setIsRefreshing(false);
      }
    }
    
    setPullDistance(0);
    setStartY(0);
  };

  const pullProgress = Math.min(pullDistance / refreshThreshold, 1);

  return (
    <div className={className}>
      {/* Pull indicator */}
      <div 
        className="fixed top-0 left-0 right-0 z-50 flex justify-center items-center transition-all duration-300"
        style={{
          transform: `translateY(${Math.max(-60, pullDistance - 60)}px)`,
          opacity: pullDistance > 20 ? 1 : 0
        }}
      >
        <div className="bg-white/20 backdrop-blur-sm rounded-full p-3 border border-white/30">
          <div 
            className={`w-6 h-6 border-2 border-white/60 rounded-full transition-transform duration-300 ${
              isRefreshing ? 'animate-spin border-t-white' : ''
            }`}
            style={{
              transform: `rotate(${pullProgress * 360}deg)`,
              borderTopColor: pullProgress >= 1 ? 'white' : 'transparent'
            }}
          />
        </div>
      </div>
      
      {/* Content */}
      <div
        onTouchStart={handleTouchStart}
        onTouchMove={handleTouchMove}
        onTouchEnd={handleTouchEnd}
        style={{
          transform: `translateY(${pullDistance * 0.5}px)`,
          transition: isRefreshing ? 'transform 0.3s ease-out' : 'none'
        }}
      >
        {children}
      </div>
    </div>
  );
}

// Safe area component for iOS notches/dynamic island
interface SafeAreaProps {
  children: React.ReactNode;
  top?: boolean;
  bottom?: boolean;
  left?: boolean;
  right?: boolean;
  className?: string;
}

export function SafeArea({
  children,
  top = true,
  bottom = true,
  left = true,
  right = true,
  className = ''
}: SafeAreaProps) {
  const { getSafeAreaInsets, isIOS } = useNativeFeatures();
  const insets = getSafeAreaInsets();

  if (!isIOS) {
    return <div className={className}>{children}</div>;
  }

  return (
    <div
      className={className}
      style={{
        paddingTop: top ? insets.top : 0,
        paddingBottom: bottom ? insets.bottom : 0,
        paddingLeft: left ? insets.left : 0,
        paddingRight: right ? insets.right : 0
      }}
    >
      {children}
    </div>
  );
}

// Mobile-optimized input with proper keyboard handling
interface MobileInputProps {
  type?: 'text' | 'email' | 'password' | 'tel' | 'url' | 'search' | 'number';
  placeholder?: string;
  value?: string;
  onChange?: (value: string) => void;
  onFocus?: () => void;
  onBlur?: () => void;
  disabled?: boolean;
  autoFocus?: boolean;
  multiline?: boolean;
  rows?: number;
  className?: string;
}

export function MobileInput({
  type = 'text',
  placeholder,
  value,
  onChange,
  onFocus,
  onBlur,
  disabled,
  autoFocus,
  multiline = false,
  rows = 3,
  className = ''
}: MobileInputProps) {
  const { handleInputFocus, preventZoom, adjustForKeyboard, keyboardOpen } = useNativeFeatures();
  const inputRef = useRef<HTMLInputElement | HTMLTextAreaElement>(null);

  useEffect(() => {
    if (autoFocus && inputRef.current) {
      inputRef.current.focus();
    }
  }, [autoFocus]);

  const handleFocus = (e: React.FocusEvent) => {
    preventZoom();
    handleInputFocus(e.target as HTMLElement);
    onFocus?.();
  };

  const commonProps = {
    ref: inputRef,
    value,
    placeholder,
    disabled,
    onFocus: handleFocus,
    onBlur,
    onChange: (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => onChange?.(e.target.value),
    className: `
      w-full bg-black/20 border border-white/20 rounded-xl px-4 py-3 text-white 
      placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-purple-500/50
      transition-all duration-200 ${className}
    `,
    style: {
      fontSize: '16px', // Prevents zoom on iOS
      WebkitAppearance: 'none',
      ...adjustForKeyboard(20)
    }
  };

  if (multiline) {
    return (
      <textarea
        {...commonProps}
        rows={rows}
        style={{
          ...commonProps.style,
          resize: 'none'
        }}
      />
    );
  }

  return (
    <input
      {...commonProps}
      type={type}
      autoComplete={type === 'password' ? 'current-password' : 'on'}
      autoCapitalize={type === 'email' ? 'none' : 'sentences'}
      autoCorrect={type === 'email' ? 'off' : 'on'}
      spellCheck={type === 'email' ? 'false' : 'true'}
    />
  );
}

// Toast notification optimized for mobile
interface ToastProps {
  message: string;
  type?: 'success' | 'error' | 'warning' | 'info';
  duration?: number;
  onClose?: () => void;
  position?: 'top' | 'bottom';
}

export function MobileToast({
  message,
  type = 'info',
  duration = 3000,
  onClose,
  position = 'top'
}: ToastProps) {
  const { triggerHapticFeedback, getSafeAreaInsets } = useNativeFeatures();
  const [visible, setVisible] = useState(true);
  const insets = getSafeAreaInsets();

  useEffect(() => {
    // Trigger haptic feedback based on type
    switch (type) {
      case 'success':
        triggerHapticFeedback('success');
        break;
      case 'error':
        triggerHapticFeedback('error');
        break;
      case 'warning':
        triggerHapticFeedback('warning');
        break;
      default:
        triggerHapticFeedback('light');
    }

    const timer = setTimeout(() => {
      setVisible(false);
      setTimeout(() => onClose?.(), 300);
    }, duration);

    return () => clearTimeout(timer);
  }, [type, duration, onClose, triggerHapticFeedback]);

  const typeStyles = {
    success: 'bg-green-600/90 border-green-500/50 text-green-100',
    error: 'bg-red-600/90 border-red-500/50 text-red-100',
    warning: 'bg-yellow-600/90 border-yellow-500/50 text-yellow-100',
    info: 'bg-blue-600/90 border-blue-500/50 text-blue-100'
  };

  return (
    <div
      className={`
        fixed left-4 right-4 z-50 px-4 py-3 rounded-2xl border backdrop-blur-sm
        transition-all duration-300 ${typeStyles[type]}
        ${visible ? 'opacity-100 scale-100' : 'opacity-0 scale-95'}
      `}
      style={{
        [position]: position === 'top' ? insets.top + 20 : insets.bottom + 20
      }}
    >
      <div className="flex items-center justify-between gap-3">
        <span className="flex-1 text-sm font-medium">{message}</span>
        <button
          onClick={() => setVisible(false)}
          className="text-current opacity-70 hover:opacity-100"
        >
          ×
        </button>
      </div>
    </div>
  );
}