'use client';
import { createContext, useContext, useState, useEffect, ReactNode } from 'react';
import { 
  SupportedLanguage, 
  CulturalContext, 
  Translations, 
  LocalizationContext,
  CULTURAL_CONTEXTS,
  translationManager,
  detectUserLanguage,
  detectUserRegion,
  formatDateForLocale,
  formatNumberForLocale,
  formatCurrencyForLocale,
  getTextDirection
} from '@/lib/i18n';

interface LocalizationProviderProps {
  children: ReactNode;
  defaultLanguage?: SupportedLanguage;
  defaultRegion?: string;
}

export default function LocalizationProvider({ 
  children, 
  defaultLanguage,
  defaultRegion 
}: LocalizationProviderProps) {
  const [language, setLanguage] = useState<SupportedLanguage>(
    defaultLanguage || detectUserLanguage()
  );
  const [region, setRegion] = useState(defaultRegion || detectUserRegion());
  const [translations, setTranslations] = useState<Translations>({} as Translations);
  const [culturalContext, setCulturalContext] = useState<CulturalContext>(
    CULTURAL_CONTEXTS['en-US']
  );

  // Load translations and cultural context when language/region changes
  useEffect(() => {
    const loadLocalization = async () => {
      // Load translations
      const newTranslations = translationManager.getTranslations(language);
      setTranslations(newTranslations);

      // Load cultural context
      const contextKey = `${language}-${region}`;
      const context = CULTURAL_CONTEXTS[contextKey] || CULTURAL_CONTEXTS[`${language}-US`] || CULTURAL_CONTEXTS['en-US'];
      setCulturalContext(context);

      // Apply RTL styling if needed
      if (typeof document !== 'undefined') {
        document.documentElement.dir = getTextDirection(language);
        document.documentElement.lang = language;
      }
    };

    loadLocalization();
  }, [language, region]);

  // Save language preference to localStorage
  useEffect(() => {
    if (typeof window !== 'undefined') {
      localStorage.setItem('alchm_language', language);
      localStorage.setItem('alchm_region', region);
    }
  }, [language, region]);

  // Load saved preferences on mount
  useEffect(() => {
    if (typeof window !== 'undefined') {
      const savedLanguage = localStorage.getItem('alchm_language') as SupportedLanguage;
      const savedRegion = localStorage.getItem('alchm_region');
      
      if (savedLanguage) setLanguage(savedLanguage);
      if (savedRegion) setRegion(savedRegion);
    }
  }, []);

  const contextValue = {
    language,
    culturalContext,
    translations,
    setLanguage: (newLanguage: SupportedLanguage) => {
      setLanguage(newLanguage);
    },
    setRegion: (newRegion: string) => {
      setRegion(newRegion);
    },
    formatDate: (date: Date) => formatDateForLocale(date, language, region),
    formatNumber: (num: number) => formatNumberForLocale(num, language, region),
    formatCurrency: (amount: number, currency: string) => 
      formatCurrencyForLocale(amount, currency, language, region),
    getDirection: () => getTextDirection(language),
    getLocalizedCrisisResources: () => culturalContext.crisisResources,
    translate: (key: string, params?: Record<string, string>) => 
      translationManager.translate(key, language, params)
  };

  return (
    <LocalizationContext.Provider value={contextValue}>
      {children}
    </LocalizationContext.Provider>
  );
}

// Custom hook with enhanced functionality
export function useTranslation() {
  const context = useContext(LocalizationContext);
  if (!context) {
    throw new Error('useTranslation must be used within a LocalizationProvider');
  }

  const t = (key: string, params?: Record<string, string>) => {
    return context.translate(key, params);
  };

  return {
    t,
    language: context.language,
    culturalContext: context.culturalContext,
    setLanguage: context.setLanguage,
    formatDate: context.formatDate,
    formatNumber: context.formatNumber,
    formatCurrency: context.formatCurrency,
    getDirection: context.getDirection,
    isRTL: context.getDirection() === 'rtl'
  };
}

// Culturally-aware component wrapper
export function CulturallyAware({ children }: { children: ReactNode }) {
  const { culturalContext, getDirection } = useTranslation();
  
  return (
    <div 
      dir={getDirection()}
      className={`cultural-context-${culturalContext.language}`}
      data-collectivism-level={culturalContext.culturalValues.collectivism}
      data-spirituality-level={culturalContext.culturalValues.spirituality}
      data-formality-level={culturalContext.culturalValues.formalityLevel}
    >
      {children}
    </div>
  );
}

// Language selector component
export function LanguageSelector() {
  const { language, setLanguage } = useTranslation();

  const languages = [
    { code: 'en', name: 'English', flag: '🇺🇸' },
    { code: 'es', name: 'Español', flag: '🇪🇸' },
    { code: 'ja', name: '日本語', flag: '🇯🇵' },
    { code: 'ar', name: 'العربية', flag: '🇸🇦' },
    { code: 'fr', name: 'Français', flag: '🇫🇷' },
    { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
    { code: 'pt', name: 'Português', flag: '🇧🇷' },
    { code: 'zh', name: '中文', flag: '🇨🇳' },
    { code: 'hi', name: 'हिन्दी', flag: '🇮🇳' },
    { code: 'ru', name: 'Русский', flag: '🇷🇺' }
  ];

  return (
    <div className="language-selector">
      <select
        value={language}
        onChange={(e) => setLanguage(e.target.value as SupportedLanguage)}
        className="bg-black/20 border border-white/20 rounded-lg p-2 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50"
      >
        {languages.map((lang) => (
          <option key={lang.code} value={lang.code} className="bg-gray-900">
            {lang.flag} {lang.name}
          </option>
        ))}
      </select>
    </div>
  );
}

// Crisis resources component with localization
export function LocalizedCrisisResources() {
  const { culturalContext, t } = useTranslation();

  return (
    <div className="crisis-resources bg-red-900/20 border border-red-500/30 rounded-lg p-4">
      <h3 className="text-red-200 font-medium mb-3">
        {t('crisis.immediateHelp')}
      </h3>
      
      <div className="space-y-3">
        <p className="text-red-100/80 text-sm">
          {t('crisis.emergencyNotice')}
        </p>

        <div>
          <h4 className="text-red-200 text-sm font-medium mb-2">
            {t('crisis.hotlineNumbers')}
          </h4>
          <div className="space-y-2">
            {culturalContext.crisisResources.hotlines.map((hotline, index) => (
              <div key={index} className="bg-black/20 p-2 rounded text-sm">
                <div className="text-red-200 font-medium">{hotline.name}</div>
                <div className="text-red-100/70">{hotline.number}</div>
                <div className="text-red-100/50 text-xs">{hotline.availability}</div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h4 className="text-red-200 text-sm font-medium mb-2">
            {t('crisis.crisisResources')}
          </h4>
          <div className="space-y-2">
            {culturalContext.crisisResources.organizations.map((org, index) => (
              <div key={index} className="bg-black/20 p-2 rounded text-sm">
                <div className="text-red-200 font-medium">{org.name}</div>
                <div className="text-red-100/70">{org.description}</div>
                <a 
                  href={org.website} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="text-blue-300 hover:text-blue-200 text-xs"
                >
                  {org.website}
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}