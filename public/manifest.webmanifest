{
  "name": "ALCHM — Your Digital Sanctuary",
  "short_name": "ALCHM",
  "description": "A trauma-informed, AI-powered journaling sanctuary designed for healing, reflection, and personal growth.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#a4b792",
  "background_color": "#f7f7f2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["health", "lifestyle", "wellness", "productivity", "utilities"],
  "screenshots": [
    {
      "src": "/screenshots/sanctuary-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ALCHM sanctuary welcome screen"
    },
    {
      "src": "/screenshots/reflection-mobile.png", 
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Writing reflection with Khepera guidance"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96", 
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Reflection",
      "short_name": "Reflect",
      "description": "Start a new reflection with Khepera",
      "url": "/reflect",
      "icons": [
        {
          "src": "/icons/shortcut-reflect.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pathways",
      "short_name": "Pathways",
      "description": "Continue your healing pathways",
      "url": "/pathways",
      "icons": [
        {
          "src": "/icons/shortcut-pathways.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Growth Portfolio",
      "short_name": "Growth",
      "description": "Review your growth and insights",
      "url": "/growth",
      "icons": [
        {
          "src": "/icons/shortcut-growth.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+alchm",
      "url": "/import?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "handle_links": "preferred",
  "id": "alchm-sanctuary",
  "iarc_rating_id": "",
  "related_applications": [],
  "features": [
    "Cross-platform sync",
    "Offline reflection", 
    "Privacy-first encryption",
    "AI-guided insights",
    "Trauma-informed design",
    "Crisis support",
    "Healing pathways",
    "Growth tracking"
  ]
}