  ],
  "shortcuts": [
    {
      "name": "New Journal Entry",
      "short_name": "New Entry",
      "description": "Start writing a new journal entry",
      "url": "/en/journal",
      "icons": [
        {
          "src": "/icons/shortcut-new-entry.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your dashboard and recent entries",
      "url": "/en/dashboard",
      "icons": [
        {
          "src": "/icons/shortcut-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "AI Insights",
      "short_name": "Insights",
      "description": "View your AI insights and patterns",
      "url": "/en/dashboard",
      "icons": [
        {
          "src": "/icons/shortcut-insights.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+alchm",
      "url": "/import?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "handle_links": "preferred",
  "id": "alchm-pwa",
  "iarc_rating_id": "",
  "related_applications": [],
  "features": [
    "Cross-platform sync",
    "Offline functionality", 
    "Push notifications",
    "Background sync",
    "Trauma-informed AI",
    "Crisis prevention",
    "Multi-tier access",
    "Advanced analytics"
  ]
}