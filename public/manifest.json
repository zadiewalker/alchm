{
  "name": "ALCHM - Trauma-Informed AI Journaling",
  "short_name": "ALCHM",
  "description": "A trauma-informed AI journaling platform with crisis prevention and personalized insights",
  "start_url": "/en",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#8B5CF6",
  "background_color": "#0F172A",
  "lang": "en",
